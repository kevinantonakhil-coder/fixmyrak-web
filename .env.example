# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: set this only when the AI server is hosted on a different domain.
# For local development, leave blank so requests go to the local Express server.
VITE_AI_API_BASE_URL=""

# Backend-only: comma-separated website origins allowed to call the AI server.
# Example: https://kevinantonakhil-coder.github.io
AI_ALLOWED_ORIGINS=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_CARTO_API_KEY: Free CARTO basemap API key for watermark-free Voyager tiles.
VITE_CARTO_API_KEY=your_carto_api_key_here
