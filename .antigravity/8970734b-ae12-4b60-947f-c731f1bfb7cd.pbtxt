              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {/* Section 2: Privacy Policy */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {activeSection === \'privacy\' && ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <div className=\"bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 space-y-6 text-xs text-slate-600 leading-relaxed animate-in fade-in\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div className=\"flex items-center gap-2 text-slate-900 font-bold text-base\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <Lock className=\"w-5 h-5 text-emerald-600\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <h2>Privacy Policy</h2>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            At FixMyRAK, we are committed to protecting the privacy of community members who report infrastructure defects in Ras Al Khaimah, UAE."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <h3 className=\"font-bold text-slate-900 text-sm\">1. Information We Collect</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            When you register, we collect your display name and email address via Firebase Authentication. When you submit a report, we store the problem title, description, attached photographs, and geographic location coordinates."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <h3 className=\"font-bold text-slate-900 text-sm\">2. Public vs. Private Data</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Report descriptions, incident photographs, categories, and map coordinates are published openly to facilitate community awareness and municipal visibility. Your private email address is never displayed publicly."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <h3 className=\"font-bold text-slate-900 text-sm\">3. Security & Cloud Firestore</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Data is stored securely on Google Cloud Firestore with Attribute-Based Access Control (ABAC) rules. Access to administrative controls is restricted to authorized credentials."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      )}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {/* Section 3: Terms of Use */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      {activeSection === \'terms\' && ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <div className=\"bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 space-y-6 text-xs text-slate-600 leading-relaxed animate-in fade-in\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div className=\"flex items-center gap-2 text-slate-900 font-bold text-base\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <FileText className=\"w-5 h-5 text-emerald-600\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <h2>Terms of Service & Usage Guidelines</h2>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <h3 className=\"font-bold text-slate-900 text-sm\">1. Accurate & Constructive Submissions</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Users agree to submit truthful, genuine reports concerning physical infrastructure in Ras Al Khaimah. Submissions containing abusive language, harassment, advertisements, or false emergencies will be flagged and removed."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <h3 className=\"font-bold text-slate-900 text-sm\">2. No Emergency Replacement</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            FixMyRAK is not a substitute for UAE police, ambulance, or civil defense emergency response. For life-threatening emergencies or urgent accidents, immediately contact 999."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <h3 className=\"font-bold text-slate-900 text-sm\">3. Content Ownership</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            By uploading photographs to FixMyRAK, you grant the platform a non-exclusive license to display the image publicly for civic coordination and municipal maintenance purposes."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      )}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
        }
        absolute_uri: "file:///src/pages/AboutPage.tsx"
        create_file: true
      }
