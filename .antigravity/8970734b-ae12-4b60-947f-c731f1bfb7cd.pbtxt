    content: "export type ReportCategory =\n  | \'Roads and Potholes\'\n  | \'Streetlights\'\n  | \'Waste Management\'\n  | \'Pavements\'\n  | \'Public Facilities\'\n  | \'Other Infrastructure\';\n\nexport type ReportStatus = \'Submitted\' | \'Under Review\' | \'In Progress\' | \'Resolved\';\n\nexport interface Report {\n  id: string;\n  userId: string;\n  authorName?: string;\n  authorEmail?: string;\n  title: string;\n  description: string;\n  category: ReportCategory;\n  location: string;\n  latitude: number;\n  longitude: number;\n  imageURL?: string;\n  status: ReportStatus;\n  isVerified?: boolean;\n  flagged?: boolean;\n  aiSummary?: string;\n  createdAt: string;\n  updatedAt?: string;\n}\n\nexport interface ReportUpdate {\n  id: string;\n  reportId: string;\n  previousStatus: ReportStatus;\n  newStatus: ReportStatus;\n  message?: string;\n  adminId: string;\n  adminName?: string;\n  createdAt: string;\n}\n\nexport interface UserNotification {\n  id: string;\n  userId: string;\n  reportId?: string;\n  title: string;\n  message: string;\n  read: boolean;\n  createdAt: string;\n}\n\nexport interface UserFeedback {\n  id: string;\n  userId?: string;\n  userName?: string;\n  rating: number;\n  category?: string;\n  message: string;\n  createdAt: string;\n}\n\nexport interface UserProfile {\n  uid: string;\n  displayName?: string;\n  email: string;\n  photoURL?: string;\n  role: \'user\' | \'admin\';\n  createdAt: string;\n}\n\nexport interface AICategorizeResult {\n  category: ReportCategory;\n  suggestedTitle: string;\n  shortSummary: string;\n  urgency: \'low\' | \'medium\' | \'high\' | \'critical\';\n  reasoning: string;\n}\n\nexport interface AIEnhanceResult {\n  enhancedDescription: string;\n  keyPoints: string[];\n}\n\nexport interface AIDuplicateCandidate {\n  reportId: string;\n  similarityScore: number;\n  matchReason: string;\n}\n\nexport interface AISummarizeResult {\n  executiveSummary: string;\n  mainIssue: string;\n  locationContext: string;\n  urgencyLevel: string;\n  suggestedAction: string;\n}\n\nexport const RAK_PRESET_LOCATIONS = [\n  { name: \'Al Nakheel Commercial District\', lat: 25.7925, lng: 55.9732 },\n  { name: \'Corniche Al Qawasim\', lat: 25.7892, lng: 55.9458 },\n  { name: \'Al Hamra Village Marina\', lat: 25.6882, lng: 55.7794 },\n  { name: \'Mina Al Arab Lagoon\', lat: 25.7088, lng: 55.8529 },\n  { name: \'Khuzam Residential Area\', lat: 25.7654, lng: 55.9392 },\n  { name: \'Al Dhait South\', lat: 25.7381, lng: 55.9189 },\n  { name: \'Jebel Jais Mountain Road\', lat: 25.9388, lng: 56.1342 },\n  { name: \'RAK Old Town / Fort Area\', lat: 25.8011, lng: 55.9525 },\n];\n"
