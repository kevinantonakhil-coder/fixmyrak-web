      original_chunk {
        target_content: "export const ReportDetailModal: React.FC<ReportDetailModalProps> = ({\n  report,\n  onClose,\n  onStatusUpdated,\n  onReportDeleted,\n}) => {\n  const { user, isAdmin } = useAuth();\n  const [updates, setUpdates] = useState<ReportUpdate[]>([]);\n  const [loadingUpdates, setLoadingUpdates] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const [isDeleting, setIsDeleting] = useState(false);\n  const [confirmDelete, setConfirmDelete] = useState(false);\n\n  // Admin Quick Status Controls\n  const [showAdminPanel, setShowAdminPanel] = useState(false);\n  const [adminStatus, setAdminStatus] = useState<ReportStatus>(report?.status || \'Submitted\');\n  const [adminMessage, setAdminMessage] = useState(\'\');\n  const [isSubmittingAdminUpdate, setIsSubmittingAdminUpdate] = useState(false);\n\n  // AI Triage\n  const [aiTriage, setAiTriage] = useState<any | null>(null);\n  const [loadingAiTriage, setLoadingAiTriage] = useState(false);\n\n  useEffect(() => {\n    if (!report) return;\n    setAdminStatus(report.status);\n    setLoadingUpdates(true);"
        replacement_content: "export const ReportDetailModal: React.FC<ReportDetailModalProps> = ({\n  report,\n  onClose,\n  onStatusUpdated,\n  onReportDeleted,\n}) => {\n  const { user, isAdmin } = useAuth();\n  const { t, language } = useLanguage();\n  const [updates, setUpdates] = useState<ReportUpdate[]>([]);\n  const [loadingUpdates, setLoadingUpdates] = useState(false);\n  const [copied, setCopied] = useState(false);\n  const [isDeleting, setIsDeleting] = useState(false);\n  const [confirmDelete, setConfirmDelete] = useState(false);\n\n  // Translation State\n  const [translatedText, setTranslatedText] = useState<string | null>(null);\n  const [isTranslating, setIsTranslating] = useState(false);\n  const [showingTranslation, setShowingTranslation] = useState(false);\n\n  // Admin Quick Status Controls\n  const [showAdminPanel, setShowAdminPanel] = useState(false);\n  const [adminStatus, setAdminStatus] = useState<ReportStatus>(report?.status || \'Submitted\');\n  const [adminMessage, setAdminMessage] = useState(\'\');\n  const [isSubmittingAdminUpdate, setIsSubmittingAdminUpdate] = useState(false);\n\n  // AI Triage\n  const [aiTriage, setAiTriage] = useState<any | null>(null);\n  const [loadingAiTriage, setLoadingAiTriage] = useState(false);\n\n  useEffect(() => {\n    if (!report) return;\n    setAdminStatus(report.status);\n    setTranslatedText(null);\n    setShowingTranslation(false);\n    setLoadingUpdates(true);"
        start_line: 30
        end_line: 60
      }
      num_matches: 1
    }
    description: "Add useLanguage hook and translation states in ReportDetailModal"
