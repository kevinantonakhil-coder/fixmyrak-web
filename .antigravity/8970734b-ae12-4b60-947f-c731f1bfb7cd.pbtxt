  view_file {
    absolute_path_uri: "file:///src/services/reportService.ts"
    end_line: 99
    content: "import {\n  collection,\n  doc,\n  getDocs,\n  getDoc,\n  setDoc,\n  updateDoc,\n  deleteDoc,\n  query,\n  where,\n  orderBy,\n  onSnapshot,\n} from \'firebase/firestore\';\nimport { db, handleFirestoreError, OperationType } from \'../firebase\';\nimport {\n  Report,\n  ReportCategory,\n  ReportStatus,\n  ReportUpdate,\n  UserNotification,\n  UserFeedback,\n} from \'../types\';\n\nexport const reportService = {\n  // Real-time listener for public reports\n  subscribeReports(\n    callback: (reports: Report[]) => void,\n    errorCallback?: (error: unknown) => void\n  ) {\n    const path = \'reports\';\n    const q = query(collection(db, path), orderBy(\'createdAt\', \'desc\'));\n\n    return onSnapshot(\n      q,\n      (snapshot) => {\n        const reports: Report[] = [];\n        snapshot.forEach((doc) => {\n          reports.push({ id: doc.id, ...doc.data() } as Report);\n        });\n        callback(reports);\n      },\n      (error) => {\n        console.error(\'Error in subscribeReports:\', error);\n        if (errorCallback) errorCallback(error);\n        handleFirestoreError(error, OperationType.GET, path);\n      }\n    );\n  },\n\n  // Fetch report by ID\n  async getReport(reportId: string): Promise<Report | null> {\n    const path = `reports/${reportId}`;\n    try {\n      const snap = await getDoc(doc(db, \'reports\', reportId));\n      if (!snap.exists()) return null;\n      return { id: snap.id, ...snap.data() } as Report;\n    } catch (error) {\n      handleFirestoreError(error, OperationType.GET, path);\n    }\n  },\n\n  // Create new community report\n  async createReport(params: {\n    userId: string;\n    authorName?: string;\n    authorEmail?: string;\n    title: string;\n    description: string;\n    category: ReportCategory;\n    location: string;\n    latitude: number;\n    longitude: number;\n    imageURL?: string;\n    aiSummary?: string;\n  }): Promise<string> {\n    const path = \'reports\';\n    const reportId = \'rak-\' + Date.now() + \'-\' + Math.random().toString(36).substring(2, 7);\n    const newReport: Report = {\n      id: reportId,\n      userId: params.userId,\n      authorName: params.authorName || \'Community Resident\',\n      authorEmail: params.authorEmail || \'\',\n      title: params.title.trim(),\n      description: params.description.trim(),\n      category: params.category,\n      location: params.location.trim(),\n      latitude: Number(params.latitude.toFixed(6)),\n      longitude: Number(params.longitude.toFixed(6)),\n      imageURL: params.imageURL || \'\',\n      status: \'Submitted\',\n      isVerified: false,\n      flagged: false,\n      aiSummary: params.aiSummary || \'\',\n      createdAt: new Date().toISOString(),\n      updatedAt: new Date().toISOString(),\n    };\n\n    try {\n      await setDoc(doc(db, \'reports\', reportId), newReport);\n"
    num_lines: 466
    num_bytes: 16280
    line_range_bytes: 2718
  }
}
