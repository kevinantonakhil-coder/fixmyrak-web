  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { reportService } from \'../services/reportService\';\nimport { aiService } from \'../services/aiService\';\nimport {\n  Report,\n  ReportCategory,\n  AIDuplicateCandidate,\n  RAK_PRESET_LOCATIONS,\n} from \'../types\';\nimport { MapComponent } from \'../components/MapComponent\';\nimport {\n  MapPin,\n  Upload,\n  Sparkles,\n  CheckCircle,\n  AlertCircle,\n  Image as ImageIcon,\n  X,\n  RefreshCw,\n  Search,\n  Check,\n  ChevronDown,\n  Navigation,\n  Info,\n} from \'lucide-react\';\n\ninterface ReportSubmissionPageProps {\n  existingReports: Report[];\n  onReportCreated: (newReportId: string) => void;\n  openAuthModal: () => void;\n  setCurrentTab: (tab: string) => void;\n}\n\nexport const ReportSubmissionPage: React.FC<ReportSubmissionPageProps> = ({\n  existingReports,\n  onReportCreated,\n  openAuthModal,\n  setCurrentTab,\n}) => {\n  const { user } = useAuth();\n\n  // Form State\n  const [title, setTitle] = useState(\'\');\n  const [category, setCategory] = useState<ReportCategory>(\'Roads and Potholes\');\n  const [description, setDescription] = useState(\'\');\n  const [locationLabel, setLocationLabel] = useState(\'\');\n  const [latitude, setLatitude] = useState(25.7895);\n  const [longitude, setLongitude] = useState(55.9432);\n  const [imagePreview, setImagePreview] = useState<string | null>(null);\n  const [aiSummary, setAiSummary] = useState(\'\');\n\n  // AI Loading & Results States\n  const [isCategorizing, setIsCategorizing] = useState(false);\n  const [isEnhancing, setIsEnhancing] = useState(false);\n  const [isCheckingDuplicates, setIsCheckingDuplicates] = useState(false);\n  const [duplicateCandidates, setDuplicateCandidates] = useState<AIDuplicateCandidate[]>([]);\n  const [duplicateCheckDone, setDuplicateCheckDone] = useState(false);\n  const [aiCategorizeNotice, setAiCategorizeNotice] = useState<string | null>(null);\n  const [aiEnhanceKeyPoints, setAiEnhanceKeyPoints] = useState<string[]>([]);\n\n  // Submission State\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n  const [successReportId, setSuccessReportId] = useState<string | null>(null);\n\n  const categories: ReportCategory[] = [\n    \'Roads and Potholes\',\n    \'Streetlights\',\n    \'Waste Management\',\n    \'Pavements\',\n    \'Public Facilities\',\n    \'Other Infrastructure\',\n  ];\n\n  // Handle Photo selection\n  const handlePhotoUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    if (!file.type.startsWith(\'image/\')) {\n      alert(\'Please select a valid image file (JPEG, PNG, WebP).\');\n      return;\n    }\n\n    if (file.size > 5 * 1024 * 1024) {\n      alert(\'Image file size must be less than 5MB.\');\n      return;\n    }\n\n    const reader = new FileReader();\n    reader.onload = (uploadEvent) => {\n      setImagePreview(uploadEvent.target?.result as string);\n    };\n    reader.readAsDataURL(file);\n  };\n\n  // AI Action 1: Categorize & Suggest Title\n  const handleAiCategorize = async () => {\n    if (!description.trim() || description.trim().length < 5) {\n      alert(\'Please enter at least a brief description of the problem first.\');\n      return;\n    }\n\n    setIsCategorizing(true);\n    setAiCategorizeNotice(null);\n    try {\n      const res = await aiService.categorizeIssue(description);\n      setCategory(res.category);\n      if (!title || title.trim().length < 4) {\n        setTitle(res.suggestedTitle);\n      }\n      setAiSummary(res.shortSummary);\n      setAiCategorizeNotice(\n        `AI Suggestion: Classified as \"${res.category}\". Urgency estimate: ${res.urgency.toUpperCase()}. Reason: ${res.reasoning}`\n      );\n    } catch (err: any) {\n      console.error(\'Categorize error:\', err);\n      alert(\'Could not complete AI categorization. You can select manually.\');\n    } finally {\n      setIsCategorizing(false);\n    }\n  };\n\n  // AI Action 2: Enhance Description\n  const handleAiEnhance = async () => {\n    if (!description.trim() || description.trim().length < 5) {\n      alert(\'Please write an initial description to improve.\');\n      return;\n    }\n\n    setIsEnhancing(true);\n    try {\n      const res = await aiService.enhanceDescription(description, locationLabel);\n      setDescription(res.enhancedDescription);\n      setAiEnhanceKeyPoints(res.keyPoints || []);\n    } catch (err: any) {\n      console.error(\'Enhance error:\', err);\n      alert(\'Failed to enhance description with AI.\');\n    } finally {\n      setIsEnhancing(false);\n    }\n  };\n\n  // AI Action 3: Duplicate Check\n  const handleCheckDuplicates = async () => {\n    if (!description.trim() && !title.trim()) {\n      alert(\'Please enter a title or description before checking duplicates.\');\n      return;\n    }\n\n    setIsCheckingDuplicates(true);\n    setDuplicateCheckDone(true);\n    try {\n      const duplicates = await aiService.checkDuplicates(\n        title || \'Community Defect\',\n        description,\n        category,\n        locationLabel,\n        existingReports\n      );\n      setDuplicateCandidates(duplicates);\n    } catch (err) {\n      console.error(\'Duplicate check error:\', err);\n      setDuplicateCandidates([]);\n    } finally {\n      setIsCheckingDuplicates(false);\n    }\n  };\n\n  // Form Submit Handler\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMessage(null);\n\n    if (!user) {\n      openAuthModal();\n      return;\n    }\n\n    if (!title.trim() || title.trim().length < 3) {\n      setErrorMessage(\'Please provide a title with at least 3 characters.\');\n      return;\n    }\n\n    if (!description.trim() || description.trim().length < 10) {\n      setErrorMessage(\'Please provide a detailed description (at least 10 characters).\');\n      return;\n    }\n\n    if (!locationLabel.trim()) {\n      setErrorMessage(\'Please describe the street or area location.\');\n      return;\n    }\n\n    setIsSubmitting(true);\n    try {\n      const newReportId = await reportService.createReport({\n        userId: user.uid,\n        authorName: user.displayName || user.email?.split(\'@\')[0] || \'Community Member\',\n        authorEmail: user.email || \'\',\n        title: title.trim(),\n        description: description.trim(),\n        category,\n        location: locationLabel.trim(),\n        latitude,\n        longitude,\n        imageURL: imagePreview || \'\',\n        aiSummary: aiSummary || \'\',\n      });\n\n      setSuccessReportId(newReportId);\n      onReportCreated(newReportId);\n    } catch (err: any) {\n      console.error(\'Submission error:\', err);\n      setErrorMessage(\'Failed to submit report. Please check connection and try again.\');\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  // Success view\n  if (successReportId) {\n    return (\n      <div className=\"max-w-2xl mx-auto px-4 py-16 text-center space-y-6 animate-in fade-in\">\n        <div className=\"w-20 h-20 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-md\">\n          <CheckCircle className=\"w-10 h-10\" />\n        </div>\n        <h2 className=\"text-3xl font-black text-slate-900 tracking-tight\">\n          Report Registered Successfully!\n        </h2>\n        <p className=\"text-sm text-slate-600 max-w-md mx-auto leading-relaxed\">\n          Thank you for helping make Ras Al Khaimah cleaner and safer. Your report has been saved to Cloud Firestore with ID:\n          <span className=\"font-mono font-bold block mt-1 text-slate-800\">{successReportId}</span>\n        </p>\n\n        <div className=\"p-4 bg-emerald-50 rounded-2xl border border-emerald-200 text-xs text-emerald-800 max-w-md mx-auto text-left\">\n          <p className=\"font-bold flex items-center gap-1.5 mb-1\">\n            <Check className=\"w-4 h-4 text-emerald-600\" />\n            Next Steps:\n          </p>\n          <ul className=\"list-disc list-inside space-y-1 text-emerald-700\">\n            <li>Your submission is now visible on the public map with status \"Submitted\".</li>\n            <li>Municipal coordinators review active reports daily.</li>\n            <li>You will receive in-app notifications whenever status changes.</li>\n          </ul>\n        </div>\n\n        <div className=\"pt-4 flex flex-col sm:flex-row items-center justify-center gap-3\">\n          <button\n            onClick={() => setCurrentTab(\'dashboard\')}\n            className=\"w-full sm:w-auto px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all\"\n          >\n            Go to My Reports\n          </button>\n          <button\n            onClick={() => {\n              setSuccessReportId(null);\n              setTitle(\'\');\n              setDescription(\'\');\n              setLocationLabel(\'\');\n              setImagePreview(null);\n              setAiSummary(\'\');\n              setDuplicateCandidates([]);\n              setDuplicateCheckDone(false);\n            }}\n            className=\"w-full sm:w-auto px-6 py-3 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-all\"\n          >\n            Submit Another Report\n          </button>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n      {/* Header */}\n      <div className=\"text-center max-w-xl mx-auto space-y-2\">\n        <span className=\"text-xs font-bold text-emerald-700 uppercase tracking-widest bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200\">\n          Civic Infrastructure Reporting\n        </span>\n        <h1 className=\"text-3xl font-black text-slate-900 tracking-tight\">\n          Report an Issue in Ras Al Khaimah\n        </h1>\n        <p className=\"text-xs sm:text-sm text-slate-600\">\n          Fill out the details below. Use the Gemini AI assistant to categorize your report, enhance clarity, and verify against existing submissions.\n        </p>\n      </div>\n\n      {!user && (\n        <div className=\"p-4 bg-amber-50 border border-amber-200 rounded-2xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-amber-900\">\n          <div className=\"flex items-center gap-2\">\n            <Info className=\"w-5 h-5 text-amber-600 shrink-0\" />\n            <span>\n              You are currently viewing as a guest. You can fill out the form now, and you will be prompted to sign in with Google or Email upon submitting.\n            </span>\n          </div>\n          <button\n            type=\"button\"\n            onClick={openAuthModal}\n            className=\"px-4 py-2 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-xl shrink-0 cursor-pointer\"\n          >\n            Sign In First\n          </button>\n        </div>\n      )}\n\n      {errorMessage && (\n        <div className=\"p-4 bg-red-50 border border-red-200 text-red-700 rounded-2xl text-xs flex items-center gap-2\">\n          <AlertCircle className=\"w-5 h-5 shrink-0\" />\n          <span>{errorMessage}</span>\n        </div>\n      )}\n\n      {/* Main Form */}\n      <form onSubmit={handleSubmit} className=\"space-y-8 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-md\">\n        {/* Section 1: Problem Description & Gemini AI Assistant */}\n        <div className=\"space-y-4\">\n          <div className=\"flex items-center justify-between\">\n            <label className=\"block text-sm font-black text-slate-900\">\n              1. What is the issue? <span className=\"text-red-500\">*</span>\n            </label>\n            <span className=\"text-[11px] font-semibold text-slate-400\">\n              {description.length} characters\n            </span>\n          </div>\n\n          <textarea\n            required\n            rows={4}\n            value={description}\n            onChange={(e) => setDescription(e.target.value)}\n            placeholder=\"e.g. There is a deep pothole on the right lane near the roundabout leading towards Corniche Al Qawasim. Vehicles are swerving to avoid tire damage...\"\n            className=\"w-full p-3.5 text-xs sm:text-sm border border-slate-200 rounded-2xl focus:ring-2 focus:ring-emerald-500 focus:outline-hidden bg-slate-50/50 leading-relaxed\"\n          />\n\n          {/* AI Action Buttons Toolbar */}\n          <div className=\"flex flex-wrap items-center gap-2 pt-1\">\n            <button\n              type=\"button\"\n              onClick={handleAiCategorize}\n              disabled={isCategorizing}\n              className=\"px-3.5 py-1.5 rounded-xl bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-bold border border-teal-200/80 flex items-center gap-1.5 transition-colors cursor-pointer disabled:opacity-50\"\n            >\n              {isCategorizing ? (\n                <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n              ) : (\n                <Sparkles className=\"w-3.5 h-3.5 text-teal-600\" />\n              )}\n              <span>AI Categorize & Suggest Title</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={handleAiEnhance}\n              disabled={isEnhancing}\n              className=\"px-3.5 py-1.5 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-800 text-xs font-bold border border-sky-200/80 flex items-center gap-1.5 transition-colors cursor-pointer disabled:opacity-50\"\n            >\n              {isEnhancing ? (\n                <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n              ) : (\n                <Sparkles className=\"w-3.5 h-3.5 text-sky-600\" />\n              )}\n              <span>AI Polish Clarity</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={handleCheckDuplicates}\n              disabled={isCheckingDuplicates}\n              className=\"px-3.5 py-1.5 rounded-xl bg-purple-50 hover:bg-purple-100 text-purple-800 text-xs font-bold border border-purple-200/80 flex items-center gap-1.5 transition-colors cursor-pointer disabled:opacity-50\"\n            >\n              {isCheckingDuplicates ? (\n                <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n              ) : (\n                <Search className=\"w-3.5 h-3.5 text-purple-600\" />\n              )}\n              <span>Check for Duplicates</span>\n            </button>\n          </div>\n\n          {/* AI Feedback Notices */}\n          {aiCategorizeNotice && (\n            <div className=\"p-3 bg-teal-50/70 border border-teal-200 rounded-xl text-xs text-teal-900 animate-in fade-in\">\n              {aiCategorizeNotice}\n            </div>\n          )}\n\n          {aiEnhanceKeyPoints.length > 0 && (\n            <div className=\"p-3 bg-sky-50/70 border border-sky-200 rounded-xl text-xs text-sky-900 animate-in fade-in\">\n              <p className=\"font-bold mb-1\">Key Extracted Points:</p>\n              <ul className=\"list-disc list-inside space-y-0.5 text-sky-800\">\n                {aiEnhanceKeyPoints.map((pt, idx) => (\n                  <li key={idx}>{pt}</li>\n                ))}\n              </ul>\n            </div>\n          )}\n\n          {/* Duplicate check results card */}\n          {duplicateCheckDone && (\n            <div className=\"p-4 bg-purple-50/60 border border-purple-200 rounded-2xl text-xs space-y-2 animate-in fade-in\">\n              <p className=\"font-bold text-purple-950 flex items-center gap-1.5\">\n                <Search className=\"w-4 h-4 text-purple-600\" />\n                Duplicate Detection Analysis:\n              </p>\n              {duplicateCandidates.length === 0 ? (\n                <p className=\"text-purple-800\">\n                  No matching reports found nearby. Your issue appears to be unique!\n                </p>\n              ) : (\n                <div className=\"space-y-2 pt-1\">\n                  <p className=\"text-purple-800\">\n                    We found {duplicateCandidates.length} potential existing report(s) describing similar concerns. Please verify if one of these matches your problem:\n                  </p>\n                  <div className=\"divide-y divide-purple-200/60 bg-white/80 rounded-xl border border-purple-200/60 p-2\">\n                    {duplicateCandidates.map((dup) => {\n                      const matchingReport = existingReports.find((r) => r.id === dup.reportId);\n                      return (\n                        <div key={dup.reportId} className=\"py-2 px-1\">\n                          <div className=\"flex items-center justify-between font-bold text-purple-900\">\n                            <span>{matchingReport?.title || \'Report #\' + dup.reportId}</span>\n                            <span className=\"text-[10px] bg-purple-100 text-purple-800 px-2 py-0.5 rounded-full\">\n                              Match: {Math.round(dup.similarityScore * 100)}%\n                            </span>\n                          </div>\n                          <p className=\"text-[11px] text-purple-700 mt-0.5\">{dup.matchReason}</p>\n                        </div>\n                      );\n                    })}\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* Section 2: Title and Category */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-5 pt-4 border-t border-slate-100\">\n          <div>\n            <label className=\"block text-sm font-black text-slate-900 mb-1.5\">\n              2. Report Title <span className=\"text-red-500\">*</span>\n            </label>\n            <input\n              type=\"text\"\n              required\n              minLength={3}\n              maxLength={150}\n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              placeholder=\"e.g. Hazardous Pothole on Corniche Road\"\n              className=\"w-full p-2.5 text-xs sm:text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-hidden bg-slate-50/50\"\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-sm font-black text-slate-900 mb-1.5\">\n              3. Category <span className=\"text-red-500\">*</span>\n            </label>\n            <select\n              value={category}\n              onChange={(e) => setCategory(e.target.value as ReportCategory)}\n              className=\"w-full p-2.5 text-xs sm:text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-hidden bg-slate-50/50 font-medium\"\n            >\n              {categories.map((cat) => (\n                <option key={cat} value={cat}>\n                  {cat}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Section 3: Location Details & Interactive Map Picker */}\n        <div className=\"space-y-4 pt-4 border-t border-slate-100\">\n          <div>\n            <label className=\"block text-sm font-black text-slate-900 mb-1\">\n              4. Location in Ras Al Khaimah <span className=\"text-red-500\">*</span>\n            </label>\n            <p className=\"text-xs text-slate-500 mb-2\">\n              Enter the street/neighborhood name and drop the pin precisely on the map below.\n            </p>\n            <div className=\"relative\">\n              <MapPin className=\"w-4 h-4 text-emerald-600 absolute left-3 top-3\" />\n              <input\n                type=\"text\"\n                required\n                value={locationLabel}\n                onChange={(e) => setLocationLabel(e.target.value)}\n                placeholder=\"e.g. Corniche Al Qawasim, near Al Fanar Restaurant\"\n                className=\"w-full pl-9 pr-3 py-2.5 text-xs sm:text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-hidden bg-slate-50/50\"\n              />\n            </div>\n          </div>\n\n          {/* Interactive Location Picker Map */}\n          <div>\n            <div className=\"flex items-center justify-between text-xs text-slate-500 mb-1.5\">\n              <span className=\"font-semibold text-slate-700\">\n                Pinpoint on Map (Click map or drag the blue pin):\n              </span>\n              <span className=\"font-mono text-[11px] text-slate-600\">\n                Lat: {latitude.toFixed(5)}, Lng: {longitude.toFixed(5)}\n              </span>\n            </div>\n\n            <MapComponent\n              isPickerMode={true}\n              pickerLat={latitude}\n              pickerLng={longitude}\n              onPickerLocationChange={(lat, lng, label) => {\n                setLatitude(lat);\n                setLongitude(lng);\n                if (label && (!locationLabel || locationLabel.trim().length < 4)) {\n                  setLocationLabel(label);\n                }\n              }}\n              height=\"340px\"\n              zoomLevel={12}\n            />\n          </div>\n        </div>\n\n        {/* Section 4: Photograph Upload */}\n        <div className=\"space-y-3 pt-4 border-t border-slate-100\">\n          <label className=\"block text-sm font-black text-slate-900\">\n            5. Attach Photograph (Optional but Recommended)\n          </label>\n          <p className=\"text-xs text-slate-500\">\n            Photos help municipal coordinators verify the defect and dispatch appropriate equipment.\n          </p>\n\n          {imagePreview ? (\n            <div className=\"relative rounded-2xl overflow-hidden border border-slate-200 max-h-64 bg-slate-100 flex items-center justify-center\">\n              <img\n                src={imagePreview}\n                alt=\"Upload preview\"\n                className=\"max-h-64 w-full object-contain\"\n              />\n              <button\n                type=\"button\"\n                onClick={() => setImagePreview(null)}\n                className=\"absolute top-3 right-3 p-1.5 bg-slate-900/80 hover:bg-slate-900 text-white rounded-full transition-colors\"\n                title=\"Remove image\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n          ) : (\n            <label className=\"border-2 border-dashed border-slate-200 hover:border-emerald-500 rounded-2xl p-6 flex flex-col items-center justify-center text-center cursor-pointer transition-colors bg-slate-50/50 hover:bg-emerald-50/20\">\n              <Upload className=\"w-8 h-8 text-slate-400 mb-2\" />\n              <p className=\"text-xs font-bold text-slate-700\">\n                Click to upload or drag photo here\n              </p>\n              <p className=\"text-[11px] text-slate-400 mt-0.5\">\n                PNG, JPG or WebP up to 5MB\n              </p>\n              <input\n                type=\"file\"\n                accept=\"image/*\"\n                onChange={handlePhotoUpload}\n                className=\"hidden\"\n              />\n            </label>\n          )}\n        </div>\n\n        {/* Submit Button */}\n        <div className=\"pt-4 border-t border-slate-100\">\n          <button\n            type=\"submit\"\n            disabled={isSubmitting}\n            className=\"w-full py-4 px-6 rounded-2xl bg-emerald-600 hover:bg-emerald-700 active:scale-98 text-white font-black text-sm shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50\"\n          >\n            {isSubmitting ? (\n              <>\n                <RefreshCw className=\"w-5 h-5 animate-spin\" />\n                <span>Saving Report to Cloud Firestore...</span>\n              </>\n            ) : (\n              <>\n                <Check className=\"w-5 h-5\" />\n                <span>Submit Report to FixMyRAK</span>\n              </>\n            )}\n          </button>\n          <p className=\"text-[11px] text-slate-400 text-center mt-2.5\">\n            By submitting, you confirm the accuracy of the report. Reports are public for community awareness.\n          </p>\n        </div>\n      </form>\n    </div>\n  );\n};\n"
