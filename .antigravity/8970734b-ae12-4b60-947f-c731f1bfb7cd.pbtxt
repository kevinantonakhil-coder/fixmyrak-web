unded-lg text-xs font-semibold transition-all shrink-0 cursor-pointer ${\\n                selectedCategory === cat\\n                  ? \'bg-[#143d35] text-white shadow-xs\'\\n                  : \'bg-[#f6f7f3] hover:bg-[#e8f1e9] text-[#1c302c] border border-[#e4e9e1]\'\\n              }`}\\n            >\\n              {cat === \'all\' ? \'All\' : cat}\\n            </button>\\n          ))}\\n        </div>\\n\\n        {/* Status Filter */}\\n        <div className=\\\"flex items-center gap-2 overflow-x-auto pb-1 scrollbar-thin\\\">\\n          <span className=\\\"text-[11px] font-bold text-[#819087] uppercase tracking-wider shrink-0\\\">\\n            Status:\\n          </span>\\n          {statuses.map((st) => (\\n            <button\\n              key={st}\\n              onClick={() => setSelectedStatus(st)}\\n              className={`whitespace-nowrap px-3 py-1 rounded-lg text-xs font-semibold transition-all shrink-0 cursor-pointer ${\\n                selectedStatus === st\\n                  ? \'bg-[#143d35] text-white shadow-xs\'\\n                  : \'bg-[#f6f7f3] hover:bg-[#e8f1e9] text-[#1c302c] border border-[#e4e9e1]\'\\n              }`}\\n            >\\n              {st === \'all\' ? \'All\' : st}\\n            </button>\\n          ))}\\n        </div>\\n      </div>\", \"StartLine\":55, \"TargetContent\":\"  return (\\n    <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6\\\">\\n      {/* Title Bar */}\\n      <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n        <div>\\n          <span className=\\\"text-xs font-bold text-sky-700 uppercase tracking-widest bg-sky-50 px-3 py-1 rounded-full border border-sky-200\\\">\\n            Geographic Explorer\\n          </span>\\n          <h1 className=\\\"text-3xl font-black text-slate-900 tracking-tight mt-1.5\\\">\\n            Interactive Ras Al Khaimah Map\\n          </h1>\\n          <p className=\\\"text-slate-600 text-xs 