      </button>\n          </div>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-5\">\n          {/* Title & Metadata */}\n          <div>\n            <h2 className=\"text-xl sm:text-2xl font-black text-slate-900 leading-snug\">\n              {report.title}\n            </h2>\n            <div className=\"mt-2 flex flex-wrap items-center gap-y-1 gap-x-4 text-xs text-slate-500\">\n              <span className=\"flex items-center gap-1 text-emerald-700 font-medium\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                {report.location}\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Calendar className=\"w-3.5 h-3.5\" />\n                {new Date(report.createdAt).toLocaleDateString(\'en-AE\', {\n                  day: \'numeric\',\n                  month: \'short\',\n                  year: \'numeric\',\n                })}\n              </span>\n              {report.authorName && (\n                <span className=\"flex items-center gap-1\">\n                  <User className=\"w-3.5 h-3.5\" />\n                  {report.authorName}\n                </span>\n              )}\n            </div>\n          </div>\n\n          {/* Photograph if available */}\n          {report.imageURL && (\n            <div className=\"rounded-2xl overflow-hidden border border-slate-200 bg-slate-100 max-h-72 flex items-center justify-center\">\n              <img"
