      thinking_signature: "\022\367\032\n\364\032\001i\024}\023\277\037\332\004  \204\030\200j\264\005\2513g\332\244\262T\341\224\257\024B\377Z\337,&l\224\261#b?\345\r\274\200\005\003\024\365\302\270\314Z\302\267K^\016\336C\234\0224\312\227\227)^;\334\t\005\003\331\370N\365\364\346e`\v\271\244.\3744\246AL\202\323\347%*\325o-\242E\233\312]\fZp\300\001\372\3263\312\017\323\211c\351%\033\334\023\327\255+\006\021\344\360\352\267\373\350\317B\271u-\2227\261\346\026\264\027CC\347\026D8\370\036\252?\224*\246\3556\240\311\253!q\023\365\361\351\\I\226*/AYP\233K\216\bM\b\032qlP\247\242\372\225\256\213\003\235w\243\2729/\313\211Q\021\312\016x\276\\\361\026\371Z\217\027\372De\306\210\203\037\177\237\363\321m/up\305~\364\200{=\016\360\bQ3\204\224\\\314i\361\257\242-+\265\262\275-\341`\020\272\006\236\035\325m5\360\326&j\222\342?\321E?\210\373\357\330h\331\224$\377F\331\314jl5\314wD*\252\330\216I@\362\311\270\222Gb\364\371\236OK\354$\r\v\223\211\310H\341\352\267\217I\032\235|\220\307q4SC\002\347\212\300\023f3&k\330\247W\345\253>A\024\021\214\202<\221+\177,\3179\341\317\202\3250\332\276\002\224\333\321\002\313\333F0QB8\215L\322AV\177+\367$ \274\\\321W\n\230\001\207--\327)\357\307\255\372a\031\246\342\354\240=\225\271z\247\333\222QW\n\232\006\314\316\027\365Ls\327\205B~O\f\350eM\357\267.\017\343\r\214\363\345rv\207\347\"\205\3050!\236\303\370\223\227\357S5\020\v4\273\266+\272G\023[\242\230\316\3660\252\3118\345\321\302\220J8\362)3\245N\260}\032(\234\365\003.\3024Q>\006\342\223\310\250\016\252\003\005\370\aKM; \316\nI\227\026=\373\220\272\274M\002A\251\276\305\353I\034K,\037\314\323\241q:D\023\026\v\247\262Q\265\231\220\301_<\006\t\323;n9\3360\336\215\213=\302\241\225\t\000.\r\264\330\245,\364\324fc\276h\370\272\216!\356(\223\301\346x\237|\312\020\223\374rv\337O\261B\234\204\036\316\267\271\265\352\260\006\221\032\247p\b@E\377\312k#&d\303\2076w\332\302`\017j\\\216\232\214\0302\324\3230\351P7\213\261$ \026\300\345\tK\263GJ\346\332\215rJS\021Y\304\0008\341\213j\031l\225\367\314\3137\2