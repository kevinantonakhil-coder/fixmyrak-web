    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQFqq2WxGw-Zhv6a7ZBh2WMzN27TagCX-hagm3bwRZupBfjmwyRqILg6aEdbB4KlU58Y_5P9pr1loF7VF9QXy18tTLmR6Mv-tqtxw-RFg-hSxMFuC_CSf-xHIBkdGNQY_w=="
      title: "github.com"
