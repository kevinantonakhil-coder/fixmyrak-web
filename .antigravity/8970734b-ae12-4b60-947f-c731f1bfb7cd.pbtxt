      thinking_signature: "\022\351\v\n\346\v\001i\024}\023\242\245\r%\203\340A\224\342\344G\330Z\224\3403\325\356t\214(\256Z\'\321\355Z\034\264J+e\372\271y\022\374\t,\265/\252\'-w\320\225\201z\241b\2579`\020\020H^\324\365\271\303#\031\343`w\271\263\320\215\rb\252\201D:,Q\310\355\274%4o~\250\245\342\331G\221\212k2\356\261\273\343R\205\367\001\262\375k\2347\257G|\023\324Wi\317\347\206\000\fQ\364\316\320C\240\312\303\006\212\022\334\247\365K\236\315ca<E\356\204F\254#\271\n\023_\330\364w\017\205\237\213\310\017\271\212\220\002tN}\207rk\341M\303\304z\230\250}\314\3551\261\203\335?\257[G\204\f\246nl\265\b\036\273\376)\001\235\037V\343\345`\230\033\375v\036\361z\346\274\222\326y\212\271\344\356\316N\274\374l\207\024\217\343\371@\022\'$\323q\221\277\346\2719H\365\211Ls\024\026\215_F\b\236i\257iQ\226\200\036\0247\221Q\242Sy\212C\242\253oii>Q\302\031\325\0175\307\"*\250\241\002\024\005v\307\217[\2448\250\320\312\226\\\022\300\325\rX\030\232q~\324\244\021,0Kh&\0355\tSM\225&M\205\343\274\346\tc\320J\255\026^\202O\364\300\243\342\265F\316\252\274\354\032[D-\205\373\326\261\305\361OG\256)\306w X\360\225b\3534\376`\330\006\300Th\005`\275\000.f\243\0331\021_\342\224\036P\227\346\265\307W\2752\b\245<\233(PgH\004\025!\210hc\317< h\030\337(\022C\\\005\0277\304V3\375\002\2227\030\370*\v\375\255\304\205_\324b\004[T\377V\325\205\356\313U\252\346>\362\313\004\342Q\020g\370~\370\351v\245\256\177\374$\241\214\223\211\274\033\030\216R\306\213\370\026\216\353\"1\266\325\322\20299\317]\273#\305\024\261n\304L\263H\257r\251M.\027?\302\260\016\337\377T=y\373\3514\356\274\000\3101y\2344\222Z\200\303\243\272W\217U\333%\231\226\273\213\330B\255\036`\346\t\026\334pq\253\0220\363\303\272\275\326yRjsW\2061\241\a[\356\247#6\363\221\231,\267D\021Ov\345\b\016,\\\372R\263\017c\031\360*i\225\222Q\247\254\322*{\350^\266r\t`\242k\272\353\353\220\177\330>TQO\003\302\215\377\226zh\021\242wdWz\240]%\251.\200C\204\230\030\321\000\2627\376(\004D\177\364\225|\254\234\026\245\311ntN\257\271\340\230\277Yc\031\327m!\034\230Z\215\232!4Sw\374g\367\3719\307\205\'\245\016\243\001<H\021\357\240\203+R\232\a\211{oW9\215|\216\257m.Z\b\205\360\314S\306\226\315 V\316\323\264&m\037\202%|`2D6\024s\214/\301v\240)\360\266\303Pp\026\030\221\312\241\004\366\3553\213~%Z\v\312\201\337\345\244\242,\300[\274T\006\035\365)]\3765\357o\317\2311|Nbo\200\035\2356|\306\210\240D\335\005\243\240\367\236\003:E\352\2619\221\322\vu@\241hf\352!\252Y+z\237\304\026mrJ\317\231\212\207\221O,\232\265\310\267\260w\315\335\334\220\337\376\277\260\277\270\005lO\202\241\252\356\365F\317%\2105P{<\225t\036\243\272{+\271(\343\343\350\245\376\224\241\341\'\347\263 \251\017\350F\370\377\245\2320\326P_\276\377\262\354\345\353Oe\353w\n^\n\201\306;\350\264\254\367\022\006\353eV\004\231\361\263o\361;m\t\350\205\344\257\365\270\2048\213d\327\301\024R\301\346\177\354\331\321\311m\265!\022\345___\371T\271\207\253\0242Ux\363\034*y\235\237\241\205|\v\227D\v\3658\353\221\354\314\216v\233?\271e\213}\226\376\362\201P\316\215\233|\272\243\223\273T\232\320\3216\0231\177\336\331&\242\"\"\214\217\204T\bnun\373\225\376\001\377\344\264P\330`\"\337ea\326y\253\265\037\030\025\343\250\332\2507\365\212\266qo\332\031\313\365\200VG\245X\a\314\v\375\247G\bo\\$/\004\305\347\322%vKC53\003\342l~\356\310\311m\027\221\222\206\212\232\020#\355E\307\177\272\373\037\336*\326z\363\301J\a\310\026\v\347\217\0306\3124\313\027\306\343\f\263FXj\001W\350cb\366\343\221\2153\233F\\\235\037KK}H\377;\271opE\3734:s\276z\353sp]\\\037\371\225\252\332\325V0\254Y\002\357\327\341\324\034\213,\212\021\347e.\222\347f\373\217\346Z\357 g0=\035\343=K\243\206~\b8\222m\330^f\3573\003\240\2122U\371\203\003M\322T{\234*\004>!\211\315;\262\240\251B\251\237W\237d\302a\005\225\177\353Gk\021\304\344n\210D\306\250\226O\331\213\271\262\263\371h2\254\335\331\230\371\270\261!\371\025\265\263i^\202\3736\225\267\t\261 O\313\321\006y\027Nk\362\302;\235\210\b\227\244\023\233\354K\352\364\004\306\366 \a\222K=^h2\3458\226\343\023\353\311Jmx\t\224\3563\r\303\237\337\314\331O>\177\241\004\303\023q\250\017\253\375\'\344V\270i\230\200q\3333:\003)\207\206\313\355\326y\n\342\240\347\247\t\\<\033\233\366\263\376\316R\024kU\226\217Z\036\235X\353\360C\232\373\300Kr\206hu\205|\204\031\023\246\236\303\203\177\301\214\350\316\353%O\337\364\305\304\2224o\nR\274QZB\2037a\213\374\036\313\213\346\rc\004\312\353\202Z\266\241\341\364\036\273\250\320\f\372]"
