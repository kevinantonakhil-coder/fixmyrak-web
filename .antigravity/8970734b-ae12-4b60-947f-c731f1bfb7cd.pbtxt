) => setActiveTab(\'analytics\')}\n          className={`pb-3 text-xs font-bold border-b-2 transition-all cursor-pointer ${\n            activeTab === \'analytics\'\n              ? \'border-[#143d35] text-[#143d35]\'\n              : \'border-transparent text-[#74817b] hover:text-[#143d35]\'\n          }`}\n        >\n          Analytics & Trends\n        </button>\n        <button\n          onClick={() => setActiveTab(\'feedback\')}\n          className={`pb-3 text-xs font-bold border-b-2 transition-all cursor-pointer ${\n            activeTab === \'feedback\'\n              ? \'border-[#143d35] text-[#143d35]\'\n              : \'border-transparent text-[#74817b] hover:text-[#143d35]\'\n          }`}\n        >\n          Community Feedback\n        </button>\n      </div>"
