      full: "<truncated 23 bytes>\n; color: #d7e4d3; font-size: 122px; line-height: 1; pointer-events: none; }.track-copy, .track-form { z-index: 1; }.closing { position: relative; display: flex; align-items: end; justify-content: space-between; min-height: 240px; padding: 8px 4px 43px; border-top: 1px solid var(--line); }.closing h2 { margin-top: 9px; font-size: clamp(31px, 4vw, 44px); }.closing .button { margin-bottom: 7px; z-index: 1; }.closing-flower { position: absolute; right: 5%; top: -30px; color: #edf0e9; font-size: 159px; line-height: 1; pointer-events: none; }.site-footer { min-height: 69px; display: flex; align-items: center; justify-content: space-between; gap: 15px; border-top: 1px solid var(--line); }.footer-brand img { width: 33px; height: 33px; }.footer-brand .brand-name { font-size: 13px; }.footer-brand .brand-name small { font-size: 8px; }.site-footer > p { margin: 0; color: #89958d; font-size: 9px; }.site-footer > span { color: #89958d; font-size: 8px; letter-spacing: .06em; }.site-footer > span > span { letter-spacing: 0; }.report-dialog { width: min(490px, calc(100% - 28px)); max-height: min(90vh, 830px); overflow: auto; padding: 25px; border: 1px solid #e2e8e0; border-radius: 20px; color: var(--ink); background: var(--page); box-shadow: 0 25px 90px #15261d3b; }.report-dialog::backdrop { background: #14251dc4; backdrop-filter: blur(3px); }.dialog-header { display: flex; justify-content: space-between; align-items: center; gap: 12px; }.dialog-header h2 { margin: 4px 0 0; font-size: 23px; letter-spacing: -.055em; }.icon-close { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--line); border-radius: 10px; background: white; color: var(--muted); font-size: 23px; }.dialog-intro { margin: 7px 0 19px; color: var(--muted); font-size: 11px; }.form-label { display: block; margin: 0 0 13px; color: #55655b; font-size: 10px; font-weight: 700; }.form-label input, .form-label textarea, .form-label select { display: block; width: 100%; margin-top: 6px; padding: 10px 11px; border: 1px solid #e0e7df; border-radius: 9px; outline: none; background: white; color: var(--ink); font-size: 11px; font-weight: 400; }.form-label textarea { resize: vertical; min-height: 79px; }--  .track-card { grid-template-columns: 1fr .95fr; gap: 18px; padding: 27px; }}@media (max-width: 640px) {  html { scroll-padding-top: 72px; }  .content-wrap { width: calc(100% - 36px); }  .site-header { height: 66px; padding-inline: 18px; gap: 8px; }  .account-section { padding-bottom: 25px; }  .account-card { grid-template-columns: 1fr; gap: 17px; padding: 19px 15px; }  .account-copy h2 { font-size: 23px; }  .account-panel { padding: 14px; }  .brand { gap: 7px; }.brand img { width: 36px; height: 36px; }.brand-name { font-size: 15px; }--  .section-heading h2, .track-card h2 { font-size: 27px; }.section-heading > p { width: 100%; max-width: 410px; font-size: 10px; }  .stats-row { gap: 8px; }.stat-card { min-height: 73px; gap: 8px; padding: 10px; border-radius: 12px; }.stat-symbol { width: 30px; height: 30px; border-radius: 10px; font-size: 15px; }.stat-card strong { font-size: 16px; }.stat-card small { font-size: 7px; }  .map-section { padding-top: 36px; padding-bottom: 49px; }.map-heading { gap: 13px; }.map-heading h2, .reports-heading h2 { font-size: 25px; }  .map-controls { width: 100%; }.map-controls .filter-select { flex: 1; min-width: 0; }.map-controls .button { flex: 0 0 auto; }  .map-layout { grid-template-columns: minmax(0, 1fr); gap: 10px; }.map-frame { height: 340px; }.map-sidebar { min-height: unset; height: auto; }.map-report-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 12px; }.sidebar-report-cta { min-height: 39px; }.privacy-note { margin-top: 8px; }  .map-legend { gap: 7px 9px; padding: 7px 8px; }.map-legend span { font-size: 7px; }.map-top-label { font-size: 7px; }  .reports-section { padding-top: 38px; padding-bottom: 35px; }.reports-heading { gap: 12px; }.report-filters { width: 100%; }.search-field { flex: 1; width: auto; }.report-filters .filter-select { max-width: 135px; }.reports-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }  .report-card { padding: 11px; border-radius: 12px; }.report-card h3 { font-size: 11px; margin-top: 9px; }.report-card > p { font-size: 8px; }.report-card-top { align-items: flex-start; }.category-pill { font-size: 7px; }.status-pill { padding: 3px 6px; font-size: 6px; }.report-card-bottom { margin-top: 9px; font-size: 7px; }.sample-label { font-size: 6px; }.user-photo { margin: -11px -11px 4px; width: calc(100% + 22px); height: 91px; }.unverified-note { align-items: flex-start; font-size: 8px; line-height: 1.6; }  .track-section { padding-top: 5px; padding-bottom: 42px; }.track-card { grid-template-columns: 1fr; gap: 18px; min-height: 0; padding: 22px 18px; border-radius: 16px; }.track-card h2 { font-size: 23px; }.track-copy p { font-size: 9px; }.track-form { padding-right: 0; padding-bottom: 47px; }.track-form input { width: 100%; }.track-form .button { top: auto; bottom: 0; left: 0; right: auto; height: 39px; }  .closing { align-items: flex-start; flex-direction: column; justify-content: center; gap: 17px; min-height: 235px; padding-block: 35px; }.closing h2 { font-size: 35px; }.closing .button { margin: 0; }.closing-flower { top: 15px; right: -10px; font-size: 108px; }  .site-footer { flex-wrap: wrap; justify-content: space-between; gap: 8px; padding-block: 12px; }.site-footer > p { order: 3; width: 100%; font-size: 8px; }.site-footer > span { font-size: 7px; }.footer-brand img { width: 29px; height: 29px; }  .report-dialog { padding: 19px; }.dialog-header h2 { font-size: 20px; }.location-field { grid-template-columns: 1fr; gap: 0; }.location-button { justify-self: start; margin-top: -6px; }.form-label { font-size: 9px; }.dialog-actions .button { flex: 1; }}@media (max-width: 370px) {  .content-wrap { width: calc(100% - 28px); }.site-header { padding-inline: 12px; }  .header-cta { padding-inline: 8px; font-size: 9px; }.brand-name { font-size: 14px; }  .hero-copy > .eyebrow { font-size: 7px; }.hero-actions { gap: 12px; }  .stats-row { grid-template-columns: 1fr; }.stat-card { min-height: 61px; }.map-frame { height: 300px; }  .map-report-list { grid-template-columns: 1fr; }.reports-grid { grid-template-columns: 1fr; }.report-card { padding: 14px; }.user-photo { margin: -14px -14px 5px; width: calc(100% + 28px); height: 125px; }}.map-picker-dialog { width: min(1120px, calc(100vw - 42px)); height: min(820px, calc(100dvh - 42px)); max-width: none; max-height: none; padding: 0; overflow: hidden; border: 1px solid #dfe7df; border-radius: 20px; color: var(--ink); background: #f9faf7; box-shadow: 0 25px 100px #12281f55; }.map-picker-dialog[open] { display: flex; flex-direction: column; }.map-picker-dialog::backdrop { background: #14251dc9; backdrop-filter: blur(4px); }.picker-header { display: grid; grid-template-columns: 1fr 2fr 1fr; align-items: center; gap: 16px; padding: 17px 22px 14px; border-bottom: 1px solid #e7ece5; background: #fbfcfa; }.picker-brand { justify-self: start; }.picker-brand img { width: 34px;height:34px }.picker-brand .brand-name { font-size: 13px; }.picker-brand .brand-name small { font-size: 8px; }.picker-heading { text-align: center; }.picker-heading h2 { margin: 3px 0 0; font-size: 20px; letter-spacing: -.05em; }.picker-header .icon-close { justify-self: end; }--  .admin-stats .stat-card { min-height: 73px; gap: 8px; padding: 10px; }  .admin-stats .stat-card small { font-size: 7px; }  .admin-report-grid { grid-template-columns: minmax(0, 1fr); }  .admin-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }  .admin-filters .search-field { width: auto; grid-column: 1 / -1; }  .admin-filters .filter-select { width: 100%; min-width: 0; padding-inline: 8px 22px; }  .report-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }  .report-filters .search-field { grid-column: 1 / -1; width: auto; }  .report-filters .filter-select { width: 100%; max-width: none; min-width: 0; padding-inline: 8px 22px; }  .site-header .desktop-nav { margin-left: auto; }  .admin-demo-badge { font-size: 7px; padding: 6px 7px; }}"
