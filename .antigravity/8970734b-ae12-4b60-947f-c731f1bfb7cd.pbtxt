      arguments_json: "{\"CodeContent\":\"{\\n  \\\"entities\\\": {\\n    \\\"User\\\": {\\n      \\\"title\\\": \\\"User\\\",\\n      \\\"description\\\": \\\"User profile information\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"uid\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"displayName\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 100 },\\n        \\\"email\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 150 },\\n        \\\"photoURL\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 500 },\\n        \\\"role\\\": { \\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"user\\\", \\\"admin\\\"] },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"uid\\\", \\\"email\\\", \\\"createdAt\\\"]\\n    },\\n    \\\"Admin\\\": {\\n      \\\"title\\\": \\\"Admin\\\",\\n      \\\"description\\\": \\\"Admin authorization entry\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"uid\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"email\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 150 },\\n        \\\"assignedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"uid\\\", \\\"email\\\"]\\n    },\\n    \\\"Report\\\": {\\n      \\\"title\\\": \\\"Report\\\",\\n      \\\"description\\\": \\\"Community infrastructure report in Ras Al Khaimah\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"reportId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"authorName\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 100 },\\n        \\\"authorEmail\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 150 },\\n        \\\"title\\\": { \\\"type\\\": \\\"string\\\", \\\"minLength\\\": 3, \\\"maxLength\\\": 150 },\\n        \\\"description\\\": { \\\"type\\\": \\\"string\\\", \\\"minLength\\\": 10, \\\"maxLength\\\": 3000 },\\n        \\\"category\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"enum\\\": [\\n            \\\"Roads and Potholes\\\",\\n            \\\"Streetlights\\\",\\n            \\\"Waste Management\\\",\\n            \\\"Pavements\\\",\\n            \\\"Public Facilities\\\",\\n            \\\"Other Infrastructure\\\"\\n          ]\\n        },\\n        \\\"location\\\": { \\\"type\\\": \\\"string\\\", \\\"minLength\\\": 3, \\\"maxLength\\\": 200 },\\n        \\\"latitude\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"longitude\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"imageURL\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 2000000 },\\n        \\\"status\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"enum\\\": [\\\"Submitted\\\", \\\"Under Review\\\", \\\"In Progress\\\", \\\"Resolved\\\"]\\n        },\\n        \\\"isVerified\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"flagged\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"aiSummary\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 1000 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" },\\n        \\\"updatedAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"title\\\", \\\"description\\\", \\\"category\\\", \\\"location\\\", \\\"latitude\\\", \\\"longitude\\\", \\\"status\\\", \\\"createdAt\\\"]\\n    },\\n    \\\"ReportUpdate\\\": {\\n      \\\"title\\\": \\\"ReportUpdate\\\",\\n      \\\"description\\\": \\\"Administrative update on report status\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"updateId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"reportId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"previousStatus\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 50 },\\n        \\\"newStatus\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 50 },\\n        \\\"message\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 1000 },\\n        \\\"adminId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"adminName\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 100 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"reportId\\\", \\\"newStatus\\\", \\\"adminId\\\", \\\"createdAt\\\"]\\n    },\\n    \\\"Notification\\\": {\\n      \\\"title\\\": \\\"Notification\\\",\\n      \\\"description\\\": \\\"User notification for status updates\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"notificationId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"reportId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"title\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 150 },\\n        \\\"message\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 500 },\\n        \\\"read\\\": { \\\"type\\\": \\\"boolean\\\" },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"userId\\\", \\\"title\\\", \\\"message\\\", \\\"read\\\", \\\"createdAt\\\"]\\n    },\\n    \\\"Feedback\\\": {\\n      \\\"title\\\": \\\"Feedback\\\",\\n      \\\"description\\\": \\\"User platform feedback and rating\\\",\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"properties\\\": {\\n        \\\"feedbackId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"userId\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 128 },\\n        \\\"userName\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 100 },\\n        \\\"rating\\\": { \\\"type\\\": \\\"number\\\" },\\n        \\\"category\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 50 },\\n        \\\"message\\\": { \\\"type\\\": \\\"string\\\", \\\"maxLength\\\": 2000 },\\n        \\\"createdAt\\\": { \\\"type\\\": \\\"string\\\", \\\"format\\\": \\\"date-time\\\" }\\n      },\\n      \\\"required\\\": [\\\"rating\\\", \\\"message\\\", \\\"createdAt\\\"]\\n    }\\n  },\\n  \\\"firestore\\\": {\\n    \\\"/users/{userId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/User\\\" },\\n      \\\"description\\\": \\\"Stores user profile data\\\"\\n    },\\n    \\\"/admins/{adminId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/Admin\\\" },\\n      \\\"description\\\": \\\"Stores administrator authorization IDs\\\"\\n    },\\n    \\\"/reports/{reportId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/Report\\\" },\\n      \\\"description\\\": \\\"Public community infrastructure reports\\\"\\n    },\\n    \\\"/reports/{reportId}/updates/{updateId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/ReportUpdate\\\" },\\n      \\\"description\\\": \\\"Administrative updates for a report\\\"\\n    },\\n    \\\"/notifications/{notificationId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/Notification\\\" },\\n      \\\"description\\\": \\\"User notifications for report activity\\\"\\n    },\\n    \\\"/feedback/{feedbackId}\\\": {\\n      \\\"schema\\\": { \\\"$ref\\\": \\\"#/entities/Feedback\\\" },\\n      \\\"description\\\": \\\"Platform feedback submitted by users\\\"\\n    }\\n  }\\n}\\n\", \"Description\":\"Create firebase-blueprint.json for FixMyRAK collections and entities\", \"Overwrite\":true, \"TargetFile\":\"/firebase-blueprint.json\", \"toolAction\":\"Creating blueprint\", \"toolSummary\":\"Write firebase-blueprint.json\"}"
