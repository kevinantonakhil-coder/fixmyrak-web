  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { useAuth } from \'../context/AuthContext\';\nimport { reportService } from \'../services/reportService\';\nimport { Star, MessageSquare, CheckCircle, Send, Heart } from \'lucide-react\';\n\nexport const FeedbackPage: React.FC = () => {\n  const { user } = useAuth();\n  const [rating, setRating] = useState(5);\n  const [hoverRating, setHoverRating] = useState<number | null>(null);\n  const [category, setCategory] = useState(\'General Suggestion\');\n  const [message, setMessage] = useState(\'\');\n  const [isSubmitting, setIsSubmitting] = useState(false);\n  const [submitted, setSubmitted] = useState(false);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!message.trim() || message.trim().length < 3) {\n      alert(\'Please enter a brief message.\');\n      return;\n    }\n\n    setIsSubmitting(true);\n    try {\n      await reportService.submitFeedback({\n        userId: user?.uid,\n        userName: user?.displayName || user?.email?.split(\'@\')[0] || \'Community Resident\',\n        rating,\n        category,\n        message: message.trim(),\n      });\n      setSubmitted(true);\n    } catch (err) {\n      console.error(\'Feedback submission error:\', err);\n      alert(\'Failed to submit feedback.\');\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  return (\n    <div className=\"max-w-2xl mx-auto px-4 sm:px-6 py-12 space-y-8 animate-in fade-in\">\n      <div className=\"text-center space-y-2\">\n        <span className=\"text-xs font-bold text-emerald-700 uppercase tracking-widest bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200\">\n          Citizen Voice\n        </span>\n        <h1 className=\"text-3xl font-black text-slate-900 tracking-tight\">\n          Help Us Improve FixMyRAK\n        </h1>\n        <p className=\"text-xs sm:text-sm text-slate-600\">\n          Your feedback directly guides new civic enhancements, mobile experience improvements, and platform features.\n        </p>\n      </div>\n\n      {submitted ? (\n        <div className=\"bg-white p-8 rounded-3xl border border-slate-200 text-center space-y-4 shadow-sm\">\n          <div className=\"w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto\">\n            <CheckCircle className=\"w-8 h-8\" />\n          </div>\n          <h2 className=\"text-xl font-black text-slate-900\">Thank You for Your Feedback!</h2>\n          <p className=\"text-xs text-slate-600 max-w-sm mx-auto leading-relaxed\">\n            Your evaluation and notes have been logged to the coordinator feedback board. Thank you for making Ras Al Khaimah even better!\n          </p>\n          <button\n            onClick={() => {\n              setSubmitted(false);\n              setMessage(\'\');\n              setRating(5);\n            }}\n            className=\"px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-colors cursor-pointer\"\n          >\n            Submit Another Note\n          </button>\n        </div>\n      ) : (\n        <form\n          onSubmit={handleSubmit}\n          className=\"bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-md space-y-6\"\n        >\n          {/* Star Rating */}\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2\">\n              Overall Experience Rating\n            </label>\n            <div className=\"flex items-center gap-2\">\n              {[1, 2, 3, 4, 5].map((star) => (\n                <button\n                  key={star}\n                  type=\"button\"\n                  onClick={() => setRating(star)}\n                  onMouseEnter={() => setHoverRating(star)}\n                  onMouseLeave={() => setHoverRating(null)}\n                  className=\"p-1 hover:scale-115 transition-transform cursor-pointer\"\n                >\n                  <Star\n                    className={`w-8 h-8 ${\n                      (hoverRating !== null ? star <= hoverRating : star <= rating)\n                        ? \'fill-amber-400 text-amber-400\'\n                        : \'text-slate-200\'\n                    }`}\n                  />\n                </button>\n              ))}\n              <span className=\"text-xs font-bold text-slate-500 ml-2\">\n                {rating} of 5 Stars\n              </span>\n            </div>\n          </div>\n\n          {/* Feedback Category */}\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2\">\n              Feedback Topic\n            </label>\n            <select\n              value={category}\n              onChange={(e) => setCategory(e.target.value)}\n              className=\"w-full p-2.5 text-xs border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-hidden bg-slate-50 font-medium\"\n            >\n              <option value=\"General Suggestion\">General Suggestion</option>\n              <option value=\"Feature Request\">Feature Request</option>\n              <option value=\"Bug or Issue Encountered\">Bug or Issue Encountered</option>\n              <option value=\"Map & Geolocation Usability\">Map & Geolocation Usability</option>\n              <option value=\"AI Assistant Feedback\">AI Assistant Feedback</option>\n            </select>\n          </div>\n\n          {/* Message */}\n          <div>\n            <label className=\"block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2\">\n              Your Suggestions & Experience Notes\n            </label>\n            <textarea\n              required\n              rows={4}\n              value={message}\n              onChange={(e) => setMessage(e.target.value)}\n              placeholder=\"Tell us what worked well or what we can improve to make reporting infrastructure in Ras Al Khaimah easier...\"\n              className=\"w-full p-3 text-xs sm:text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-hidden bg-slate-50\"\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            disabled={isSubmitting}\n            className=\"w-full py-3 px-4 rounded-xl text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-98 shadow-sm transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50\"\n          >\n            <Send className=\"w-4 h-4\" />\n            <span>{isSubmitting ? \'Submitting...\' : \'Submit Citizen Feedback\'}</span>\n          </button>\n        </form>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/FeedbackPage.tsx"
        }
        overwrite: true
      }
    }
