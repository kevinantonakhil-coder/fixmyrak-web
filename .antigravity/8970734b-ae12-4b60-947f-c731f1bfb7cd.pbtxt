      thinking_signature: "\022\321\a\n\316\a\001i\024}\023\242\f\362\356\310\316\225\t!&\256\207\262o\365\363SN\'\266pKn\370\216A\347\267q\r\345\264o\317B\304K\325\256\006?\311\031F\210+C\355&\243I\024E0\020\203\002F\a#0\271\217\026\n\273\211m\030t.n\201\23379{\306\310Y /\2668\222\313\237\b86\352\200\2234\244\034x\242F\323\207\027\177}\0270\352\225\332\346\227\274\003\347dY\214!\372U\255S4\'\304c\336\016\315e\354\241\204\365\373}F\321=\262+\021c7\306\024\361\006\347+\3009?\202\373\220\350!\232\307\332JT\327y\2114\371\b\322\321 \211f:\374O\005\251l=\365\034\337h\203\232e\002p\335\227\006F\327\305p\261\356S\\\\P\243\t\204\226\271DF\317\b\177k\325\034\355\255t)\204Mx8\253\377n\213/\024WtAp\336\021\223r}\362_\223aNU5\200?\024\341\027\266\247\327m\263)\374\016\\\262\t\364N\a4]\001\'\277\224\223\352\345\321\340x\313:\201\241K\373\351\363\"3\261\026\177s\316\300\363\324\006\335\274\216j\261w\023\vY\301\353\f\032d\334\3071\030\216\017\035S\026\020\211\030Id\033\325=B\351\022\371Y\344\357m\273\vl\005U\376t\306W\021\256\367\bKG/\332\016\245qy\347\027\272\242\242g={\002)\3038\223\tU\036\004<\275:vD;8L\220C\215\240\214\377%\016\as\272\370\016\313\2272R\263\325\231\344|\321\310\230\3066\"\347}rb\310;\212\376\373\030\036+\352K\376\202\a\332\242\257\274\275\025\024\325\006\242\225m\235\326\2011\261\320Q\357\317oa\260!%\207\373\241\344w=\271\231\030\300\333\220\211\317A\223\205g6\275*\222W-\273\220\315\274\036!]\2704a\3643?\004@\001\375S\314\352\345\024\230\247M\376\243\362\025\271\264\005k\026\025\333\b\035w#\026c\345\277\314\272&\006i`\376\v\320\222\222\362\366\a2)\277e\331\322\241*\tJ\017\354\327\n\344A#\365\207s\233,\204\317$\273\246\024\342\333n\206m\207\367\231\322xr\231\\&\356\221\361[\232o\312\t\265l\360\365\"|i\205k\264\234\\\220H\360|3\211\360\301#$+\246\377\arXW\257\362JJ\230\277\227\252\241\272\266\211\032wR\246j>~\345Kt8\364z\304\b\025\n(\232\242b\357<\212\212_({7\207\247\245\232M\005i\232\323\323\207B\312\342\255w3B\304\377F\001S\241>\016\304L\252\250zS\255\226B1\344