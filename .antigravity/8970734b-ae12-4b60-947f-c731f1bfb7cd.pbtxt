  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useMemo } from \'react\';\nimport { Report, ReportCategory, ReportStatus } from \'../types\';\nimport {\n  Search,\n  Filter,\n  MapPin,\n  Calendar,\n  Grid,\n  List as ListIcon,\n  CheckCircle2,\n  Clock,\n  Sparkles,\n  ArrowUpDown,\n  X,\n} from \'lucide-react\';\n\ninterface ExploreReportsPageProps {\n  reports: Report[];\n  selectedCategory: ReportCategory | \'all\';\n  setSelectedCategory: (cat: ReportCategory | \'all\') => void;\n  onSelectReport: (report: Report) => void;\n  setCurrentTab: (tab: string) => void;\n}\n\nexport const ExploreReportsPage: React.FC<ExploreReportsPageProps> = ({\n  reports,\n  selectedCategory,\n  setSelectedCategory,\n  onSelectReport,\n  setCurrentTab,\n}) => {\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [selectedStatus, setSelectedStatus] = useState<ReportStatus | \'all\'>(\'all\');\n  const [sortOrder, setSortOrder] = useState<\'newest\' | \'oldest\'>(\'newest\');\n  const [viewMode, setViewMode] = useState<\'grid\' | \'list\'>(\'grid\');\n\n  const categories: (ReportCategory | \'all\')[] = [\n    \'all\',\n    \'Roads and Potholes\',\n    \'Streetlights\',\n    \'Waste Management\',\n    \'Pavements\',\n    \'Public Facilities\',\n    \'Other Infrastructure\',\n  ];\n\n  const statuses: (ReportStatus | \'all\')[] = [\n    \'all\',\n    \'Submitted\',\n    \'Under Review\',\n    \'In Progress\',\n    \'Resolved\',\n  ];\n\n  // Filtering & Sorting\n  const filteredReports = useMemo(() => {\n    return reports\n      .filter((report) => {\n        // Category filter\n        if (selectedCategory !== \'all\' && report.category !== selectedCategory) {\n          return false;\n        }\n        // Status filter\n        if (selectedStatus !== \'all\' && report.status !== selectedStatus) {\n          return false;\n        }\n        // Search query\n        if (searchQuery.trim()) {\n          const q = searchQuery.toLowerCase();\n          const matchTitle = report.title.toLowerCase().includes(q);\n          const matchDesc = report.description.toLowerCase().includes(q);\n          const matchLoc = report.location.toLowerCase().includes(q);\n          const matchCat = report.category.toLowerCase().includes(q);\n          if (!matchTitle && !matchDesc && !matchLoc && !matchCat) {\n            return false;\n          }\n        }\n        return true;\n      })\n      .sort((a, b) => {\n        const timeA = new Date(a.createdAt).getTime();\n        const timeB = new Date(b.createdAt).getTime();\n        return sortOrder === \'newest\' ? timeB - timeA : timeA - timeB;\n      });\n  }, [reports, selectedCategory, selectedStatus, searchQuery, sortOrder]);\n\n  const getStatusBadge = (status: ReportStatus) => {\n    switch (status) {\n      case \'Submitted\':\n        return \'bg-amber-100 text-amber-800 border-amber-300\';\n      case \'Under Review\':\n        return \'bg-sky-100 text-sky-800 border-sky-300\';\n      case \'In Progress\':\n        return \'bg-violet-100 text-violet-800 border-violet-300\';\n      case \'Resolved\':\n        return \'bg-emerald-100 text-emerald-800 border-emerald-300\';\n    }\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n      {/* Header */}\n      <div className=\"flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-slate-200\">\n        <div>\n          <span className=\"text-xs font-bold text-emerald-700 uppercase tracking-widest bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200\">\n            Ras Al Khaimah Public Reports\n          </span>\n          <h1 className=\"text-3xl font-black text-slate-900 tracking-tight mt-2\">\n            Explore Community Reports\n          </h1>\n          <p className=\"text-slate-600 text-xs sm:text-sm mt-1\">\n            Search, filter, and track verified civic issues reported by citizens and visitors across RAK.\n          </p>\n        </div>\n\n        <button\n          onClick={() => setCurrentTab(\'report\')}\n          className=\"px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold text-xs shadow-sm transition-all self-start md:self-auto cursor-pointer\"\n        >\n          + Submit New Report\n        </button>\n      </div>\n\n      {/* Search & Filter Controls */}\n      <div className=\"bg-white p-5 rounded-3xl border border-slate-200/90 shadow-sm space-y-4\">\n        {/* Top row: search + status + sort + view */}\n        <div className=\"flex flex-col md:flex-row items-center gap-3\">\n          {/* Search Box */}\n          <div className=\"relative flex-1 w-full\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-3\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"Search by keywords, street name, area, or description...\"\n              className=\"w-full pl-10 pr-10 py-2.5 text-xs sm:text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-emerald-500 focus:outline-hidden bg-slate-50/50\"\n            />\n            {searchQuery && (\n              <button\n                onClick={() => setSearchQuery(\'\')}\n                className=\"absolute right-3 top-2.5 text-slate-400 hover:text-slate-600\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            )}\n          </div>\n\n          {/* Status Filter */}\n          <div className=\"w-full md:w-48\">\n            <select\n              value={selectedStatus}\n              onChange={(e) => setSelectedStatus(e.target.value as ReportStatus | \'all\')}\n              className=\"w-full py-2.5 px-3 text-xs border border-slate-200 rounded-xl bg-slate-50 font-medium text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:outline-hidden\"\n            >\n              <option value=\"all\">All Statuses</option>\n              <option value=\"Submitted\">Submitted</option>\n              <option value=\"Under Review\">Under Review</option>\n              <option value=\"In Progress\">In Progress</option>\n              <option value=\"Resolved\">Resolved</option>\n            </select>\n          </div>\n\n          {/* Sort Order */}\n          <div className=\"w-full md:w-44\">\n            <select\n              value={sortOrder}\n              onChange={(e) => setSortOrder(e.target.value as \'newest\' | \'oldest\')}\n              className=\"w-full py-2.5 px-3 text-xs border border-slate-200 rounded-xl bg-slate-50 font-medium text-slate-700 focus:ring-2 focus:ring-emerald-500 focus:outline-hidden\"\n            >\n              <option value=\"newest\">Sort: Newest First</option>\n              <option value=\"oldest\">Sort: Oldest First</option>\n            </select>\n          </div>\n\n          {/* Grid / List Mode */}\n          <div className=\"hidden sm:flex items-center gap-1 bg-slate-100 p-1 rounded-xl shrink-0\">\n            <button\n              onClick={() => setViewMode(\'grid\')}\n              className={`p-1.5 rounded-lg transition-colors ${\n                viewMode === \'grid\' ? \'bg-white text-slate-900 shadow-xs\' : \'text-slate-500 hover:text-slate-800\'\n              }`}\n              title=\"Grid View\"\n            >\n              <Grid className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => setViewMode(\'list\')}\n              className={`p-1.5 rounded-lg transition-colors ${\n                viewMode === \'list\' ? \'bg-white text-slate-900 shadow-xs\' : \'text-slate-500 hover:text-slate-800\'\n              }`}\n              title=\"List View\"\n            >\n              <ListIcon className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Category Pills Filter */}\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-1 scrollbar-thin\">\n          <span className=\"text-xs font-bold text-slate-400 shrink-0 uppercase tracking-wider mr-1\">\n            Category:\n          </span>\n          {categories.map((cat) => (\n            <button\n              key={cat}\n              onClick={() => setSelectedCategory(cat)}\n              className={`whitespace-nowrap px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all shrink-0 cursor-pointer ${\n                selectedCategory === cat\n                  ? \'bg-emerald-600 text-white shadow-xs\'\n                  : \'bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200/60\'\n              }`}\n            >\n              {cat === \'all\' ? \'All Categories\' : cat}\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* Results Count & Active Filters Indicator */}\n      <div className=\"flex items-center justify-between text-xs text-slate-500 px-1\">\n        <p>\n          Showing <strong className=\"text-slate-800\">{filteredReports.length}</strong> of{\' \'}\n          {reports.length} reports\n          {selectedCategory !== \'all\' && (\n            <span> in <strong className=\"text-emerald-700\">{selectedCategory}</strong></span>\n          )}\n          {selectedStatus !== \'all\' && (\n            <span> ({selectedStatus})</span>\n          )}\n        </p>\n\n        {(selectedCategory !== \'all\' || selectedStatus !== \'all\' || searchQuery) && (\n          <button\n            onClick={() => {\n              setSelectedCategory(\'all\');\n              setSelectedStatus(\'all\');\n              setSearchQuery(\'\');\n            }}\n            className=\"text-emerald-700 font-bold hover:underline\"\n          >\n            Clear all filters\n          </button>\n        )}\n      </div>\n\n      {/* Reports Display: Grid or List */}\n      {filteredReports.length === 0 ? (\n        <div className=\"bg-white rounded-3xl p-12 text-center border border-slate-200/80 shadow-xs space-y-4\">\n          <div className=\"w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto text-slate-400\">\n            <Search className=\"w-8 h-8\" />\n          </div>\n          <h3 className=\"text-lg font-bold text-slate-800\">No matching reports found</h3>\n          <p className=\"text-xs text-slate-500 max-w-md mx-auto\">\n            Try adjusting your search keywords, clearing status filters, or selecting a different category.\n          </p>\n          <button\n            onClick={() => {\n              setSelectedCategory(\'all\');\n              setSelectedStatus(\'all\');\n              setSearchQuery(\'\');\n            }}\n            className=\"px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors\"\n          >\n            Reset Filters\n          </button>\n        </div>\n      ) : viewMode === \'grid\' ? (\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {filteredReports.map((report) => (\n            <div\n              key={report.id}\n              onClick={() => onSelectReport(report)}\n              className=\"bg-white rounded-3xl border border-slate-200/90 overflow-hidden hover:shadow-xl transition-all cursor-pointer flex flex-col justify-between group\"\n            >\n              {/* Photo or placeholder */}\n              {report.imageURL ? (\n                <div className=\"h-48 w-full bg-slate-100 overflow-hidden relative\">\n                  <img\n                    src={report.imageURL}\n                    alt={report.title}\n                    className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                  />\n                  <div className=\"absolute top-3 left-3 flex items-center gap-1.5\">\n                    <span\n                      className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border shadow-xs ${getStatusBadge(\n                        report.status\n                      )}`}\n                    >\n                      {report.status}\n                    </span>\n                    {report.isVerified && (\n                      <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-sky-500 text-white shadow-xs\">\n                        Verified\n                      </span>\n                    )}\n                  </div>\n                </div>\n              ) : (\n                <div className=\"h-32 w-full bg-gradient-to-br from-slate-100 to-slate-200 p-4 flex flex-col justify-between\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span\n                      className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border shadow-xs ${getStatusBadge(\n                        report.status\n                      )}`}\n                    >\n                      {report.status}\n                    </span>\n                    {report.isVerified && (\n                      <span className=\"text-[10px] font-bold px-2 py-0.5 rounded-full bg-sky-500 text-white shadow-xs\">\n                        Verified\n                      </span>\n                    )}\n                  </div>\n                  <span className=\"text-xs font-bold text-slate-600\">\n                    {report.category}\n                  </span>\n                </div>\n              )}\n\n              {/* Card Body */}\n              <div className=\"p-5 flex-1 flex flex-col justify-between\">\n                <div>\n                  <div className=\"flex items-center gap-1 text-[11px] font-medium text-slate-400 mb-1.5\">\n                    <Calendar className=\"w-3 h-3\" />\n                    <span>\n                      {new Date(report.createdAt).toLocaleDateString(\'en-AE\', {\n                        day: \'numeric\',\n                        month: \'short\',\n                        year: \'numeric\',\n                      })}\n                    </span>\n                    <span>&bull;</span>\n                    <span className=\"text-slate-600 font-semibold\">{report.category}</span>\n                  </div>\n\n                  <h3 className=\"text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors line-clamp-2\">\n                    {report.title}\n                  </h3>\n\n                  <p className=\"text-xs text-slate-600 mt-2 line-clamp-3 leading-relaxed\">\n                    {report.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-5 pt-3 border-t border-slate-100 flex items-center justify-between text-xs\">\n                  <span className=\"text-slate-600 truncate max-w-[180px] flex items-center gap-1 text-[11px]\">\n                    <MapPin className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n                    {report.location}\n                  </span>\n                  <span className=\"font-bold text-emerald-700 shrink-0\">View Details &rarr;</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      ) : (\n        /* List Mode */\n        <div className=\"bg-white rounded-3xl border border-slate-200 divide-y divide-slate-100 overflow-hidden shadow-xs\">\n          {filteredReports.map((report) => (\n            <div\n              key={report.id}\n              onClick={() => onSelectReport(report)}\n              className=\"p-5 hover:bg-slate-50 transition-colors cursor-pointer flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4\"\n            >\n              <div className=\"flex items-start gap-4 flex-1\">\n                {report.imageURL ? (\n                  <img\n                    src={report.imageURL}\n                    alt={report.title}\n                    className=\"w-20 h-20 rounded-2xl object-cover shrink-0 hidden sm:block\"\n                  />\n                ) : (\n                  <div className=\"w-20 h-20 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400 shrink-0 hidden sm:flex\">\n                    <MapPin className=\"w-6 h-6\" />\n                  </div>\n                )}\n\n                <div className=\"space-y-1\">\n                  <div className=\"flex items-center gap-2\">\n                    <span\n                      className={`text-[10px] font-bold px-2 py-0.5 rounded-full border ${getStatusBadge(\n                        report.status\n                      )}`}\n                    >\n                      {report.status}\n                    </span>\n                    <span className=\"text-xs font-semibold text-slate-500\">\n                      {report.category}\n                    </span>\n                  </div>\n\n                  <h3 className=\"text-sm font-bold text-slate-900 hover:text-emerald-700 transition-colors\">\n                    {report.title}\n                  </h3>\n\n                  <p className=\"text-xs text-slate-500 line-clamp-1\">\n                    {report.description}\n                  </p>\n\n                  <div className=\"flex items-center gap-3 text-[11px] text-slate-400 pt-1\">\n                    <span className=\"flex items-center gap-1 text-slate-600\">\n                      <MapPin className=\"w-3 h-3 text-emerald-600\" />\n                      {report.location}\n                    </span>\n                    <span>&bull;</span>\n                    <span>{new Date(report.createdAt).toLocaleDateString()}</span>\n                  </div>\n                </div>\n              </div>\n\n              <button className=\"px-4 py-2 bg-slate-100 hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 font-bold text-xs rounded-xl transition-colors shrink-0\">\n                View &rarr;\n              </button>\n            </div>\n          ))}\n        </div>\n      )}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/ExploreReportsPage.tsx"
        }
        overwrite: true
      }
