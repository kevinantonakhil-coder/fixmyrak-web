      create_file {
        instruction: "import React from \'react\';\nimport { Report, ReportCategory, ReportStatus } from \'../types\';\nimport { MapComponent } from \'../components/MapComponent\';\nimport {\n  MapPin,\n  PlusCircle,\n  Search,\n  CheckCircle2,\n  Clock,\n  Sparkles,\n  ArrowRight,\n  ShieldCheck,\n  AlertTriangle,\n  Lightbulb,\n  Trash2,\n  Footprints,\n  Building2,\n  Wrench,\n  ChevronRight,\n  TrendingUp,\n} from \'lucide-react\';\n\ninterface HomePageProps {\n  reports: Report[];\n  setCurrentTab: (tab: string) => void;\n  setSelectedCategory: (cat: ReportCategory | \'all\') => void;\n  onSelectReport: (report: Report) => void;\n  openAuthModal: () => void;\n}\n\nexport const HomePage: React.FC<HomePageProps> = ({\n  reports,\n  setCurrentTab,\n  setSelectedCategory,\n  onSelectReport,\n  openAuthModal,\n}) => {\n  // Compute live statistics from Firestore data\n  const totalCount = reports.length;\n  const underReviewCount = reports.filter((r) => r.status === \'Under Review\').length;\n  const inProgressCount = reports.filter((r) => r.status === \'In Progress\').length;\n  const resolvedCount = reports.filter((r) => r.status === \'Resolved\').length;\n\n  const categories = [\n    {\n      title: \'Roads and Potholes\' as ReportCategory,\n      desc: \'Asphalt cracks, potholes, street surface hazards\',\n      icon: AlertTriangle,\n      color: \'bg-amber-500/10 text-amber-600 border-amber-200\',\n    },\n    {\n      title: \'Streetlights\' as ReportCategory,\n      desc: \'Broken lamps, dark sections, electrical pole safety\',\n      icon: Lightbulb,\n      color: \'bg-sky-500/10 text-sky-600 border-sky-200\',\n    },\n    {\n      title: \'Waste Management\' as ReportCategory,\n      desc: \'Overflowing bins, illegal dumping, littering\',\n      icon: Trash2,\n      color: \'bg-emerald-500/10 text-emerald-600 border-emerald-200\',\n    },\n    {\n      title: \'Pavements\' as ReportCategory,\n      desc: \'Broken curb stones, sunken walkway tiles, pedestrian paths\',\n      icon: Footprints,\n      color: \'bg-teal-500/10 text-teal-600 border-teal-200\',\n    },\n    {\n      title: \'Public Facilities\' as ReportCategory,\n      desc: \'Community parks, shaded benches, beach amenities\',\n      icon: Building2,\n      color: \'bg-indigo-500/10 text-indigo-600 border-indigo-200\',\n    },\n    {\n      title: \'Other Infrastructure\' as ReportCategory,\n      desc: \'Traffic guardrails, signage, water drainage covers\',\n      icon: Wrench,\n      color: \'bg-rose-500/10 text-rose-600 border-rose-200\',\n    },\n  ];\n\n  const recentReports = reports.slice(0, 4);\n\n  const getStatusStyle = (status: ReportStatus) => {\n    switch (status) {\n      case \'Submitted\':\n        return \'bg-amber-100 text-amber-800 border-amber-200\';\n      case \'Under Review\':\n        return \'bg-sky-100 text-sky-800 border-sky-200\';\n      case \'In Progress\':\n        return \'bg-violet-100 text-violet-800 border-violet-200\';\n      case \'Resolved\':\n        return \'bg-emerald-100 text-emerald-800 border-emerald-200\';\n    }\n  };\n\n  return (\n    <div className=\"space-y-16 pb-16\">\n      {/* Hero Section */}\n      <section className=\"relative overflow-hidden bg-gradient-to-b from-emerald-950 via-slate-900 to-slate-950 text-white pt-16 pb-20 px-4 sm:px-6 lg:px-8\">\n        {/* Subtle UAE-inspired background elements */}\n        <div className=\"absolute inset-0 opacity-20 pointer-events-none\">\n          <div className=\"absolute top-10 left-1/4 w-96 h-96 bg-emerald-500/30 rounded-full blur-3xl\"></div>\n          <div className=\"absolute bottom-10 right-1/4 w-96 h-96 bg-teal-500/20 rounded-full blur-3xl\"></div>\n        </div>\n\n        <div className=\"relative max-w-5xl mx-auto text-center space-y-6\">\n          <div className=\"inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-xs font-bold tracking-wide animate-in fade-in\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n            Empowering Ras Al Khaimah Communities\n          </div>\n\n          <h1 className=\"text-4xl sm:text-6xl font-black tracking-tight leading-tight sm:leading-tight\">\n            Your Community. Your Voice. <br />\n            <span className=\"bg-gradient-to-r from-emerald-400 via-teal-300 to-sky-400 bg-clip-text text-transparent\">\n              A Better RAK.\n            </span>\n          </h1>\n\n          <p className=\"max-w-2xl mx-auto text-base sm:text-lg text-slate-300 font-normal leading-relaxed\">\n            Report potholes, faulty streetlights, waste concerns, and public facility damages across\n            Ras Al Khaimah. Powered by Gemini AI for instant categorization and real-time municipal tracking.\n          </p>\n\n          <div className=\"flex flex-col sm:flex-row items-center justify-center gap-3.5 pt-4\">\n            <button\n              onClick={() => setCurrentTab(\'report\')}\n              className=\"w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 active:scale-95 text-slate-950 font-black text-sm shadow-lg shadow-emerald-500/30 transition-all flex items-center justify-center gap-2 cursor-pointer\"\n            >\n              <PlusCircle className=\"w-5 h-5 text-slate-950\" />\n              <span>Report an Issue Now</span>\n            </button>\n\n            <button\n              onClick={() => setCurrentTab(\'explore\')}\n              className=\"w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-slate-800/90 hover:bg-slate-700/90 active:scale-95 text-white font-bold text-sm border border-slate-700 transition-all flex items-center justify-center gap-2 cursor-pointer\"\n            >\n              <Search className=\"w-4 h-4 text-slate-300\" />\n              <span>Explore Public Reports</span>\n            </button>\n          </div>\n\n          <div className=\"pt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-slate-400\">\n            <span className=\"flex items-center gap-1.5\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-400\" />\n              Real-time Firestore Database\n            </span>\n            <span className=\"flex items-center gap-1.5\">\n              <Sparkles className=\"w-4 h-4 text-teal-400\" />\n              Google Gemini 3.8 AI Assistant\n            </span>\n            <span className=\"flex items-center gap-1.5\">\n              <MapPin className=\"w-4 h-4 text-sky-400\" />\n              Interactive Ras Al Khaimah Map\n            </span>\n          </div>\n        </div>\n      </section>\n\n      {/* Live Community Statistics Section (From Firestore) */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-20\">\n        <div className=\"bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-slate-200/90\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between pb-6 border-b border-slate-100 gap-2\">\n            <div>\n              <h2 className=\"text-lg font-black text-slate-900 flex items-center gap-2\">\n                <TrendingUp className=\"w-5 h-5 text-emerald-600\" />\n                Community Impact Metrics\n              </h2>\n              <p className=\"text-xs text-slate-500\">\n                Live statistics dynamically computed from verified Cloud Firestore reports.\n              </p>\n            </div>\n            <div className=\"text-xs font-semibold text-emerald-700 bg-emerald-50 px-3 py-1.5 rounded-xl border border-emerald-200 self-start sm:self-auto\">\n              Live Synchronized\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 pt-6\">\n            <div className=\"p-4 sm:p-5 rounded-2xl bg-slate-50 border border-slate-200/80\">\n              <p className=\"text-xs font-semibold text-slate-500 uppercase tracking-wider\">\n                Total Reports\n              </p>\n              <p className=\"text-3xl sm:text-4xl font-black text-slate-900 mt-2\">\n                {totalCount}\n              </p>\n              <p className=\"text-[11px] text-slate-500 mt-1\">Community submissions</p>\n            </div>\n\n            <div className=\"p-4 sm:p-5 rounded-2xl bg-sky-50/70 border border-sky-200/80\">\n              <p className=\"text-xs font-semibold text-sky-700 uppercase tracking-wider\">\n                Under Review\n              </p>\n              <p className=\"text-3xl sm:text-4xl font-black text-sky-900 mt-2\">\n                {underReviewCount}\n              </p>\n              <p className=\"text-[11px] text-sky-600 mt-1\">Being assessed by coordinators</p>\n            </div>\n\n            <div className=\"p-4 sm:p-5 rounded-2xl bg-violet-50/70 border border-violet-200/80\">\n              <p className=\"text-xs font-semibold text-violet-700 uppercase tracking-wider\">\n                In Progress\n              </p>\n              <p className=\"text-3xl sm:text-4xl font-black text-violet-900 mt-2\">\n                {inProgressCount}\n              </p>\n              <p className=\"text-[11px] text-violet-600 mt-1\">Maintenance teams dispatched</p>\n            </div>\n\n            <div className=\"p-4 sm:p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200/80\">\n              <p className=\"text-xs font-semibold text-emerald-700 uppercase tracking-wider\">\n                Resolved Issues\n              </p>\n              <p className=\"text-3xl sm:text-4xl font-black text-emerald-900 mt-2\">\n                {resolvedCount}\n              </p>\n              <p className=\"text-[11px] text-emerald-600 mt-1\">Fixed & verified infrastructure</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* How It Works Section */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"text-center max-w-2xl mx-auto mb-12\">\n          <span className=\"text-xs font-bold text-emerald-700 uppercase tracking-widest bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200\">\n            Simple 4-Step Process\n          </span>\n          <h2 className=\"text-3xl font-black text-slate-900 tracking-tight mt-3\">\n            How FixMyRAK Operates\n          </h2>\n          <p className=\"text-slate-600 text-sm mt-2\">\n            Civic transparency designed to make infrastructure reporting in Ras Al Khaimah seamless and dependable.\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-6\">\n          <div className=\"bg-white p-6 rounded-3xl border border-slate-200/90 shadow-xs relative group hover:border-emerald-300 transition-all\">\n            <div className=\"w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-black text-lg mb-4\">\n              1\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-1.5\">\n              Spot & Describe\n            </h3>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              Describe the issue in your own words. Snap an optional photograph directly from your phone.\n            </p>\n          </div>\n\n          <div className=\"bg-white p-6 rounded-3xl border border-slate-200/90 shadow-xs relative group hover:border-emerald-300 transition-all\">\n            <div className=\"w-12 h-12 rounded-2xl bg-teal-100 text-teal-700 flex items-center justify-center font-black text-lg mb-4\">\n              2\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-1.5\">\n              AI Categorization\n            </h3>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              Gemini 3.8 Flash automatically identifies the category, suggests a clear title, and checks for duplicates.\n            </p>\n          </div>\n\n          <div className=\"bg-white p-6 rounded-3xl border border-slate-200/90 shadow-xs relative group hover:border-emerald-300 transition-all\">\n            <div className=\"w-12 h-12 rounded-2xl bg-sky-100 text-sky-700 flex items-center justify-center font-black text-lg mb-4\">\n              3\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-1.5\">\n              Pinpoint on Map\n            </h3>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              Select the exact spot on the Ras Al Khaimah map with GPS precision or quick neighborhood presets.\n            </p>\n          </div>\n\n          <div className=\"bg-white p-6 rounded-3xl border border-slate-200/90 shadow-xs relative group hover:border-emerald-300 transition-all\">\n            <div className=\"w-12 h-12 rounded-2xl bg-violet-100 text-violet-700 flex items-center justify-center font-black text-lg mb-4\">\n              4\n            </div>\n            <h3 className=\"text-base font-bold text-slate-900 mb-1.5\">\n              Track & Resolve\n            </h3>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              Follow transparent status updates with notifications as the issue advances from review to resolution.\n            </p>\n          </div>\n        </div>\n      </section>\n\n      {/* Categories Grid */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-3\">\n          <div>\n            <span className=\"text-xs font-bold text-emerald-700 uppercase tracking-widest bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200\">\n              Civic Infrastructure\n            </span>\n            <h2 className=\"text-3xl font-black text-slate-900 tracking-tight mt-2\">\n              Browse by Issue Category\n            </h2>\n            <p className=\"text-slate-600 text-xs sm:text-sm mt-1\">\n              Select a category to filter community reports and view active issues.\n            </p>\n          </div>\n\n          <button\n            onClick={() => {\n              setSelectedCategory(\'all\');\n              setCurrentTab(\'explore\');\n            }}\n            className=\"text-xs font-bold text-emerald-700 hover:text-emerald-800 flex items-center gap-1 group self-start sm:self-auto\"\n          >\n            <span>View All Reports</span>\n            <ChevronRight className=\"w-4 h-4 group-hover:translate-x-0.5 transition-transform\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5\">\n          {categories.map((cat) => {\n            const count = reports.filter((r) => r.category === cat.title).length;\n            const Icon = cat.icon;\n            return (\n              <div\n                key={cat.title}\n                onClick={() => {\n                  setSelectedCategory(cat.title);\n                  setCurrentTab(\'explore\');\n                }}\n                className=\"bg-white p-6 rounded-3xl border border-slate-200/90 hover:border-emerald-300 hover:shadow-md transition-all cursor-pointer group flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-center justify-between mb-4\">\n                    <div className={`w-12 h-12 rounded-2xl border flex items-center justify-center ${cat.color}`}>\n                      <Icon className=\"w-6 h-6\" />\n                    </div>\n                    <span className=\"text-xs font-bold px-2.5 py-1 bg-slate-100 text-slate-700 rounded-full\">\n                      {count} {count === 1 ? \'Report\' : \'Reports\'}\n                    </span>\n                  </div>\n                  <h3 className=\"text-base font-bold text-slate-900 group-hover:text-emerald-700 transition-colors\">\n                    {cat.title}\n                  </h3>\n                  <p className=\"text-xs text-slate-500 mt-1 leading-relaxed\">\n                    {cat.desc}\n                  </p>\n                </div>\n\n                <div className=\"mt-5 pt-4 border-t border-slate-100 flex items-center justify-between text-xs font-bold text-emerald-700\">\n                  <span>Explore category</span>\n                  <ArrowRight className=\"w-3.5 h-3.5 group-hover:translate-x-1 transition-transform\" />\n                </div>\n              </div>\n            );\n          })}\n        </div>\n      </section>\n\n      {/* Interactive Map Preview Section */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-white rounded-3xl p-6 sm:p-8 border border-slate-200/90 shadow-md\">\n          <div className=\"flex flex-col sm:flex-row sm:items-center justify-between pb-6 gap-3\">\n            <div>\n              <span className=\"text-xs font-bold text-sky-700 uppercase tracking-widest bg-sky-50 px-3 py-1 rounded-full border border-sky-200\">\n                Geographic Presence\n              </span>\n              <h2 className=\"text-2xl sm:text-3xl font-black text-slate-900 tracking-tight mt-2\">\n                Ras Al Khaimah Map View\n              </h2>\n              <p className=\"text-slate-600 text-xs sm:text-sm mt-1\">\n                Explore real community reports across Al Nakheel, Corniche Al Qawasim, Al Hamra, Mina Al Arab, and Jebel Jais.\n              </p>\n            </div>\n\n            <button\n              onClick={() => setCurrentTab(\'map\')}\n              className=\"px-5 py-2.5 rounded-xl bg-slate-900 text-white hover:bg-slate-800 text-xs font-bold transition-all flex items-center gap-2 self-start sm:self-auto cursor-pointer\"\n            >\n              <MapPin className=\"w-4 h-4 text-emerald-400\" />\n              <span>Open Full Interactive Map</span>\n            </button>\n          </div>\n\n          <MapComponent\n            reports={reports}\n            onSelectReport={onSelectReport}\n            height=\"460px\"\n            zoomLevel={11}\n          />\n        </div>\n      </section>\n\n      {/* Recent Community Reports Feed */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between mb-8\">\n          <div>\n            <span className=\"text-xs font-bold text-emerald-700 uppercase tracking-widest bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200\">\n              Community Feed\n            </span>\n            <h2 className=\"text-3xl font-black text-slate-900 tracking-tight mt-2\">\n              Recent Infrastructure Reports\n            </h2>\n          </div>\n\n          <button\n            onClick={() => setCurrentTab(\'explore\')}\n            className=\"text-xs font-bold text-emerald-700 hover:underline flex items-center gap-1\"\n          >\n            <span>View All ({reports.length})</span>\n            <ChevronRight className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5\">\n          {recentReports.map((report) => (\n            <div\n              key={report.id}\n              onClick={() => onSelectReport(report)}\n              className=\"bg-white rounded-3xl border border-slate-200/90 overflow-hidden hover:shadow-lg transition-all cursor-pointer flex flex-col justify-between group\"\n            >\n              {/* Image thumbnail or category header */}\n              {report.imageURL ? (\n                <div className=\"h-44 w-full bg-slate-100 overflow-hidden relative\">\n                  <img\n                    src={report.imageURL}\n                    alt={report.title}\n                    className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                  />\n                  <span\n                    className={`absolute top-3 left-3 text-[10px] font-bold px-2.5 py-0.5 rounded-full border shadow-xs ${getStatusStyle(\n                      report.status\n                    )}`}\n                  >\n                    {report.status}\n                  </span>\n                </div>\n              ) : (\n                <div className=\"h-32 w-full bg-gradient-to-br from-slate-100 to-slate-200 p-4 flex flex-col justify-between\">\n                  <span\n                    className={`text-[10px] font-bold px-2.5 py-0.5 rounded-full border self-start shadow-xs ${getStatusStyle(\n                      report.status\n                    )}`}\n                  >\n                    {report.status}\n                  </span>\n                  <span className=\"text-[11px] font-bold text-slate-600\">\n                    {report.category}\n                  </span>\n                </div>\n              )}\n\n              {/* Card info */}\n              <div className=\"p-5 flex-1 flex flex-col justify-between\">\n                <div>\n                  <div className=\"flex items-center gap-1 text-[11px] font-medium text-slate-400 mb-1.5\">\n                    <Clock className=\"w-3 h-3\" />\n                    <span>\n                      {new Date(report.createdAt).toLocaleDateString(\'en-AE\', {\n                        day: \'numeric\',\n                        month: \'short\',\n                      })}\n                    </span>\n                    <span>&bull;</span>\n                    <span className=\"text-slate-600 font-semibold\">{report.category}</span>\n                  </div>\n\n                  <h3 className=\"text-sm font-bold text-slate-900 group-hover:text-emerald-700 transition-colors line-clamp-2\">\n                    {report.title}\n                  </h3>\n\n                  <p className=\"text-xs text-slate-500 mt-1.5 line-clamp-2\">\n                    {report.description}\n                  </p>\n                </div>\n\n                <div className=\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs\">\n                  <span className=\"text-slate-600 truncate max-w-[160px] flex items-center gap-1 text-[11px]\">\n                    <MapPin className=\"w-3 h-3 text-emerald-600 shrink-0\" />\n                    {report.location}\n                  </span>\n                  <span className=\"font-bold text-emerald-700 shrink-0\">Details &rarr;</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* Community Call to Action */}\n      <section className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"rounded-3xl bg-gradient-to-r from-emerald-800 via-teal-800 to-slate-900 p-8 sm:p-12 text-white flex flex-col md:flex-row items-center justify-between gap-8 shadow-xl\">\n          <div className=\"space-y-3 max-w-xl text-center md:text-left\">\n            <h3 className=\"text-2xl sm:text-3xl font-black tracking-tight\">\n              Notice a problem in your neighborhood?\n            </h3>\n            <p className=\"text-emerald-100 text-xs sm:text-sm leading-relaxed\">\n              It takes less than 60 seconds to file a report. With Gemini AI categorization and location tracking, you help build a safer, cleaner Ras Al Khaimah.\n            </p>\n          </div>\n\n          <button\n            onClick={() => setCurrentTab(\'report\')}\n            className=\"px-8 py-4 rounded-2xl bg-white hover:bg-emerald-50 text-slate-900 font-black text-sm shadow-lg active:scale-95 transition-all shrink-0 flex items-center gap-2 cursor-pointer\"\n          >\n            <PlusCircle className=\"w-5 h-5 text-emerald-600\" />\n            <span>Submit a Free Report</span>\n          </button>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/HomePage.tsx"
        }
        overwrite: true
      }
    }
