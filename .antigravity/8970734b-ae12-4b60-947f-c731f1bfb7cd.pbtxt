    combined_output {
      full: "<truncated 24 bytes>\nria-hidden=\"true\">\342\214\225</span><span class=\"sr-only\">Search reports</span><input id=\"report-search\" type=\"search\" placeholder=\"Search reports\" autocomplete=\"off\" /></label>            <label class=\"sr-only\" for=\"status-filter\">Filter by status</label>            <select id=\"status-filter\" class=\"filter-select\"><option value=\"all\">All statuses</option><option>Received</option><option>Under review</option><option>Resolved</option></select>            <label class=\"sr-only\" for=\"report-category-filter\">Filter by category</label>            <select id=\"report-category-filter\" class=\"filter-select\"><option value=\"all\">All categories</option><option>Roads &amp; sidewalks</option><option>Street lighting</option><option>Cleanliness</option><option>Parks &amp; public spaces</option><option>Water &amp; drainage</option><option>Other</option></select>          </div>        </div>        <div class=\"reports-grid\" id=\"reports-grid\"></div>        <p class=\"unverified-note\">\342\223\230 Community-shared and unverified. Reports are not sent to local authorities. Avoid names, contact details, and private addresses.</p>      </section>      <section class=\"track-section content-wrap\">        <div class=\"track-card\"><div class=\"track-decoration\" aria-hidden=\"true\">\342\234\263</div>          <div class=\"track-copy\"><div class=\"eyebrow\">Already reported something?</div><h2>Check in on your report.</h2><p>Enter the unique ID you received when you submitted a report.</p></div>          <form id=\"track-form\" class=\"track-form\"><label class=\"sr-only\" for=\"track-id\">Report ID</label><input id=\"track-id\" type=\"text\" placeholder=\"e.g. FMR-26-A3C9D1\" maxlength=\"24\" autocomplete=\"off\" /><button class=\"button button-dark\" type=\"submit\">Find my report \342\206\222</button><div class=\"track-result\" id=\"track-result\" aria-live=\"polite\"></div></form>        </div>      </section>      <section class=\"closing content-wrap\"><div><div class=\"eyebrow\">Every cared-for place starts with someone who cares.</div><h2>See something?<br /><span>Say something.</span></h2></div><button class=\"button button-dark button-large\" type=\"button\" data-open-report>\357\274\213 Report an issue \342\206\222</button><div class=\"closing-flower\" aria-hidden=\"true\">\342\234\263</div></section>    </main>    <footer class=\"site-footer content-wrap\">      <a class=\"brand footer-brand\" href=\"#top\"><img src=\"./assets/fixmyrak-mark.svg\" alt=\"\" width=\"34\" height=\"34\" /><span class=\"brand-name\">FixMy<span>RAK</span><small>RAK, together.</small></span></a>      <p>Made with care for the community of Ras Al Khaimah.</p><span>Photo: <a href=\"https://commons.wikimedia.org/wiki/File:Jebel_Jais_Mountain_Ranges_as_viewed_from_Ras_Al_Khaimah,_United_Arab_Emirates.jpg\" target=\"_blank\" rel=\"noreferrer\">Ginevrajocosa88 \302\267 CC0</a></span><span>COMMUNITY DEMO \302\267 <span id=\"year\"></span></span>    </footer>    <dialog class=\"report-dialog\" id=\"report-dialog\" aria-labelledby=\"dialog-title\">      <div class=\"dialog-header\"><div><div class=\"eyebrow\">Your community, your voice</div><h2 id=\"dialog-title\">Report a local issue</h2></div><button class=\"icon-close\" type=\"button\" data-close-dialog aria-label=\"Close report form\">\303\227</button></div>      <p class=\"dialog-intro\">Share a helpful heads-up. No name or contact details needed.</p>      <form id=\"report-form\">        <label class=\"form-label\" for=\"report-category\">What did you notice?<select id=\"report-category\" required><option value=\"\">Choose a category</option><option>Roads &amp; sidewalks</option><option>Street lighting</option><option>Cleanliness</option><option>Parks &amp; public spaces</option><option>Water &amp; drainage</option><option>Other</option></select></label>        <label class=\"form-label\" for=\"report-description\">A few details<textarea id=\"report-description\" rows=\"3\" maxlength=\"500\" placeholder=\"What should your neighbors know?\" required></textarea><span class=\"field-hint\">Please don\342\200\231t include names, phone numbers, or private addresses.</span></label>        <div class=\"location-field\"><label class=\"form-label\" for=\"report-location\">Neighborhood or public landmark<input id=\"report-location\" type=\"text\" maxlength=\"80\" placeholder=\"e.g. Near Al Nakheel Park\" required /></label><button class=\"button button-outline location-button\" type=\"button\" id=\"choose-location\">\342\214\226 Choose on map</button></div>        <div class=\"selected-location\" id=\"selected-location\" aria-live=\"polite\">\342\227\216 Choose a public place or road on the map.</div>        <div class=\"duplicate-warning\" id=\"duplicate-warning\" role=\"status\" hidden></div>        <p class=\"form-error\" id=\"form-error\" role=\"alert\"></p>        <div class=\"demo-disclaimer\"><span>\342\223\230</span><span><strong>Community demo.</strong> Your report will be visible to site visitors; submissions are not sent to local authorities.</span></div>        <div class=\"dialog-actions\"><button class=\"button button-outline\" type=\"button\" data-close-dialog>Cancel</button><button class=\"button button-dark\" type=\"submit\">Save report \342\206\222</button></div>      </form>    </dialog>    <dialog class=\"map-picker-dialog\" id=\"map-picker-dialog\" aria-labelledby=\"map-picker-title\">      <header class=\"picker-header\">        <a class=\"brand picker-brand\" href=\"#top\" tabindex=\"-1\" aria-hidden=\"true\">          <img src=\"./assets/fixmyrak-mark.svg\" alt=\"\" width=\"34\" height=\"34\" />          <span class=\"brand-name\">FixMy<span>RAK</span><small>RAK, together.</small></span>        </a>        <div class=\"picker-heading\"><span class=\"eyebrow\">Help neighbors find the right spot</span><h2 id=\"map-picker-title\">Choose a place on the map</h2></div>        <button class=\"icon-close\" type=\"button\" data-close-picker aria-label=\"Close location picker\">\303\227</button>      </header>      <div class=\"picker-toolbar\">        <form class=\"place-search\" id=\"place-search-form\" role=\"search\">          <span aria-hidden=\"true\">\342\214\225</span>          <label class=\"sr-only\" for=\"place-search\">Search public roads, landmarks, and places</label>          <input id=\"place-search\" type=\"search\" placeholder=\"Search a road, park, landmark\342\200\246\" autocomplete=\"off\" />          <button type=\"submit\">Search</button>        </form>        <div class=\"picker-category\">          <label for=\"picker-category\">What\342\200\231s the issue?</label>          <select id=\"picker-category\">            <option>Roads &amp; sidewalks</option><option>Street lighting</option><option>Cleanliness</option><option>Parks &amp; public spaces</option><option>Water &amp; drainage</option><option>Other</option>          </select>        </div>      </div>      <div class=\"place-results\" id=\"place-results\" role=\"listbox\" aria-label=\"Matching places\" hidden></div>      <div class=\"picker-map-wrap\">        <div id=\"picker-map\" role=\"application\" aria-label=\"Large interactive map. Pan and zoom, then click to select an approximate public location.\"></div>        <div class=\"picker-map-hint\"><span class=\"map-live-dot\"></span><span id=\"picker-map-hint\">Pan or zoom to find the place, then tap to drop a pin.</span></div>        <button class=\"button button-outline picker-recenter\" id=\"picker-recenter\" type=\"button\">\342\214\226 Ras Al Khaimah</button>      </div>      <footer class=\"picker-footer\">        <div class=\"picker-selection\" id=\"picker-selection\" aria-live=\"polite\"><span>\342\214\226</span><div><strong>No place selected yet</strong><small>Choose a road or public place. Exact coordinates aren\342\200\231t shared or stored.</small></div></div>        <div class=\"picker-actions\"><button class=\"button button-outline\" type=\"button\" data-close-picker>Cancel</button><button class=\"button button-dark\" id=\"confirm-location\" type=\"button\" disabled>Use this place \342\206\222</button></div>      </footer>      <p class=\"picker-privacy\">Map \302\251 OpenStreetMap contributors \302\267 Searching public places uses OpenStreetMap. Your exact pin is rounded before this demo saves it.</p>    </dialog>    <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div>    <script>      if (\"serviceWorker\" in navigator) {        window.addEventListener(\"load\", () => navigator.serviceWorker.register(\"./service-worker.js\").catch((error) => console.error(\"FixMyRAK offline support could not be enabled.\", error)));      }    </script>  </body></html>"
    }
