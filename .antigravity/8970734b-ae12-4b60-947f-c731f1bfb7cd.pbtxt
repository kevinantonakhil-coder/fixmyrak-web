ange={(e) => setAdminStatus(e.target.value as ReportStatus)}\n                      className=\"w-full p-2.5 text-xs border border-[#e4e9e1] rounded-xl bg-[#f6f7f3] focus:border-[#143d35] focus:outline-hidden font-medium\"\n                    >\n                      <option value=\"Submitted\">Submitted</option>\n                      <option value=\"Under Review\">Under Review</option>\n                      <option value=\"In Progress\">In Progress</option>\n                      <option value=\"Resolved\">Resolved</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-bold text-[#1c302c] mb-1\">\n                      Administrative Note (Visible to citizen)\n                    </label>\n                    <textarea\n                      rows={2}\n                      value={adminMessage}\n                      onChange={(e) => setAdminMessage(e.target.value)}\n                      placeholder=\"e.g. Field inspection team dispatched to site. Work scheduled for tomorrow morning.\"\n                      className=\"w-full p-2.5 text-xs border border-[#e4e9e1] rounded-xl bg-[#f6f7f3] focus:border-[#143d35] focus:outline-hidden\"\n                    />\n                  </div>\n\n                  <button\n                    type=\"submit\"\n                    disabled={isSubmittingAdminUpdate}\n                    className=\"w-full py-2.5 rounded-full text-xs font-bold text-white bg-[#143d35] hover:bg-[#205347] shadow-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer\"\n                  >\n                    {isSubmittingAdminUpdate ? (\n                      <RefreshCw className=\"w-3.5 h-3.5 animate-spin\" />\n                    ) : (\n                      <Check className=\"w-3.5 h-3.5\" />\n                    )}\n                    Apply Status Change & Notify Citizen\n                  </button>\n                </form>\