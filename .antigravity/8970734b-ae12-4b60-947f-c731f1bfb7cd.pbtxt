  planner_response {
    thinking: "**Constructing the Dashboard**\n\nI\'m now focusing on building the `AdminDashboardPage.tsx` file, specifically the overview and analytics section. I need to display key metrics like total reports, new reports, reports under review, in progress, and resolved ones. A category breakdown and real-time Firestore integration for data are also essential. I am working on how to display a report management table in the second stage.\n\n\n"
    tool_calls {
      id: "call_22950"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport {\\n  Report,\\n  ReportCategory,\\n  ReportStatus,\\n  UserFeedback,\\n  AISummarizeResult,\\n} from \'../types\';\\nimport { reportService } from \'../services/reportService\';\\nimport { aiService } from \'../services/aiService\';\\nimport {\\n  Shield,\\n  Search,\\n  Filter,\\n  CheckCircle,\\n  Clock,\\n  AlertTriangle,\\n  Sparkles,\\n  Flag,\\n  MessageSquare,\\n  BarChart3,\\n  RefreshCw,\\n  ExternalLink,\\n  ChevronDown,\\n  Star,\\n  Check,\\n} from \'lucide-react\';\\n\\ninterface AdminDashboardPageProps {\\n  reports: Report[];\\n  onSelectReport: (report: Report) => void;\\n  openAuthModal: () => void;\\n}\\n\\nexport const AdminDashboardPage: React.FC<AdminDashboardPageProps> = ({\\n  reports,\\n  onSelectReport,\\n  openAuthModal,\\n}) => {\\n  const { user, isAdmin } = useAuth();\\n  const [activeTab, setActiveTab] = useState<\'reports\' | \'analytics\' | \'feedback\'>(\'reports\');\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n  const [filterCategory, setFilterCategory] = useState<ReportCategory | \'all\'>(\'all\');\\n  const [filterStatus, setFilterStatus] = useState<ReportStatus | \'all\'>(\'all\');\\n\\n  // Status Update Modal inside Admin\\n  const [editingReport, setEditingReport] = useState<Report | null>(null);\\n  const [newStatus, setNewStatus] = useState<ReportStatus>(\'Under Review\');\\n  const [updateMessage, setUpdateMessage] = useState(\'\');\\n  const [isUpdatingStatus, setIsUpdatingStatus] = useState(false);\\n\\n  // AI Summarization\\n  const [aiSummaries, setAiSummaries] = useState<Record<string, AISummarizeResult>>({});\\n  const [loadingAiId, setLoadingAiId] = useState<string | null>(null);\\n\\n  // Feedback list\\n  const [feedbackList, setFeedbackList] = useState<UserFeedback[]>([]);\\n  const [loadingFeedback, setLoadingFeedback] = useState(false);\\n\\n  useEffect(() => {\\n    if (activeTab === \'feedback\') {\\n      setLoadingFeedback(true);\\n      reportService\\n        .fetchAllFeedback()\\n        .then((res) => setFeedbackList(res))\\n        .catch((err) => console.warn(err))\\n        .finally(() => setLoadingFeedback(false));\\n    }\\n  }, [activeTab]);\\n\\n  if (!user || !isAdmin) {\\n    return (\\n      <div className=\\\"max-w-md mx-auto my-16 px-4 text-center space-y-4\\\">\\n        <div className=\\\"w-16 h-16 bg-purple-100 text-purple-700 rounded-full flex items-center justify-center mx-auto\\\">\\n          <Shield className=\\\"w-8 h-8\\\" />\\n        </div>\\n        <h2 className=\\\"text-2xl font-black text-slate-900\\\">Admin Authentication Required</h2>\\n        <p className=\\\"text-xs text-slate-500\\\">\\n          This administration console is restricted to authorized municipal coordinators and platform administrators.\\n        </p>\\n        {!user ? (\\n          <button\\n            onClick={openAuthModal}\\n            className=\\\"px-6 py-3 bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs rounded-xl shadow-sm transition-all cursor-pointer\\\"\\n          >\\n            Sign In with Admin Account\\n          </button>\\n        ) : (\\n          <p className=\\\"text-xs text-red-600 font-semibold bg-red-50 p-3 rounded-xl border border-red-200\\\">\\n            Current account ({user.email}) does not hold administrator privileges.\\n          </p>\\n        )}\\n      </div>\\n    );\\n  }\\n\\n  // Filtered reports for admin table\\n  const filteredReports = reports.filter((r) => {\\n    if (filterCategory !== \'all\' && r.category !== filterCategory) return false;\\n    if (filterStatus !== \'all\' && r.status !== filterStatus) return false;\\n    if (searchQuery.trim()) {\\n      const q = searchQuery.toLowerCase();\\n      return (\\n        r.title.toLowerCase().includes(q) ||\\n        r.location.toLowerCase().includes(q) ||\\n        r.description.toLowerCase().includes(q) ||\\n        (r.authorName && r.authorName.toLowerCase().includes(q))\\n      );\\n    }\\n    return true;\\n  });\\n\\n  // Analytics counts\\n  const total = reports.length;\\n  const submittedCount = reports.filter((r) => r.status === \'Submitted\').length;\\n  const underReviewCount = reports.filter((r) => r.status === \'Under Review\').length;\\n  const inProgressCount = reports.filter((r) => r.status === \'In Progress\').length;\\n  const resolvedCount = reports.filter((r) => r.status === \'Resolved\').length;\\n\\n  // Category breakdown\\n  const categoryCounts: Record<string, number> = {};\\n  reports.forEach((r) => {\\n    categoryCounts[r.category] = (categoryCounts[r.category] || 0) + 1;\\n  });\\n\\n  const handleOpenStatusModal = (report: Report) => {\\n    setEditingReport(report);\\n    setNewStatus(report.status);\\n    setUpdateMessage(\'\');\\n  };\\n\\n  const handleSaveStatus = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!editingReport || !user) return;\\n    setIsUpdatingStatus(true);\\n    try {\\n      await reportService.updateReportStatus({\\n        reportId: editingReport.id,\\n        targetUserId: editingReport.userId,\\n        previousStatus: editingReport.status,\\n        newStatus,\\n        message: updateMessage.trim(),\\n        adminId: user.uid,\\n        adminName: user.displayName || user.email || \'Municipal Coordinator\',\\n      });\\n      setEditingReport(null);\\n    } catch (err) {\\n      console.error(\'Update status error:\', err);\\n      alert(\'Failed to update status.\');\\n    } finally {\\n      setIsUpdatingStatus(false);\\n    }\\n  };\\n\\n  const handleToggleVerified = async (report: Report) => {\\n    const nextVal = !report.isVerified;\\n    await reportService.setVerified(report.id, nextVal);\\n  };\\n\\n  const handleToggleFlagged = async (report: Report) => {\\n    const nextVal = !report.flagged;\\n    await reportService.setFlagged(report.id, nextVal);\\n  };\\n\\n  const handleRunAiSummary = async (report: Report) => {\\n    setLoadingAiId(report.id);\\n    try {\\n      const summary = await aiService.summarizeReport(report);\\n      setAiSummaries((prev) => ({ ...prev, [report.id]: summary }));\\n    } catch (err) {\\n      console.error(\'AI summary error:\', err);\\n      alert(\'Failed to generate AI executive summary.\');\\n    } finally {\\n      setLoadingAiId(null);\\n    }\\n  };\\n\\n  const getStatusStyle = (status: ReportStatus) => {\\n    switch (status) {\\n      case \'Submitted\':\\n        return \'bg-amber-100 text-amber-800 border-amber-200\';\\n      case \'Under Review\':\\n        return \'bg-sky-100 text-sky-800 border-sky-200\';\\n      case \'In Progress\':\\n        return \'bg-violet-100 text-violet-800 border-violet-200\';\\n      case \'Resolved\':\\n        return \'bg-emerald-100 text-emerald-800 border-emerald-200\';\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\\\">\\n      {/* Top Banner */}\\n      <div className=\\\"bg-slate-900 text-white p-6 sm:p-8 rounded-3xl shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6\\\">\\n        <div>\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <span className=\\\"p-1.5 bg-purple-500/20 text-purple-300 rounded-lg border border-purple-500/30\\\">\\n              <Shield className=\\\"w-5 h-5 text-purple-400\\\" />\\n            </span>\\n            <span className=\\\"text-xs font-bold text-purple-300 uppercase tracking-widest\\\">\\n              FixMyRAK Coordination Center\\n            </span>\\n          </div>\\n          <h1 className=\\\"text-2xl sm:text-3xl font-black tracking-tight mt-2\\\">\\n            Municipal Administration & AI Triage\\n          </h1>\\n          <p className=\\\"text-xs sm:text-sm text-slate-400 mt-1\\\">\\n            Review community issues, update resolution progression, and dispatch field teams across Ras Al Khaimah.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <span className=\\\"text-xs text-slate-400\\\">Admin Account:</span>\\n          <span className=\\\"text-xs font-mono font-bold text-emerald-400 bg-slate-800 px-3 py-1.5 rounded-xl border border-slate-700\\\">\\n            {user.email}\\n          </span>\\n        </div>\\n      </div>\\n\\n      {/* Tabs */}\\n      <div className=\\\"flex border-b border-slate-200 gap-6\\\">\\n        <button\\n          onClick={() => setActiveTab(\'reports\')}\\n          className={`pb-3 text-xs font-bold border-b-2 transition-all cursor-pointer ${\\n            activeTab === \'reports\'\\n              ? \'border-purple-600 text-purple-700\'\\n              : \'border-transparent text-slate-500 hover:text-slate-900\'\\n          }`}\\n        >\\n          Report Management ({reports.length})\\n        </button>\\n        <button\\n          onClick={() => setActiveTab(\'analytics\')}\\n          className={`pb-3 text-xs font-bold border-b-2 transition-all cursor-pointer ${\\n            activeTab === \'analytics\'\\n              ? \'border-purple-600 text-purple-700\'\\n              : \'border-transparent text-slate-500 hover:text-slate-900\'\\n          }`}\\n        >\\n          Analytics & Trends\\n        </button>\\n        <button\\n          onClick={() => setActiveTab(\'feedback\')}\\n          className={`pb-3 text-xs font-bold border-b-2 transition-all cursor-pointer ${\\n            activeTab === \'feedback\'\\n              ? \'border-purple-600 text-purple-700\'\\n              : \'border-transparent text-slate-500 hover:text-slate-900\'\\n          }`}\\n        >\\n          Community Feedback\\n        </button>\\n      </div>\\n\\n      {/* TAB 1: Report Management Table */}\\n      {activeTab === \'reports\' && (\\n        <div className=\\\"space-y-6\\\">\\n          {/* Filter Bar */}\\n          <div className=\\\"bg-white p-4 rounded-2xl border border-slate-200 flex flex-col md:flex-row items-center gap-3\\\">\\n            <div className=\\\"relative flex-1 w-full\\\">\\n              <Search className=\\\"w-4 h-4 text-slate-400 absolute left-3 top-3\\\" />\\n              <input\\n                type=\\\"text\\\"\\n                value={searchQuery}\\n                onChange={(e) => setSearchQuery(e.target.value)}\\n                placeholder=\\\"Search reports by title, citizen name, area, or description...\\\"\\n                className=\\\"w-full pl-9 pr-3 py-2 text-xs border border-slate-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:outline-hidden\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"w-full md:w-48\\\">\\n              <select\\n                value={filterCategory}\\n                onChange={(e) => setFilterCategory(e.target.value as ReportCategory | \'all\')}\\n                className=\\\"w-full p-2 text-xs border border-slate-200 rounded-xl bg-slate-50 font-medium\\\"\\n              >\\n                <option value=\\\"all\\\">All Categories</option>\\n                <option value=\\\"Roads and Potholes\\\">Roads and Potholes</option>\\n                <option value=\\\"Streetlights\\\">Streetlights</option>\\n                <option value=\\\"Waste Management\\\">Waste Management</option>\\n                <option value=\\\"Pavements\\\">Pavements</option>\\n                <option value=\\\"Public Facilities\\\">Public Facilities</option>\\n                <option value=\\\"Other Infrastructure\\\">Other Infrastructure</option>\\n              </select>\\n            </div>\\n\\n            <div className=\\\"w-full md:w-44\\\">\\n              <select\\n                value={filterStatus}\\n                onChange={(e) => setFilterStatus(e.target.value as ReportStatus | \'all\')}\\n                className=\\\"w-full p-2 text-xs border border-slate-200 rounded-xl bg-slate-50 font-medium\\\"\\n              >\\n                <option value=\\\"all\\\">All Statuses</option>\\n                <option value=\\\"Submitted\\\">Submitted</option>\\n                <option value=\\\"Under Review\\\">Under Review</option>\\n                <option value=\\\"In Progress\\\">In Progress</option>\\n                <option value=\\\"Resolved\\\">Resolved</option>\\n              </select>\\n            </div>\\n          </div>\\n\\n          {/* Table */}\\n          <div className=\\\"bg-white rounded-3xl border border-slate-200 overflow-hidden shadow-sm\\\">\\n            <div className=\\\"overflow-x-auto\\\">\\n              <table className=\\\"w-full text-left border-collapse text-xs\\\">\\n                <thead>\\n                  <tr className=\\\"bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider\\\">\\n                    <th className=\\\"py-3.5 px-4\\\">Incident Title & Details</th>\\n                    <th className=\\\"py-3.5 px-4\\\">Category</th>\\n                    <th className=\\\"py-3.5 px-4\\\">Location</th>\\n                    <th className=\\\"py-3.5 px-4\\\">Status</th>\\n                    <th className=\\\"py-3.5 px-4\\\">Triage & Verification</th>\\n                    <th className=\\\"py-3.5 px-4 text-right\\\">Actions</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-slate-100\\\">\\n                  {filteredReports.length === 0 ? (\\n                    <tr>\\n                      <td colSpan={6} className=\\\"py-8 text-center text-slate-400\\\">\\n                        No reports match your filters.\\n                      </td>\\n                    </tr>\\n                  ) : (\\n                    filteredReports.map((report) => (\\n                      <tr key={report.id} className=\\\"hover:bg-slate-50/70 transition-colors\\\">\\n                        {/* Title & Photo */}\\n                        <td className=\\\"py-4 px-4\\\">\\n                          <div className=\\\"flex items-start gap-3\\\">\\n                            {report.imageURL ? (\\n                              <img\\n                                src={report.imageURL}\\n                                alt={report.title}\\n                                className=\\\"w-12 h-12 rounded-xl object-cover shrink-0 cursor-pointer\\\"\\n                                onClick={() => onSelectReport(report)}\\n                              />\\n                            ) : (\\n                              <div className=\\\"w-12 h-12 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center shrink-0\\\">\\n                                <Shield className=\\\"w-5 h-5\\\" />\\n                              </div>\\n                            )}\\n                            <div>\\n                              <p\\n                                onClick={() => onSelectReport(report)}\\n                                className=\\\"font-bold text-slate-900 hover:text-purple-700 cursor-pointer\\\"\\n                              >\\n                                {report.title}\\n                              </p>\\n                              <p className=\\\"text-[11px] text-slate-500 mt-0.5 line-clamp-1 max-w-xs\\\">\\n                                {report.description}\\n                              </p>\\n                              <p className=\\\"text-[10px] text-slate-400 mt-1\\\">\\n                                By {report.authorName || \'Citizen\'} &bull;{\' \'}\\n                                {new Date(report.createdAt).toLocaleDateString()}\\n                              </p>\\n                            </div>\\n                          </div>\\n                        </td>\\n\\n                        {/* Category */}\\n                        <td className=\\\"py-4 px-4 font-semibold text-slate-700 whitespace-nowrap\\\">\\n                          {report.category}\\n                        </td>\\n\\n                        {/* Location */}\\n                        <td className=\\\"py-4 px-4 text-slate-600 max-w-xs truncate\\\">\\n                          {report.location}\\n                        </td>\\n\\n                        {/* Status */}\\n                        <td className=\\\"py-4 px-4 whitespace-nowrap\\\">\\n                          <span\\n                            className={`px-2.5 py-1 rounded-full text-[10px] font-bold border ${getStatusStyle(\\n                              report.status\\n                            )}`}\\n                          >\\n                            {report.status}\\n                          </span>\\n                        </td>\\n\\n                        {/* Triage / AI */}\\n                        <td className=\\\"py-4 px-4 whitespace-nowrap\\\">\\n                          <div className=\\\"flex items-center gap-1.5\\\">\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleRunAiSummary(report)}\\n                              disabled={loadingAiId === report.id}\\n                              className=\\\"px-2 py-1 text-[10px] font-bold bg-purple-50 text-purple-700 hover:bg-purple-100 rounded-md border border-purple-200 transition-colors flex items-center gap-1\\\"\\n                              title=\\\"Generate AI summary\\\"\\n                            >\\n                              {loadingAiId === report.id ? (\\n                                <RefreshCw className=\\\"w-3 h-3 animate-spin\\\" />\\n                              ) : (\\n                                <Sparkles className=\\\"w-3 h-3 text-purple-600\\\" />\\n                              )}\\n                              AI Triage\\n                            </button>\\n\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleToggleVerified(report)}\\n                              className={`p-1 rounded-md transition-colors ${\\n                                report.isVerified\\n                                  ? \'text-sky-600 bg-sky-50\'\\n                                  : \'text-slate-300 hover:text-slate-500\'\\n                              }`}\\n                              title={report.isVerified ? \'Marked as verified\' : \'Mark as verified\'}\\n                            >\\n                              <CheckCircle className=\\\"w-4 h-4\\\" />\\n                            </button>\\n\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={() => handleToggleFlagged(report)}\\n                              className={`p-1 rounded-md transition-colors ${\\n                                report.flagged\\n                                  ? \'text-rose-600 bg-rose-50\'\\n                                  : \'text-slate-300 hover:text-slate-500\'\\n                              }`}\\n                              title={report.flagged ? \'Flagged submission\' : \'Flag submission\'}\\n                            >\\n                              <Flag className=\\\"w-4 h-4\\\" />\\n                            </button>\\n                          </div>\\n\\n                          {aiSummaries[report.id] && (\\n                            <div className=\\\"mt-1 text-[10px] text-purple-900 bg-purple-50 p-1.5 rounded-md border border-purple-200 max-w-xs whitespace-normal\\\">\\n                              <strong>Urgency:</strong> {aiSummaries[report.id].urgencyLevel} &bull;{\' \'}\\n                              {aiSummaries[report.id].suggestedAction}\\n                            </div>\\n                          )}\\n                        </td>\\n\\n                        {/* Actions */}\\n                        <td className=\\\"py-4 px-4 text-right whitespace-nowrap\\\">\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => handleOpenStatusModal(report)}\\n                            className=\\\"px-3 py-1.5 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl shadow-xs transition-colors cursor-pointer\\\"\\n                          >\\n                            Update Status\\n                          </button>\\n                        </td>\\n                      </tr>\\n                    ))\\n                  )}\\n                </tbody>\\n              </table>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 2: Analytics & Trends */}\\n      {activeTab === \'analytics\' && (\\n        <div className=\\\"space-y-6\\\">\\n          <div className=\\\"grid grid-cols-2 md:grid-cols-4 gap-4\\\">\\n            <div className=\\\"bg-white p-6 rounded-3xl border border-slate-200\\\">\\n              <p className=\\\"text-xs font-bold text-slate-400 uppercase tracking-wider\\\">\\n                Total Submissions\\n              </p>\\n              <p className=\\\"text-3xl font-black text-slate-900 mt-2\\\">{total}</p>\\n            </div>\\n            <div className=\\\"bg-white p-6 rounded-3xl border border-slate-200\\\">\\n              <p className=\\\"text-xs font-bold text-amber-600 uppercase tracking-wider\\\">\\n                Submitted\\n              </p>\\n              <p className=\\\"text-3xl font-black text-amber-900 mt-2\\\">{submittedCount}</p>\\n            </div>\\n            <div className=\\\"bg-white p-6 rounded-3xl border border-slate-200\\\">\\n              <p className=\\\"text-xs font-bold text-violet-600 uppercase tracking-wider\\\">\\n                In Progress\\n              </p>\\n              <p className=\\\"text-3xl font-black text-violet-900 mt-2\\\">{inProgressCount}</p>\\n            </div>\\n            <div className=\\\"bg-white p-6 rounded-3xl border border-slate-200\\\">\\n              <p className=\\\"text-xs font-bold text-emerald-600 uppercase tracking-wider\\\">\\n                Resolved\\n              </p>\\n              <p className=\\\"text-3xl font-black text-emerald-900 mt-2\\\">{resolvedCount}</p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"bg-white p-6 rounded-3xl border border-slate-200 space-y-4\\\">\\n            <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n              Category Distribution in Ras Al Khaimah\\n            </h3>\\n            <div className=\\\"space-y-3\\\">\\n              {Object.entries(categoryCounts).map(([cat, count]) => {\\n                const pct = total > 0 ? Math.round((count / total) * 100) : 0;\\n                return (\\n                  <div key={cat} className=\\\"space-y-1\\\">\\n                    <div className=\\\"flex items-center justify-between text-xs font-bold text-slate-700\\\">\\n                      <span>{cat}</span>\\n                      <span>\\n                        {count} ({pct}%)\\n                      </span>\\n                    </div>\\n                    <div className=\\\"w-full bg-slate-100 rounded-full h-2.5 overflow-hidden\\\">\\n                      <div\\n                        className=\\\"bg-emerald-600 h-2.5 rounded-full\\\"\\n                        style={{ width: `${pct}%` }}\\n                      />\\n                    </div>\\n                  </div>\\n                );\\n              })}\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* TAB 3: Community Feedback */}\\n      {activeTab === \'feedback\' && (\\n        <div className=\\\"bg-white rounded-3xl border border-slate-200 p-6 space-y-4\\\">\\n          <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n            Citizen Platform Feedback\\n          </h3>\\n          {loadingFeedback ? (\\n            <div className=\\\"py-12 text-center text-xs text-slate-400\\\">Loading feedback...</div>\\n          ) : feedbackList.length === 0 ? (\\n            <div className=\\\"py-12 text-center text-xs text-slate-400\\\">\\n              No platform feedback submitted yet.\\n            </div>\\n          ) : (\\n            <div className=\\\"divide-y divide-slate-100\\\">\\n              {feedbackList.map((fb) => (\\n                <div key={fb.id} className=\\\"py-4 space-y-1.5\\\">\\n                  <div className=\\\"flex items-center justify-between\\\">\\n                    <span className=\\\"font-bold text-xs text-slate-900\\\">\\n                      {fb.userName || \'Anonymous Citizen\'}\\n                    </span>\\n                    <div className=\\\"flex items-center gap-1 text-amber-500\\\">\\n                      {[...Array(5)].map((_, i) => (\\n                        <Star\\n                          key={i}\\n                          className={`w-3.5 h-3.5 ${\\n                            i < fb.rating ? \'fill-amber-400 text-amber-400\' : \'text-slate-200\'\\n                          }`}\\n                        />\\n                      ))}\\n                    </div>\\n                  </div>\\n                  <p className=\\\"text-xs text-slate-700\\\">{fb.message}</p>\\n                  <p className=\\\"text-[10px] text-slate-400\\\">\\n                    {fb.category || \'General\'} &bull;{\' \'}\\n                    {new Date(fb.createdAt).toLocaleDateString()}\\n                  </p>\\n                </div>\\n              ))}\\n            </div>\\n          )}\\n        </div>\\n      )}\\n\\n      {/* Administrative Status Update Modal */}\\n      {editingReport && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs animate-in fade-in\\\">\\n          <div className=\\\"bg-white rounded-3xl max-w-md w-full p-6 border border-slate-200 shadow-2xl space-y-4\\\">\\n            <h3 className=\\\"text-base font-black text-slate-900\\\">\\n              Update Report Status\\n            </h3>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Modifying status for: <strong className=\\\"text-slate-800\\\">{editingReport.title}</strong>\\n            </p>\\n\\n            <form onSubmit={handleSaveStatus} className=\\\"space-y-4\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-bold text-slate-700 mb-1\\\">\\n                  New Status\\n                </label>\\n                <select\\n                  value={newStatus}\\n                  onChange={(e) => setNewStatus(e.target.value as ReportStatus)}\\n                  className=\\\"w-full p-2.5 text-xs border border-slate-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:outline-hidden font-medium\\\"\\n                >\\n                  <option value=\\\"Submitted\\\">Submitted</option>\\n                  <option value=\\\"Under Review\\\">Under Review</option>\\n                  <option value=\\\"In Progress\\\">In Progress</option>\\n                  <option value=\\\"Resolved\\\">Resolved</option>\\n                </select>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-bold text-slate-700 mb-1\\\">\\n                  Status Message (Notifies citizen)\\n                </label>\\n                <textarea\\n                  rows={3}\\n                  value={updateMessage}\\n                  onChange={(e) => setUpdateMessage(e.target.value)}\\n                  placeholder=\\\"e.g. Municipal asphalt crew has completed resurfacing. Inspection verified.\\\"\\n                  className=\\\"w-full p-2.5 text-xs border border-slate-200 rounded-xl focus:ring-2 focus:ring-purple-500 focus:outline-hidden\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-end gap-2 pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setEditingReport(null)}\\n                  className=\\\"px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition-colors\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={isUpdatingStatus}\\n                  className=\\\"px-5 py-2 text-xs font-bold text-white bg-purple-600 hover:bg-purple-700 rounded-xl shadow-xs transition-colors flex items-center gap-1.5\\\"\\n                >\\n                  {isUpdatingStatus ? (\\n                    <RefreshCw className=\\\"w-3.5 h-3.5 animate-spin\\\" />\\n                  ) : (\\n                    <Check className=\\\"w-3.5 h-3.5\\\" />\\n                  )}\\n                  Save & Notify Citizen\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create AdminDashboardPage with report triage table, status updater, AI Triage executive summaries, and feedback tab\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/AdminDashboardPage.tsx\", \"toolAction\":\"Creating AdminDashboardPage\", \"toolSummary\":\"Create src/pages/AdminDashboardPage.tsx\"}"
      thinking_signature: "\022\262\t\n\257\t\001i\024}\023\204\033D\252%\a|\356,D\253\374\037o\302\233r\220\td\\\264\177\'\251\213\356\300\317\223\033\203\347\333\256\246I\246\226\224:\031%[^2\177\375\326\262}\365f\201x\364BW\"\326f\301\212\276Q\374\300\250~\364\315\374\322\353F\330\250>\2624m#V\020\234\305\342mm[\304?XU\021\354\362\356\367\351\002D\r\240\333A\340\034A\r\231\270W\254J\300\001l\030\212\\^s\364\023\265oY\202\031\263@\033T\tx\314\rf\366\305\210\337\027\306\217\225\205\273\241zNYBc\302\'\021G\325\350~n\023Sn\214\307\320\323\245\364\227\266\336\316?Ym\252l;\262\354\242G\344\354@i\035O\367\361\035\256\3379\333m}\202\356\207\265\227>^\235a\315_S\3177\234moSR\036(\346P\304`\006h`\320\340\323W\351\237\251\216s\331H\003\322\032\234\236\233\022d*>\027\334\032\320$2\374\250\314\207\341\355\221\002M\265\3172Dp\021;\376\337\351\211\234U\365\346\372A\352m7\fD\366\343+V\034\252r\331\315:\304\264Z\3557-\222\315\345\227\f\"\341-\202\215%\343\035o\030%\246\323\375\345\360\242\251\331\001\304eV\325\335\265\303\371\251Z\"L\347\037$\245\020s\201={\330\223\215\020{\306\313\345\'\f+,\365\211\262a\267\3421\3362\353\262\337Or.\026-\006\235\351\302\243\334\023\334{z\322\223qw\352\222\367\367H\027\225\206]\361\216N\226\220\273\237\220Y\2632\206\217\300\250\245\245\205\v\247a\031K\326\2669-\222o[\211\031\332.@\213\244\231g\357\313\301Z\374\356vw\216\037\177\202\364\005c\261\017Lo\236j\373\365D\f\n\351\354\233;\356\3622\300\245\371\2762\343\v\025p<+Sj\224/\236\302\343\356q\200\306\251\366\2035Ecy\242w\361W\352\324\322h\204m\231\020(Ga\177\022eL\222p\357\0068D\035\362\324\212\351\372\034\210\"\210<\002jS[\223\312\005\030D\024\016!\036\262< \360\253r\323\224\367y\220\337\371\270U{Dz>s\027\032\262}\341m\233}\b\377\f\343}\367\235\231^\241\344I\215\376\340 >\324N+(?N\301|W\276\307\250\266CH2\332\213\034\373\341\235~\374X\016\371v\033\217\311\367h\t=\260[\026n<\276\227\2274\030\3708\260\267%l\271\247\354\332k!\354\205\205\324\277\000\'\301\340\352\201\031\240\005\215\211\376\004\353T\225]\f\a\254\356AN\331B`VwZ\335\237\244\326q\340\210A\327+\204f\344\365]\345\274\026\210\t\033G\237R`#%\2550\037\251\354\265.\332O\305\247mc\302\031\237\354\000\217,Z\243\033\272\343?\277_\227\f\255\000\220a+\311Vt\231\2447\335\253\235\223\332\2251\025\225F\270\215K#g\006\r\037\030\205\233/\351R\244*\340\273\300h- \355\tVR\344\215\343\304\225\037\247\000p\277\177%\264\022>\200\307\017\274N\303G\240\n1a\002JU\331\373\337A8\227\"\\@\345\254G\tf\235\237JD\340r\2211`\020zO\216\332\355\370I\027\215\206\221\307\271\347\306\232]\240{k\3719i\376<\017|\235\025\217I\342\304\024_b^\237t\034\2373\375}v\220%\364\373\345H-h[(\037\206\255 \233\270\t\243Do\033TcT\346g\000/\022\020\352\265\3575\266\273ZAT\341J\363\020Yq\226\243c}Y\341\353j\363?o\v\320\320RI?|\331\032rv]\226;bCH\315H\016\215\1770\236IF\334\324\365\032\367<\021m\330\313\316]\274~\2100\n\231\263\223\223\313\200\320\004\200\311dRY\276+r\243\037\026\255*\313\312\276\004\337\345\211\036II\357\005\034\032\325U)\275\n\326\260\003\260\3313\371.\304\270\212\b\032 ^R!\345\nM\303\225\2718\332\266\377\272\312lh0\003#\250~\004\220\310_\362\000\234\314\205\032J\365\353* \211\217\037\205\231U\352\3279\347TM\026\367,\263\037\027\206\315\352\363bRdS\224\223E\244\355\256\261\221\316\034\n\304\0002?):\n\300\370\311X\000\3571J\234\022\2733\322q\027\3210J\356\217\254Z\2420K\311\\\267L\212~\246\201\325\260\3144\236us;p\320M\245\323F\027\251\300\\\220\247\023\311{\311\360\375>\222BxP\227\251v\3378i\270"
