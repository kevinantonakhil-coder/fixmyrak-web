  view_file {
    absolute_path_uri: "file:///src/pages/MapPage.tsx"
    end_line: 119
    content: "import React, { useState, useMemo } from \'react\';\nimport { Report, ReportCategory, ReportStatus, RAK_PRESET_LOCATIONS } from \'../types\';\nimport { MapComponent } from \'../components/MapComponent\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport {\n  MapPin,\n  Filter,\n  Layers,\n  ChevronRight,\n  Eye,\n  Calendar,\n  Clock,\n  Compass,\n  Sparkles,\n  Building,\n  User,\n  PlusCircle,\n  Recycle,\n  Zap,\n  Droplets,\n  Leaf,\n  Tag,\n} from \'lucide-react\';\n\ninterface MapPageProps {\n  reports: Report[];\n  onSelectReport: (report: Report) => void;\n  setCurrentTab: (tab: string) => void;\n}\n\nexport const MapPage: React.FC<MapPageProps> = ({\n  reports,\n  onSelectReport,\n  setCurrentTab,\n}) => {\n  const { t } = useLanguage();\n  const [selectedCategory, setSelectedCategory] = useState<ReportCategory | \'all\'>(\'all\');\n  const [selectedStatus, setSelectedStatus] = useState<ReportStatus | \'all\'>(\'all\');\n  const [activeReport, setActiveReport] = useState<Report | null>(null);\n\n  const categories: (ReportCategory | \'all\')[] = [\n    \'all\',\n    \'Water Saving\',\n    \'Electricity Saving\',\n    \'Recycling\',\n    \'Greener Living\',\n    \'Roads and Potholes\',\n    \'Streetlights\',\n    \'Pavements\',\n    \'Public Facilities\',\n    \'Other Infrastructure\',\n  ];\n\n  const statuses: (ReportStatus | \'all\')[] = [\n    \'all\',\n    \'Submitted\',\n    \'Under Review\',\n    \'In Progress\',\n    \'Resolved\',\n  ];\n\n  // Filter reports with valid coordinates\n  const filteredReports = useMemo(() => {\n    return reports.filter((r) => {\n      if (!r.latitude || !r.longitude) return false;\n      if (selectedCategory !== \'all\' && r.category !== selectedCategory) return false;\n      if (selectedStatus !== \'all\' && r.status !== selectedStatus) return false;\n      return true;\n    });\n  }, [reports, selectedCategory, selectedStatus]);\n\n  const handleMarkerClick = (report: Report) => {\n    setActiveReport(report);\n  };\n\n  const getStatusColor = (status: ReportStatus) => {\n    switch (status) {\n      case \'Submitted\':\n        return \'bg-amber-500\';\n      case \'Under Review\':\n        return \'bg-sky-500\';\n      case \'In Progress\':\n        return \'bg-violet-500\';\n      case \'Resolved\':\n        return \'bg-emerald-500\';\n    }\n  };\n\n  const getCategoryLabel = (cat: ReportCategory | \'all\') => {\n    if (cat === \'all\') return t(\'cat.all\');\n    return t(`cat.${cat}`);\n  };\n\n  const getStatusLabel = (st: ReportStatus | \'all\') => {\n    if (st === \'all\') return t(\'status.all\');\n    return t(`status.${st}`);\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6 bg-[#f6f7f3]\">\n      {/* Title Bar */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n        <div>\n          <span className=\"text-[10px] font-bold text-[#819087] uppercase tracking-widest block mb-1\">\n            {t(\'map.badge\')}\n          </span>\n          <h1 className=\"text-3xl font-extrabold text-[#143d35] font-manrope tracking-tight mt-1\">\n            {t(\'map.title\')}\n          </h1>\n          <p className=\"text-[#74817b] text-xs sm:text-sm\">\n            {t(\'map.subtitle\')}\n          </p>\n        </div>\n\n        <button\n          onClick={() => setCurrentTab(\'report\')}\n          className=\"px-5 py-2.5 rounded-xl bg-[#143d35] hover:bg-[#205347] text-white font-bold text-xs shadow-sm self-start sm:self-auto transition-all cursor-pointer flex items-center gap-2\"\n        >\n          <PlusCircle className=\"w-4 h-4 text-[#d7edbd]\" />\n          <span>{t(\'nav.reportIssue\')}</span>"
    num_lines: 318
    num_bytes: 12234
    line_range_bytes: 3500
  }
}
