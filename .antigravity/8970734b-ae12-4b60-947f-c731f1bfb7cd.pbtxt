    content: "      setAiTriage(summary);\n    } catch (err) {\n      console.error(\'AI Triage error:\', err);\n    } finally {\n      setLoadingAiTriage(false);\n    }\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-slate-900/60 backdrop-blur-xs overflow-y-auto animate-in fade-in\">\n      <div className=\"relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden my-auto max-h-[92vh] flex flex-col\">\n        {/* Header Bar */}\n        <div className=\"px-6 py-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between shrink-0\">\n          <div className=\"flex items-center gap-2.5\">\n            <span\n              className={`px-3 py-1 rounded-full text-xs font-bold border flex items-center gap-1.5 ${statusConfig.bg}`}\n            >\n              <span className={`w-2 h-2 rounded-full ${statusConfig.dot}`} />\n              {statusConfig.label}\n            </span>\n            <span className=\"text-xs font-semibold px-2.5 py-1 bg-slate-200/80 text-slate-700 rounded-lg\">\n              {report.category}\n            </span>\n            {report.isVerified && (\n              <span className=\"text-[10px] font-bold text-sky-700 bg-sky-50 border border-sky-200 px-2 py-0.5 rounded-md flex items-center gap-1\">\n                <CheckCircle className=\"w-3 h-3\" />\n                Verified\n              </span>\n            )}\n          </div>\n\n          <div className=\"flex items-center gap-1\">\n            <button\n              onClick={handleCopyLink}\n              title=\"Copy link\"\n              className=\"p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-200 rounded-full transition-colors\"\n            >\n              {copied ? <Check className=\"w-4 h-4 text-emerald-600\" /> : <Share2 className=\"w-4 h-4\" />}\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-200 rounded-full transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Content Body */}\n        <div className=\"p-6 overflow-y-auto space-y-5\">\n          {/* Title & Metadata */}\n          <div>\n            <h2 className=\"text-xl sm:text-2xl font-black text-slate-900 leading-snug\">\n              {report.title}\n            </h2>\n            <div className=\"mt-2 flex flex-wrap items-center gap-y-1 gap-x-4 text-xs text-slate-500\">\n              <span className=\"flex items-center gap-1 text-emerald-700 font-medium\">\n                <MapPin className=\"w-3.5 h-3.5\" />\n                {report.location}\n              </span>\n              <span className=\"flex items-center gap-1\">\n                <Calendar className=\"w-3.5 h-3.5\" />\n                {new Date(report.createdAt).toLocaleDateString(\'en-AE\', {\n                  day: \'numeric\',\n                  month: \'short\',\n                  year: \'numeric\',\n                })}\n              </span>\n              {report.authorName && (\n                <span className=\"flex items-center gap-1\">\n                  <User className=\"w-3.5 h-3.5\" />\n                  {report.authorName}\n                </span>\n              )}\n            </div>\n          </div>\n\n          {/* Photograph if available */}\n          {report.imageURL && (\n            <div className=\"rounded-2xl overflow-hidden border border-slate-200 bg-slate-100 max-h-72 flex items-center justify-center\">\n              <img\n                src={report.imageURL}\n                alt={report.title}\n                className=\"w-full h-full object-cover max-h-72 hover:scale-102 transition-transform duration-300\"\n              />\n            </div>\n          )}\n\n          {/* Description */}\n          <div className=\"bg-slate-50/80 p-4 rounded-2xl border border-slate-200/80\">\n            <h4 className=\"text-xs font-bold uppercase tracking-wider text-slate-500 mb-1.5\">\n              Issue Details & Context\n            </h4>\n            <p className=\"text-sm text-slate-800 whitespace-pre-line leading-relaxed\">\n              {report.description}\n            </p>\n          </div>\n\n          {/* AI Summary Banner */}\n          {report.aiSummary && (\n            <div className=\"p-3.5 bg-sky-50/70 border border-sky-200 rounded-2xl flex items-start gap-3 text-xs text-sky-900\">"
