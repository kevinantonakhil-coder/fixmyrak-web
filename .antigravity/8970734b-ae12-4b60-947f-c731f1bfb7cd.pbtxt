      thinking_signature: "\022\227\v\n\224\v\001i\024}\023\\+@\306\340@\313\322\302\230t\305\356\316\342\225J\366m9\033\266\324\025Y\323\244(\356\274\031\352\n\251\347\204\a\227\236S\211\262\001\327\316\217Y\204\220\\5\310W\222\0365\346\022#\35494\276[\310\024\373Ic\n5\303\311\214\205\251~\326\321W^x\216\016\262\242\367\246\314Z\355\313\224\227\323Ye\317`\2128\\\017&\2000\323\223\316\243 \366\316Ct\032\364\216\017<\243\372b\270F\331\332\034+\376\333\207\037\031\017\350~H\312\035\354<\t\313\357L\337\213\022\355\316\033\037E\311f\262\240\325I2-\255^]j\264}\031\035\037cF\227\324b\300\221R\347h\002l.\242\333\341\223\302\225\330\362\254D\362\306\260\260\t\273\360\346\251\221_\223\t\244iG\210\324\036\032\016\v~)\033\267\262-V\314\036\245\027\303\035\340K\020\003\334_>\324H\203\025\337\231R3yL\243\270A\243\217\322\240\357\274v\253\bo\205\271\027\263I\214\315\274\"\352\242\032;\v\3426-Y\374>\300[\276i}*\323\207\203N\371Y\203\226 \252\247\316S\216\355\323\333W\177\262\257rD\017\205\256\353\335\275\371\261\374Q\303\375\266\006E\2564;xL\364\203(T\241,G*Y\250\213M\271\200\303Z\021\377k\306\375\340\231\025\024J\272\272e\277\215\327\034Q1]z\253\350\220\364_\327J\247\025I\312\023\276K#\351/\276\207\266\235T\264\341<\236\373{!}|\266F\247\235v|x\236\016a\b\254\356R\340^4^\3326\boJ\341\357Q\376\355\217n\322\036;`\200>\245!\033\rV~>J\325\264H\026\306\277\312qAJ\025\356Y\022\316i\304\213\021\336\202\376\005\345\t\201\001\212\037{S\024\322\021K&\225d\306\303\366V\334\000\351<]6\320X9t\227\306\203G\251\fsEI\252b+TW\353\003\305\363\240GX\rB!\222\303\240i\002\\\260\370\261\2222OA\225\213\005\356z\327\241SNa5G!k\314\"p\347$\341\364\3535\022\220\242\316\324c\346UmM\002\260\312\360\2270\212v\203\005\201\027^\335\226&\226\343\303B\021a\241~\r|\006]\223\002\317\343\b\a!>\354\311E\233\257\365\241C\323\352\244e)\371\030\244\362\034\350\201 \005%\374\272A\354V\230D\"\307\267\021\232M\314f=\2065y!\',-\230\232\311\221$&\217\022\311{U\023iO\353\205\020b\237\336\263V\017\213uj\220\361\316g\360pg0\303\342\340\b\307\335\250/Y\215\345\3609j\365N\001e\246\257:\f\264`$)\340 \005$\224\026\23091s\246\235\363B\311\377\037\365\365\031\310\256pD\004\243\221\307\\\322\233&\000\026\201\301*6\306\252{\202\205B&D\256Gx\177=\354\332D\377a\247\\\373\356\312\025-\226\320>\262\210\362G\343\347\t\a\221\236oS~9\b_\bJ]\303O\246\302\a\034*;\207\240\310\375\025\323n\211F\003exm+J\374\357p@C\335~\034\251\001k\033^+\372\213\343\263S~\030\215\366\360;tK\r\026>\366\313;m\\\235\357\t\230\322@\210Z\204\250\360\027\323%fu\227\246Z\220_\031\272\274\206\231\320M\230\303\243\261\035RI\322\034U\260\001F\374\334\352p\360\271\rq\263\205\324\312\352Q\324\270\b\241Z.\2232\350\3036K\033F\2646L:;\\z\366C7\277\030\343\274\206\346\307\216\276x\234*_Q-\372\274;\251~QQ\244\325\233\n\024\030\335ue\300\326\r\207\266o\363V$gg\2433m\002an9&\373\n_\003\227\006\222\367\366-\240~\365\005\f\316E^W\024\263\002\200\270\026\252\322Z|\322\315\225\221ldW\341\217\251\205\332\2377\227]\240Y\327\251\361&\002K\315\374X\352\211\201\201q\021\244RUm\206L\215\307^$e\217\337\327\203)\315\310|\343\335\240\307\224d\331i\361\320\313v1A\025\020\236{\255&1\037\377\a\225\363\316\250l\351\362\321\343H?\343J\0216\004m.\204\366\322\aO\333\307\212*\306M4\301k\214l\346u\242\371\v6\224\001\336\316\323=\333\347\313 \333\271\374x\275\362\205W!\341Y\032\340\370A\004~\321\255:\037\177\256\n9o\333Q\305T\345k\322\003C8ZQ.\220h\302\376\310\345\214\022\320$\264}&u*\357\304\201\365\334Q\331\320i&_i\365\372z\302\177\364ET\2751\345d(z7\001\260\321\315\240\323Y\265\301B\211\255\342`\263\003\372F\250\031g\256/\005\"\261\254\3555\241\315m\022\240\026O*\243\264k\343~\026\247\3569@5\357\321\377\240\346\235\344\177\306\313\235\032$p\370\006$\021\256\305\2170\231\231\224\366\2711,\246\254\033\237\227\035f\315\035\016g;\222\202\377Z\225\020\351\350bS\274Z\034\370^\377\214\226\274\206^\267*U#o\263\035\323\204C\242V>\335\247\333\230+ \327C\006\217w\355\205\377\311;A\267\b\362L\340d\302\346e\355\325\200o*\036tc\274\003\334\304\203|\211:B\222U\265i\222&\020\310P\022M\247~\201\3656\242F\217\021\r\2234s\350\234\t\360U\376rH\217e\270.\212\365\375\274\024;\210\313\276"
