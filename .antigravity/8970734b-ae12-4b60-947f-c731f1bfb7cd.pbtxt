      thinking_signature: "\022\312\020\n\307\020\001i\024}\023\257\022\3556/\304\030\323k\003\1776\337\002\267\342w)K\240\016x\3139\2626\210\024n\325kZ\276O{\006\031x\227o\\\214\260\206\337V\242\3511\264\334y\202N\201\030\222\376\230\000sy\300\034\001_\027\275/\234 C+nA\312\241;\202C\345%\234\330\247)\333g\334\026w\\\034\200\026$\232m\240Gq\256Hv\243\320/~\230\370\332\242\212\241\312I\325\177S&$\022v\315\\\205\265h\003\325\315\227:\304\260\272\202\321\326@\343\254L\247\260}\370/\031[o\006T\331;4\265\371\272\336\340\360\017\032\276YO\265\307\362}\326\335\373\376\335\243\003\315\020\257\"am\225j~\366T\337\317\356\t\254\317\207\350\355\016\353\305\351U\220\321\177\307\267\351\031\341p\340\3338\323\a\326r#(ZUn\215+\346\b\016\254\211\034\310\361\331?\306\270\300l\b\023\202\364\223\232j\3247Z\202\350qt\033*\245\2127\2613\362v\227\002\373\273\234S\004\001t\'\270\312\n\315\262 \313r\005S\244Qv\257G\272I2\364uj\322\372j\036\323s~\3157\262\325\b\032\224\304\275T\267\355\227\273#\b\"K\016\366\365\310K\306\024\037\315\366\243^\273\356\360\033\301\261q\345\323\272\306\334Q\206\270\001\336\217}[\2537\206\206U\217\031\251\313\372G\nTk\274\365\315Zy\272\374\367x\355\023\307\317\200a\221\315\204\326\301\373Y\203\252_\230d\\\264\371V6\307\271\025\347/H$\301\000.\352\025\240vy;\270I\237B*\312\264\361\006\261-\351]@\253\000\254 u\307\006\177\345\210\263\332c-\344\253\277\201\224\22781\260\\\245\314\321\223E\365\n\300:\323\267\21147*\357\217\206\370\224&\236-\030[I\366\022\177\252\001\005L\234\200\263)\337\273w\364\f$\340\t\355#\265;\324c\367\267U\322]`R:|\347\257\026\00127x\200*\320 \255|\001\377\260-\332\2017}\243\206\366\305\245$\311\254W\264/U\323\254N\241\205vC(\240\252d?\vz\257$\343\366H\212\027\f\367\a\272a\336\327\203\342\306L5?\232[C\003:\v)r\034\021f\n g\236\241\227\233U\225\217[\004hW\177\301\254\315\245\\eh3\342\204L\370\363V\033\031\005.\241\237\203.M-E\250\303\265~+\242@rL%{e\035\315\037Sy<\204\320b\243?*\330\363\216\352C\336\363iobd\325T\264JK\032\005p\261\312\310\227\331\034tc\222\232\250G\213\374\201z>\325\237pb\002\345K\023\331\302\274\330@\331r\334\035h\203\237\271\023\003\3140\022\212\266)\307\214HRqU\177\002^\030\213^\323\353\000\226v\257U\021\357\304\301\354C[\263\322\036s\b\2072\027\365f\006\275\017>\351_f\264\350\314;\347\340NU\321w56lc\306\037I_ \034\363e*<4\226\226&\024f\vr \337\345<\\\036@TN\"f\223\264\\\024\372\210\335\253c\336K\226\213\020\351\3448\357\243\002\000\306\250\177\376\364\351\204\b\361\a\256a\230\305/\023:\262lw\224\276\274\000vz-\206\310\247\365\321gPq\t\215\212\232\275\224\303\224\276\210\231\274\v\275 B=\a?\016\233\252\342\346\357\316\'5\2778\2378o\371\355NBd=\325\210\325\221\332\256\366\250|bU\373U\305\242\200\ve\006\b\371\257\221:D\355y\032\302U\265\256\242_\231\255\317\207^\225\362\037\f\354\242i\223\250\373\vi\r\221\372%\213\272\355&g\335e\373\030\275\a\026\262\360\355)\233\213\252\343\354\'\206\350\332\227\360\360\233\025\tZ\270p\303F\374\277\260\nHz\344\360G,ly\306G\233\332\'\t\005\354\000]|\024?8\254jW\256G\031Yw\252\334\255O\0264\313\315\177\375y\3330/\033\000\274\362\000\216\n\232\n\vM\r\272\345\343\214A\223\364z)\226\246\370\345\004\310\211\206\265\235DF\245\205\220\000\004\337\361\351\205\004\315\360\3211\315\366\375\'$5\272t\005\021\016\246\031=s@;\352\000\367\254\303\234\365\rK\207\000\"\215\026\204:\342\363\b\2723\221]\234\3549\f:$u\027\376\236SY\375\372\3453Fc2\274h(e`,\315\313\352n\216\372\245\005\233\024\235\n\257\231\v\363\2254\364\005\345\241&\267\347!\032\316,=\316m\347s\361~\202\316\224\213\260\316\f \234\225>\300\252x`V\031n~\340\214h\262\000]\030Z\023\f\232W\000\236\200\017\242B\344\244\206I&K\314\325\361i\267D\320\247\343\204\213\307s\316\374\t\303\036pH\334\033\241\200~\372\b\020\225\276\260\341\355\317\037\276\355feb\377\302\245\213#\204\246\200\300\226\350\224U!_[\257%\031,X7\241v2\035\323\025Hup\377\331.\2633r\210\252\357\346#x\275\232\231\3265\237\\\253\221\205\326G\231\215\242C\f\316\275s\3109\350<\r8\211\017\263\300\217\317(\254\004\n\r\214s\'\354\023\t\214l&\261\b\242Ka\2