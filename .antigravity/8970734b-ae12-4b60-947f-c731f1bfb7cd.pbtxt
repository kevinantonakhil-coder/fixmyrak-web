    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
    source_trajectory_step_info {
      trajectory_id: "8970734b-ae12-4b60-947f-c731f1bfb7cd"
      step_index: 1
      cascade_id: "8970734b-ae12-4b60-947f-c731f1bfb7cd"
