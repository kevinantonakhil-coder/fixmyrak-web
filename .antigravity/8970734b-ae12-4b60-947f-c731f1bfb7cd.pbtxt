      thinking_signature: "\022\227\020\n\224\020\001i\024}\023\026\037\2010\334\v\313a\006q\350o\363M\025\212,\nz\nG>\016\037\301\266\307\030Rl\212\250\\\314\272\t|\\\325\342\001\300\214\234\201\322\260\252\342TkI\004,\305\233\241O /\036\267\037\317!\221\3132\325\251\316ka\204\024\341\r\ai\323j\\]f&\310\t\254\307\v\223\t\006\223\021\242\363&\321,n\315g\250l\377\233=\025V\n\315B\204\a\307\271\\QT\201\247`\035#:\263\020\342\371\003\373\022\365\3225g\v\205\n\0041LGkV\365\333\264,\237}Xf\301\020o\346\346\005\004\b\347,z\t\260\213\274\313\304\300\a\242\020\306\244F\217J-\366h\273\244i\006\025\354\311\254\002\205[&[{d\241\340\272h\026\360Q1o\221B\264\217C\025Rw\357huS\017a\226K\035I4~\365vm\341z\2776\357\250GNj\003\016l\206\231\361\251\342\027e;\363\275D\366E\320\024\357\f\245m\021\262\177\006\261\304\213\256|d\227\261\027h\203\n\340\030\337\005\351\017\317;a\211;\027r?\246N\035ELe\250\213E\221\201\006\315?\231[wK\035,\034t\322\301<\224\226\271\311\030g\243\\-\376w\022Dmn=\357\333\0369|\f\323\362\020\237.\344\rv\371\275\277\002\336\002xk@\207\002\274\367\236S\222\3432)N\315-\3130\250b\311\030\261\r-\2577\\\263\3148\353\357p|\225\244\r\224Z1\303aS\241\317\363[D\343\300\206\324\031@XxG\340!\250@?v\304\306\221V\357\034\215\327s(5\305d\372\250\033\247\352\303\261\374\250fTA\"\333\226\321\272wp{\2668\230\272<\207\247&k\325\\\241\353\335\r\027w\036\321\021d`Z\317MZ\003\324\261\270\277Ur\233\336!\245]\r\2473\221=\033zPZ\204\375\330\341\355\022\277\235\000\374 (\262$\322\367\016\205\262\000\bQ\211/r\357\025\363 \v\3266\030\356\201\031\2609\342\307\002\361q\207}\334\024\217\351\342\236w\023\372r\263\202\220\310z,\372\2122\356\333\357\317\035\303\255\205\262rI\230t\000\030\201R\375\227\327g-\216d\301\310J\234\273S4{_\204tkV.\260J\3672v\232\3476{\343\244\3339\277\254\022}/f\301$\263Ru\022\272v\326\177\3205\212\356\307\016\2459S\345\211\361\314j\213+\273;!\333\0206\265\375\262a9\317\213\276tE\247\261|.}\nKtt_\031\264\030w\245\376:B\243\345\367\336\336a7\3619J\316\233>\034\360\224\32