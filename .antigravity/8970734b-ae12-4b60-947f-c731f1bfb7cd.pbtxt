            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          <h3 className=\"font-bold text-slate-900 text-sm\">3. Security & Cloud Firestore</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          <p>"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
