      thinking_signature: "\022\361\n\n\356\n\001i\024}\023\363\305J\2548\275\b\242v\305\334o\330\363vr\255}\334Y\001[\237\017s\037\207\270\305r\356\233\233\027\373^\326*\021x\250\024\240\350\035\317\373\226\372\000&\305Zu\031\312c\203M\375\352}\005X\307\354Z\202t\346\347\204\032dAN+5t\241\224\212\357)\fW\224<U\256|{\002\'\2356O_\001#T_\r\263\266S\243}n\265\020b\001\"\372.U\271\255\361\020Ph3\251c\\k\365\034\034\"\277sK\0229\217\217\216\031u~p.\203S\211&\304\377\277\301\337\025\226v\362\216\003\036*%y[\241\223\177<\204\300_\246\327\235\274\272WEX\337\024+\236\246\025\313\235jdTO\003\035\202\230\313\350\364\365f&\240\373\343Q\2601\270\221\204\322\222\300{\004(\321\315.\n(\343\271\311+\277\355\264p\344\302\376,\347\364:\303\311\200\032\266\305~\261`MS\327\f\364P.f\241C\177\006?n3\242Z\016\313:\206\354\004\0024\350\205\274\365\2678`\347\215\276\v\262\006\316z0\024\340\252\211Z\2757\231\214B5\036\031\023\266\337\335\356\306\216B\210\256\326\023\324\214WN_\235VG\022\224\016c\346\006\024\355\232\274`\23698\365n\3160\t\241\024\331\272\350@\310!H\325V\266\261\353\032\254\264\0021\316\254\260\v\vj\255\250\314\327c\256\025\315b\332\324=\256\202\215\311(\017\225\016L\311\271\326\233\227.\227\202\2114\r\355v\204g&Rg\220\004\342\276\254\250[\206\352\242\264\354L\377)\274\\_R(p\022\202\316\032\210\036\235H\262\003\021\027\335y}\367w\236\240\347!d~\255\370\200\374HgA\363\353`\213F\340M\002#\326w\240\347\273\004\331E\f\235\342\337\302\327\2708\232\355\351m\322\217\305X\340\353/\345@\031\270\032\032E\a\204\220}C\003A\247w\rt]\364Rm\211\211\334\314s\320\b\200\v\235\233O\233e\223\2460\'T\\\005\245)s8q\264\366\"\352\274\204\347|\002\335\343}Y\273\322\002\275\310\262*H\306\2102\315\r!\264\355O\006\357Sv\275\2610a\330\3160\205\324x\334\374\242~\026\240=\302\210\270\257n|\006\032\025\205\326I\267\b&%9v\373%\250\353\362\342D\347\223\272\345\005\244\235\225>K\225>\a!\232m\332\313\314\220\037_\203it\226\356.\364\255.>qd\257\3540\0345Hf\365\227\317m@.\335\240\026\3564=6_\003\261\207\370\311\2