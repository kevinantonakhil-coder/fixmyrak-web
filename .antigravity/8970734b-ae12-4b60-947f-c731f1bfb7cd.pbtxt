      thinking_signature: "\022\371\f\n\366\f\001i\024}\023e(;AA\341\306&\035\005\r\315=\353\342\275\366\323C\371\017\234d\r\322\373\203g\312\273\\\240\235A\336r\033\254t/`Au\277\330\030sXpQ-!\357\001\373nQ\321D#d!t\264\213<v{\v]j\271\2121Y\201p\023i\264|\211u@\315\023\032&\b\311\000\215\266\034\267\f\256\r`<<\3423b>u\265\323\2566G\a\356\250\271\337\361\237\370\275\260\033\006\016\221\016\254\rh\234\026\210\233\220(?\226\360\317M\313\311\372\377\265\271R1\323NLT\362S]\254*\r\031ZF\256\251\262K\250\274\257H\300\204\207\207s+\303T\342\a\257\271\365u\263\022\030\004(\366/.\311\321\255B\215\302\034?\370\261\233\376\246\340\264\035\340r\006\016\213\367\030\f\363\265)\332\362\024\033\341\302\a\374\034^\374\367n\372Vi\360\002\227\t\217\314\"\215\356\006\365\371\215\310\334ai\223\227\216\214\210\366\0209\3316\016\357\0015\2345\2426\2747\257\233\316Kp\243:\304\330\315\260g\321\213<\331\3538\027&}\245)n\016\307\020\252t\263d9\326\264\245t\327l\374k\301\207\370\273\001\361\355G\033b\t\017\\f\260\315liKr\003\002\267\020Rgk\3779\177\f\357\312\255\233\371Z\355o\202FC\351\205\276\315\332\332Q\350\202\351L\266\310x\r\326f\337\203^\265\226\2741W\027\'I\037\031R\332l\214/\223\3200\360\205\356\3100\272\003\tS\3713a\323\202E\361\177\353\256\217\322\361\276\3379\201\327\224+\331l\202\371\205\342\300\n\374\306\226.\300+\242\325S\340u\264\331\341\243\340Gx\223\361\032(\371ASN\256M\331i\261_\245Z\\\000\334\016s\223y\vKQ0ALx\235\002~\327\332c\264>\322\242\"\244M\265\344\317\355\363\023\314\352\277\363\337}.=$\275\275\314\233|\232\252\033\361\024Ws\005\263\307\257\373\302\b\307p\353\305\020\207bE\225\210\f\035\205\342q}\036C\343\303\2760\001a\257\207\235X\334\350j\002\343\255:K\364\275\255\377N&\a9\264\246O\277\362\300\363:\257\267\034\343\v\2464\373\250\204]\343\020\237t4\022\n\023\365\350\340V=\323\034\241\000\204d/3\031\324\311\305\030\257\237\347^\3024vx\214\016Q\006\260\355\244l\300$\261:n[K\210\002\331\272R\241\a\202\246\003\332\216\252 \022\262\347\346x\236\375w\301\332\345I\326\237C\375\334O\225M\226\n\203\rN\325\223\342%\232#?3v\322\301\331[\r\320\f\216\346\226^\351\376\273\303x\300\246Q\316\376\210]bj\257.m+\025<<h\036\203~\330\022\330S\263\373\311\r\305\020j\315\316!T\325\210c7\311\325\020\345\036wa\323\336o\255\276\334\002r\365\313\\\307`>\v\336@\006\354\244\361\210b\024\001\004\314\342m.\367\313=\000\233\340\023\331\366i\346\017\017c\004\260\351\227P\377\241\fd\222\365\313\310\030f\255\271\260@\375\366\232@\302O\342\370]\v\351\231\240\036\216a\334\254u\001\003oO`\307\343\304\'\312lz\226\035\362\035\327\366\360\226\243\351\327\364\321\312\202ZW\265\f\243\005z }\017\323k\367\335\217kT\242\325~8\037\350\231\371\267la\004\301x\3564\262!\252x\025\236\207\351@i\256\2653aC\031^#N\206\350\371`\242\320\370Bh\342q.PzF\2063\365\224m#N\236\371\302\002\353`M|\323s0\357\032\371\n7\246\0363\257\035`7<\025\210\316\v\232\331=\034\315\354\262\t\207\216^\277\362p\271m\033\264\352\026\244\a\225h\255\211$\206\3620\\\272A\245\237\252\241\261\346.\370\004\257\312\000_\024aO\353\302M\200\3046\b\024,\304\277\335\206\r\365\310\271\3239s\211\302\003\344\303\304e\3125-\304\353r\021\374\nQ\364\320\245\213 \325\006\'\300\2372\260\002\341\222\301EP\343 (\350\342\3128\3727\301\212\f\001\024\024\322\273f\263wC\254\016\363\377\254Y%\303?wf\234\302\305\202\005\223O\201\003\\\214_N\2717yO\260h\200\253\334\005+\267\2350\b\206\001T`L#|\006\211\0309|5l\351\2536O\320\353\350]y\323J\325\035v\024\241\300\003\255\234y\360\243\346R\235\264\272\033\334=\023>u\231L\313\256\337\247H:{\225\227Y\265\313\262q=T9CB_w\332R@\263\220Q4\302q\266\342\002\003T\025$\302\211\340\001\222\034R|\316\207\317\366+Y\250P\236\027\005o\246\377zJ\v\344\321z\332#6q\221\357\363\301\257Fx\207\237}\233\203\247\177m\372?\302\235Q\365?%\344\235\001\251\026\v\223\300\021E6\372k+\036\030\356\254t\277\203\"\247\355\217\n]\312\v[\036E*\000hWyY9\226|\306\027F\t\000i\232\251\255\v\345\234\240\274\240\310\256(\203\266\374&\273M\357-\263\344ut\366\367A~\037\261\034>\016\205\023\036\343\323\263\366S\335b\375\206\253\350\310|gP1\202\344`J\003\300!|O\027\353M\005z(\323\3060\a<\226\360\253\033\273\246\266\363\032\317\305\317f\270\b\004l\t\224:\224\245\001\303E\325s\336\260\254\337\305\331\343\204\325\353\373\264\002d\214P\334\264\177.\0305V\356\353n*a\367\303\202\000+\334tk\244\253\341\036\272\000\021\246\267>G\315\220\210 \240\236\253\240\306\364\350\334\000\311|\237X\345r\035bn\244\2023\333\231\200clM\363V\364\270\224\231ME[)\226\320IY5\347_\213\263d\221\246\215\354J\0267\006d\"\374\v\303\035\270(\271\367\f\217\366\345\300\322\212e<\324g\031\232\027:L\203\323\232\376\031\026\225+\301B\016+0\027V\261\217\3468-\212BW\372Z\001\243\v\200_q\203x\260\235#\031U?\351\202\317\354]\267*\227\327[\350\177N\2318L:\272o\2451\340F\034\"\252\263\302\254\375\352\246\221*\230V\260\242\373\001\250]\324\023\024~\326MZ\177;\020\t\322\277{{\001X\231\346\317o.\215\314\325A\314\204"
