        replacement_chunks {
          target_content: "      {/* Dedicated Multi-Field Search & Filter Box */}\n      <div className=\"bg-white p-5 sm:p-6 rounded-2xl border border-[#e4e9e1] shadow-xs space-y-4\">\n        {/* Search Input Row */}\n        <div className=\"flex flex-col lg:flex-row items-stretch lg:items-center gap-3\">\n          {/* Main Search Input */}\n          <div className=\"relative flex-1\">\n            <Search className=\"w-4 h-4 text-[#89958d] absolute left-3.5 top-3.5\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder={t(\'explore.searchPlaceholder\')}\n              className=\"w-full pl-10 pr-10 py-3 text-xs sm:text-sm border border-[#e4e9e1] rounded-xl focus:ring-2 focus:ring-[#143d35] focus:outline-hidden bg-[#f6f7f3]/50 font-medium placeholder:text-[#89958d]\"\n            />\n            {searchQuery && (\n              <button\n                onClick={() => setSearchQuery(\'\')}\n                className=\"absolute right-3.5 top-3.5 text-slate-400 hover:text-slate-600 cursor-pointer p-0.5\"\n                title=\"Clear search\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            )}\n          </div>\n\n          {/* Search Scope Filter Buttons (Description / Location / Reporter Name / All) */}\n          <div className=\"flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none bg-[#f6f7f3] p-1 rounded-xl border border-[#e4e9e1]\">\n            <span className=\"text-[11px] font-bold text-[#89958d] px-2 uppercase tracking-wider hidden sm:inline-block\">\n              Filter By:\n            </span>\n            <button\n              onClick={() => setSearchScope(\'all\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap ${\n                searchScope === \'all\'\n                  ? \'bg-white text-[#143d35] shadow-xs\'\n                  : \'text-[#74817b] hover:text-[#143d35]\'\n              }`}\n            >\n              {t(\'explore.searchAll\')}\n            </button>\n            <button\n              onClick={() => setSearchScope(\'description\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap flex items-center gap-1 ${\n                searchScope === \'description\'\n                  ? \'bg-white text-[#143d35] shadow-xs\'\n                  : \'text-[#74817b] hover:text-[#143d35]\'\n              }`}\n            >\n              <FileText className=\"w-3.5 h-3.5\" />\n              <span>{t(\'explore.searchDesc\')}</span>\n            </button>\n            <button\n              onClick={() => setSearchScope(\'location\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap flex items-center gap-1 ${\n                searchScope === \'location\'\n                  ? \'bg-white text-[#143d35] shadow-xs\'\n                  : \'text-[#74817b] hover:text-[#143d35]\'\n              }`}\n            >\n              <MapPin className=\"w-3.5 h-3.5\" />\n              <span>{t(\'explore.searchLocation\')}</span>\n            </button>\n            <button\n              onClick={() => setSearchScope(\'reporter\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap flex items-center gap-1 ${\n                searchScope === \'reporter\'\n                  ? \'bg-white text-[#143d35] shadow-xs\'\n                  : \'text-[#74817b] hover:text-[#143d35]\'\n              }`}\n            >\n              <User className=\"w-3.5 h-3.5\" />\n              <span>{t(\'explore.searchReporter\')}</span>\n            </button>\n          </div>\n\n          {/* Status Dropdown */}\n          <div className=\"w-full sm:w-44\">\n            <select\n              value={selectedStatus}\n              onChange={(e) => setSelectedStatus(e.target.value as ReportStatus | \'all\')}\n              className=\"w-full py-2.5 px-3 text-xs border border-[#e4e9e1] rounded-xl bg-[#f6f7f3] font-semibold text-[#1c302c] focus:ring-2 focus:ring-[#143d35] focus:outline-hidden cursor-pointer\"\n            >\n              {statuses.map((st) => (\n                <option key={st} value={st}>\n                  {getStatusLabel(st)}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Sort Order Dropdown */}\n          <div className=\"w-full sm:w-44\">\n            <select\n              value={sortOrder}\n              onChange={(e) => setSortOrder(e.target.value as \'newest\' | \'oldest\')}\n              className=\"w-full py-2.5 px-3 text-xs border border-[#e4e9e1] rounded-xl bg-[#f6f7f3] font-semibold text-[#1c302c] focus:ring-2 focus:ring-[#143d35] focus:outline-hidden cursor-pointer\"\n            >\n              <option value=\"newest\">{t(\'explore.sortNewest\')}</option>\n              <option value=\"oldest\">{t(\'explore.sortOldest\')}</option>\n            </select>\n          </div>\n\n          {/* Grid / List Mode */}\n          <div className=\"hidden sm:flex items-center gap-1 bg-[#f6f7f3] p-1 rounded-xl shrink-0 border border-[#e4e9e1]\">\n            <button\n              onClick={() => setViewMode(\'grid\')}\n              className={`p-2 rounded-lg transition-colors cursor-pointer ${\n                viewMode === \'grid\'\n                  ? \'bg-white text-[#143d35] shadow-xs\'\n                  : \'text-slate-500 hover:text-slate-800\'\n              }`}\n              title=\"Grid View\"\n            >\n              <Grid className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={() => setViewMode(\'list\')}\n              className={`p-2 rounded-lg transition-colors cursor-pointer ${\n                viewMode === \'list\'\n                  ? \'bg-white text-[#143d35] shadow-xs\'\n                  : \'text-slate-500 hover:text-slate-800\'\n              }`}\n              title=\"List View\"\n            >\n              <ListIcon className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Quick Search Suggestion Chips */}\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-1 scrollbar-none text-xs\">\n          <span className=\"text-[11px] font-bold text-[#89958d] uppercase tracking-wider shrink-0 flex items-center gap-1\">\n            <Sparkles className=\"w-3 h-3 text-[#e97950]\" />\n            Suggestions:\n          </span>\n          {quickSearchSuggestions.map((item) => (\n            <button\n              key={item.label}\n              onClick={() => {\n                setSearchQuery(item.label);\n                setSearchScope(item.scope);\n              }}\n              className=\"px-2.5 py-1 rounded-lg bg-[#f6f7f3] hover:bg-[#e8f1e9] text-[#143d35] text-[11px] font-semibold border border-[#e4e9e1] transition-colors shrink-0 cursor-pointer flex items-center gap-1\"\n            >\n              <span>{item.label}</span>\n              <span className=\"text-[9px] text-[#89958d] bg-white px-1 rounded-xs\">\n                {item.scope}\n              </span>\n            </button>\n          ))}\n        </div>\n\n        {/* Category Pills Filter */}\n        <div className=\"flex items-center gap-2 overflow-x-auto pb-2 scrollbar-thin pt-2.5 border-t border-[#f6f7f3]\">\n          <span className=\"text-[11px] font-bold text-[#819087] shrink-0 uppercase tracking-wider mr-1\">\n            {t(\'cat.all\')}:\n          </span>\n          {categories.map((cat) => {\n            const meta = getCategoryMeta(cat);\n            const Icon = meta.icon;\n            const count = cat === \'all\' ? reports.length : reports.filter((r) => r.category === cat).length;\n            const isSelected = selectedCategory === cat;\n\n            return (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`whitespace-nowrap px-3.5 py-2 rounded-xl text-xs font-bold transition-all shrink-0 cursor-pointer flex items-center gap-2 border select-none ${\n                  isSelected\n                    ? \'bg-[#143d35] text-white border-[#143d35] shadow-md shadow-[#143d35]/20 ring-2 ring-[#143d35]/20 scale-[1.02]\'\n                    : \'bg-white hover:bg-[#e8f1e9] text-[#1c302c] border-[#e4e9e1] hover:border-[#143d35]/30 hover:shadow-xs\'\n                }`}\n              >\n                <Icon\n                  className={`w-3.5 h-3.5 shrink-0 ${\n                    isSelected ? \'text-[#d7edbd]\' : \'text-[#74817b]\'\n                  }`}\n                />\n                <span>{getCategoryLabel(cat)}</span>\n                <span\n                  className={`text-[10px] px-1.5 py-0.2 rounded-full font-bold transition-colors ${\n                    isSelected\n                      ? \'bg-white/20 text-white\'\n                      : \'bg-[#f6f7f3] text-[#74817b]\'\n                  }`}\n                >\n                  {count}\n                </span>\n              </button>\n            );\n          })}\n        </div>\n      </div>"
          replacement_content: "      {/* 1. PRIMARY CATEGORY HUB (Main Anchor: All Categories, Water Saving, Electricity Saving, Recycling, Greener Living) */}\n      <div className=\"bg-white rounded-2xl p-4 sm:p-5 border border-[#e4e9e1] shadow-2xs space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"w-2.5 h-2.5 rounded-full bg-[#143d35]\" />\n            <h2 className=\"text-xs sm:text-sm font-extrabold text-[#143d35] uppercase tracking-wider\">\n              {t(\'cat.all\')} &amp; Focus Areas\n            </h2>\n            <span className=\"text-[11px] text-[#74817b] font-medium hidden md:inline\">\n              \342\200\224 Choose a category or browse all submissions\n            </span>\n          </div>\n\n          {selectedCategory !== \'all\' && (\n            <button\n              onClick={() => setSelectedCategory(\'all\')}\n              className=\"text-xs font-bold text-[#e97950] hover:text-[#d3643c] cursor-pointer flex items-center gap-1 transition-colors\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n              <span>Show {t(\'cat.all\')}</span>\n            </button>\n          )}\n        </div>\n\n        {/* Category Pills Strip */}\n        <div className=\"flex items-center gap-2.5 overflow-x-auto pb-1.5 pt-0.5 scrollbar-thin\">\n          {categories.map((cat) => {\n            const meta = getCategoryMeta(cat);\n            const Icon = meta.icon;\n            const count = cat === \'all\' ? reports.length : reports.filter((r) => r.category === cat).length;\n            const isSelected = selectedCategory === cat;\n            const isAll = cat === \'all\';\n\n            return (\n              <button\n                key={cat}\n                onClick={() => setSelectedCategory(cat)}\n                className={`whitespace-nowrap px-4 py-2.5 rounded-xl text-xs font-bold transition-all shrink-0 cursor-pointer flex items-center gap-2.5 border select-none ${\n                  isSelected\n                    ? \'bg-[#143d35] text-white border-[#143d35] shadow-md shadow-[#143d35]/25 ring-2 ring-[#143d35]/20 scale-[1.02]\'\n                    : isAll\n                    ? \'bg-[#eaf1e9] hover:bg-[#dce9da] text-[#143d35] border-[#c8dac5] font-extrabold shadow-2xs\'\n                    : \'bg-white hover:bg-[#f6f7f3] text-[#1c302c] border-[#e4e9e1] hover:border-[#143d35]/30 hover:shadow-2xs\'\n                }`}\n              >\n                <div\n                  className={`w-6 h-6 rounded-lg flex items-center justify-center shrink-0 ${\n                    isSelected\n                      ? \'bg-white/20 text-[#d7edbd]\'\n                      : isAll\n                      ? \'bg-[#143d35]/15 text-[#143d35]\'\n                      : \'bg-[#f6f7f3] text-[#556961]\'\n                  }`}\n                >\n                  <Icon className=\"w-3.5 h-3.5\" />\n                </div>\n                <span>{getCategoryLabel(cat)}</span>\n                <span\n                  className={`text-[10px] px-2 py-0.5 rounded-full font-bold transition-colors ${\n                    isSelected\n                      ? \'bg-white/20 text-white\'\n                      : isAll\n                      ? \'bg-[#143d35] text-white\'\n                      : \'bg-[#edf1eb] text-[#5b6c65]\'\n                  }`}\n                >\n                  {count}\n                </span>\n              </button>\n            );\n          })}\n        </div>\n      </div>\n\n      {/* 2. GRADUAL SECONDARY FILTERS: Search, Scope, Status & Display Controls */}\n      <div className=\"bg-white rounded-2xl p-4 sm:p-5 border border-[#e4e9e1] shadow-2xs space-y-3.5\">\n        {/* Search Input & Scope Row */}\n        <div className=\"flex flex-col lg:flex-row items-stretch lg:items-center gap-3\">\n          {/* Main Search Input */}\n          <div className=\"relative flex-1\">\n            <Search className=\"w-4 h-4 text-[#89958d] absolute left-3.5 top-3.5\" />\n            <input\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder={t(\'explore.searchPlaceholder\')}\n              className=\"w-full pl-10 pr-10 py-2.5 text-xs sm:text-sm border border-[#e4e9e1] rounded-xl focus:ring-2 focus:ring-[#143d35] focus:outline-hidden bg-[#f6f7f3]/50 font-medium placeholder:text-[#89958d]\"\n            />\n            {searchQuery && (\n              <button\n                onClick={() => setSearchQuery(\'\')}\n                className=\"absolute right-3.5 top-3 text-slate-400 hover:text-slate-600 cursor-pointer p-0.5\"\n                title=\"Clear search\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            )}\n          </div>\n\n          {/* Search Scope Filter Buttons */}\n          <div className=\"flex items-center gap-1 overflow-x-auto pb-1 lg:pb-0 scrollbar-none bg-[#f6f7f3] p-1 rounded-xl border border-[#e4e9e1] shrink-0\">\n            <span className=\"text-[10px] font-bold text-[#89958d] px-2 uppercase tracking-wider hidden sm:inline-block\">\n              Scope:\n            </span>\n            <button\n              onClick={() => setSearchScope(\'all\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap ${\n                searchScope === \'all\'\n                  ? \'bg-white text-[#143d35] shadow-2xs\'\n                  : \'text-[#74817b] hover:text-[#143d35]\'\n              }`}\n            >\n              {t(\'explore.searchAll\')}\n            </button>\n            <button\n              onClick={() => setSearchScope(\'description\')}\n              className={`px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap flex items-center gap-1 ${\n                searchScope === \'description\'\n                  ? \'bg-white text-[#143d35] shadow-2xs\'\n                  : \'text-[#74817b] hover:text-[#143d35]\'\n              }`}\n            >\n              <FileText className=\"w-3.5 h-3.5\" />\n              <span>{t(\'explore.searchDesc\')}</span>\n            </button>\n            <button\n              onClick={() => setSearchScope(\'location\')}\n              className={`px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap flex items-center gap-1 ${\n                searchScope === \'location\'\n                  ? \'bg-white text-[#143d35] shadow-2xs\'\n                  : \'text-[#74817b] hover:text-[#143d35]\'\n              }`}\n            >\n              <MapPin className=\"w-3.5 h-3.5\" />\n              <span>{t(\'explore.searchLocation\')}</span>\n            </button>\n            <button\n              onClick={() => setSearchScope(\'reporter\')}\n              className={`px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all cursor-pointer whitespace-nowrap flex items-center gap-1 ${\n                searchScope === \'reporter\'\n                  ? \'bg-white text-[#143d35] shadow-2xs\'\n                  : \'text-[#74817b] hover:text-[#143d35]\'\n              }`}\n            >\n              <User className=\"w-3.5 h-3.5\" />\n              <span>{t(\'explore.searchReporter\')}</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Refinements: Status Dropdown, Sort Order, Quick Suggestions & View Mode */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-[#f0f3ee]\">\n          <div className=\"flex flex-wrap items-center gap-2.5\">\n            {/* Status Dropdown */}\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"text-[11px] font-bold text-[#89958d] uppercase tracking-wider hidden sm:inline\">\n                Status:\n              </span>\n              <select\n                value={selectedStatus}\n                onChange={(e) => setSelectedStatus(e.target.value as ReportStatus | \'all\')}\n                className=\"py-1.5 px-3 text-xs border border-[#e4e9e1] rounded-xl bg-[#f6f7f3] font-semibold text-[#1c302c] focus:ring-2 focus:ring-[#143d35] focus:outline-hidden cursor-pointer\"\n              >\n                {statuses.map((st) => (\n                  <option key={st} value={st}>\n                    {getStatusLabel(st)}\n                  </option>\n                ))}\n              </select>\n            </div>\n\n            {/* Sort Order Dropdown */}\n            <div className=\"flex items-center gap-1.5\">\n              <span className=\"text-[11px] font-bold text-[#89958d] uppercase tracking-wider hidden sm:inline\">\n                Sort:\n              </span>\n              <select\n                value={sortOrder}\n                onChange={(e) => setSortOrder(e.target.value as \'newest\' | \'oldest\')}\n                className=\"py-1.5 px-3 text-xs border border-[#e4e9e1] rounded-xl bg-[#f6f7f3] font-semibold text-[#1c302c] focus:ring-2 focus:ring-[#143d35] focus:outline-hidden cursor-pointer\"\n              >\n                <option value=\"newest\">{t(\'explore.sortNewest\')}</option>\n                <option value=\"oldest\">{t(\'explore.sortOldest\')}</option>\n              </select>\n            </div>\n          </div>\n\n          <div className=\"flex items-center justify-between sm:justify-end gap-3\">\n            {/* Quick Search Suggestions (Compact) */}\n            <div className=\"hidden lg:flex items-center gap-1.5 text-xs\">\n              <span className=\"text-[10px] font-bold text-[#89958d] uppercase tracking-wider flex items-center gap-1\">\n                <Sparkles className=\"w-3 h-3 text-[#e97950]\" />\n                Try:\n              </span>\n              {quickSearchSuggestions.slice(0, 3).map((item) => (\n                <button\n                  key={item.label}\n                  onClick={() => {\n                    setSearchQuery(item.label);\n                    setSearchScope(item.scope);\n                  }}\n                  className=\"px-2 py-0.5 rounded-lg bg-[#f6f7f3] hover:bg-[#e8f1e9] text-[#143d35] text-[11px] font-semibold border border-[#e4e9e1] transition-colors shrink-0 cursor-pointer\"\n                >\n                  {item.label}\n                </button>\n              ))}\n            </div>\n\n            {/* Grid / List Mode */}\n            <div className=\"flex items-center gap-1 bg-[#f6f7f3] p-1 rounded-xl shrink-0 border border-[#e4e9e1]\">\n              <button\n                onClick={() => setViewMode(\'grid\')}\n                className={`p-1.5 rounded-lg transition-colors cursor-pointer ${\n                  viewMode === \'grid\'\n                    ? \'bg-white text-[#143d35] shadow-2xs font-bold\'\n                    : \'text-slate-500 hover:text-slate-800\'\n                }`}\n                title=\"Grid View\"\n              >\n                <Grid className=\"w-4 h-4\" />\n              </button>\n              <button\n                onClick={() => setViewMode(\'list\')}\n                className={`p-1.5 rounded-lg transition-colors cursor-pointer ${\n                  viewMode === \'list\'\n                    ? \'bg-white text-[#143d35] shadow-2xs font-bold\'\n                    : \'text-slate-500 hover:text-slate-800\'\n                }`}\n                title=\"List View\"\n              >\n                <ListIcon className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>"
