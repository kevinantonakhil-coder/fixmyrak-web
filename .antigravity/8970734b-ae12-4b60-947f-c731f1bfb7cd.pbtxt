    content: "import React, { useState, useMemo } from \'react\';\nimport { Report, ReportCategory, ReportStatus } from \'../types\';\nimport { useLanguage } from \'../context/LanguageContext\';\nimport { useAuth } from \'../context/AuthContext\';\nimport {\n  Search,\n  Filter,\n  MapPin,\n  Calendar,\n  Grid,\n  List as ListIcon,\n  CheckCircle2,\n  Clock,\n  Sparkles,\n  ArrowUpDown,\n  X,\n  User,\n  FileText,\n  Tag,\n  Check,\n  ChevronRight,\n  Recycle,\n  Zap,\n  Droplets,\n  Leaf,\n  AlertTriangle,\n  Lightbulb,\n  Footprints,\n  Building2,\n  Wrench,\n  Layers,\n} from \'lucide-react\';\n\ninterface ExploreReportsPageProps {\n  reports: Report[];\n  selectedCategory: ReportCategory | \'all\';\n  setSelectedCategory: (cat: ReportCategory | \'all\') => void;\n  onSelectReport: (report: Report) => void;\n  setCurrentTab: (tab: string) => void;\n}\n\ntype SearchScope = \'all\' | \'description\' | \'location\' | \'reporter\';\n\nexport const ExploreReportsPage: React.FC<ExploreReportsPageProps> = ({\n  reports,"
