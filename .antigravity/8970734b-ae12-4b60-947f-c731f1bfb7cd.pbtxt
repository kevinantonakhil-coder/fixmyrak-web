              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <span className=\"font-black text-emerald-600\">02.</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <strong>Municipal Review:</strong> Coordinators evaluate the hazard, review photograph evidence, and move status to <span className=\"font-bold text-sky-700\">Under Review</span>."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <div className=\"flex gap-3\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <span className=\"font-black text-emerald-600\">03.</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <strong>Active Maintenance:</strong> Field crews are scheduled or dispatched. Status moves to <span className=\"font-bold text-violet-700\">In Progress</span> with an administrative status note."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <div className=\"flex gap-3\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <span className=\"font-black text-emerald-600\">04.</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <strong>Resolution:</strong> The defect is repaired and verified. Status is marked <span className=\"font-bold text-emerald-700\">Resolved</span>, and the citizen receives an in-app notification."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
