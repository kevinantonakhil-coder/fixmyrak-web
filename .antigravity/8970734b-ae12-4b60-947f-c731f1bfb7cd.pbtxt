justify-content: center; gap: 8px; border: 0; border-radius: 12px; padding: 11px 16px; font-size: 12px; font-weight: 700; transition: transform .18s ease, box-shadow .18s ease, background .18s ease; }.button:hover { transform: translateY(-1px); }.button-dark { color: white; background: var(--green); box-shadow: 0 6px 15px rgba(20,61,53,.13); }.button-dark:hover { background: #205347; box-shadow: 0 9px 20px rgba(20,61,53,.2); }.button-outline { border: 1px solid var(--line); background: white; color: var(--ink); }.button-outline:hover { border-color: #b6c8bb; background: #fbfcfa; }.button-soft { background: var(--green-soft); color: var(--green); }.button-large { min-height: 48px; padding: 0 19px; border-radius: 13px; font-size: 13px; }.header-cta { min-height: 39px; padding: 0 15px; }.hero { min-height: 474px; padding-top: 42px; padding-bottom: 37px; display: grid; grid-template-columns: .93fr 1.07fr; align-items: center; gap: clamp(35px, 6vw, 82px); }.hero-copy { padding: 0 0 3px 4px; }.eyebrow { color: #819087; text-transform: uppercase; letter-spacing: .12em; font-size: 9px; line-height: 1.5; font-weight: 700; }.hero-copy > .eyebrow { display: flex; align-items: center; gap: 9px; white-space: nowrap; }.pulse-dot { width: 7px; height: 7px; background: #72a879; border-radius: 50%; box-shadow: 0 0 0 4px #72a8791a; }h1, h2, h3, p { margin-top: 0; }h1, h2, h3 { font-family: \"Manrope\", sans-serif; }.hero h1 { margin: 21px 0 15px; font-size: clamp(44px, 5.2vw, 66px); line-height: 1.07; letter-spacing: -.075em; font-weight: 800; }.hero h1 span, .closing h2 span { color: var(--orange); }.hero-copy > p { max-width: 415px; margin: 0; color: #738078; font-size: 14px; line-height: 1.9; }.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 23px; margin-top: 24px; }.text-link { font-size: 12px; font-weight: 700; color: var(--green); }.text-link span { margin-left: 5px; color: var(--orange); }.hero-note { display: flex; align-items: center; gap: 11px; margin-top: 24px; font-size: 10px; color: #839087; }.hero-note strong { color: #4a5b52; }.avatar-stack { display: flex; padding-left: 4px; }.avatar-stack i { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 2px solid var(--page); margin-left: -4px; background: #dcebd4; color: #42604c; font-size: 8px; font-style: normal; font-weight: 700; }.avatar-stack i:nth-child(2) { background: #f3d9cb; color: #905f48; }.avatar-stack i:nth-child(3) { background: #e4def0; color: #655484; }.hero-visual { position: relative; min-width: 0; height: 356px; border-radius: 23px; overflow: visible; }.hero-image, .hero-image-shade { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; }.hero-image { background: center 54% / cover no-repeat url(\"./assets/jebel-jais.jpg\"); }.hero-image-shade { background: linear-gradient(0deg, rgba(20,42,37,.58), transparent 49%), linear-gradient(120deg, rgba(255,230,193,.1), transparent 60%); }.image-caption { position: absolute; bottom: 17px; left: 18px; right: 18px; display: flex; align-items: center; gap: 11px; color: white; }.caption-pin { width: 33px; height: 33px; display: grid; place-items: center; border: 1px solid #ffffff73; border-radius: 10px; font-size: 20px; }.image-caption strong, .image-caption small { display: block; }.image-caption strong { font: 700 11px \"Manrope\", sans-serif; }.image-caption small { margin-top: 3px; color: #ffffffc9; font-size: 9px; }.caption-arrow { margin-left: auto; width: 30px; height: 30px; display: grid; place-items: center; background: #ffffff2a; border-radius: 50%; }.hero-sticker { position: absolute; right: -17px; top: 32px; width: 82px; height: 82px; display: grid; place-content: center; border-radius: 50%; background: var(--lime); color: var(--green); transform: rotate(9deg); font: 700 10px/1.35 \"Manrope\", sans-serif; text-align: center; box-shadow: 0 6px 20px #334c3118; }.hero-sticker span { font-size: 15px; margin-bottom: 2px; }.account-section { padding-bottom: 34px; }.account-card { display: grid; grid-template-columns: 1fr minmax(300px, .78fr); gap: 34px; align-items: center; padding: 27px 30px; border: 1px solid var(--line); border-radius: 18px; background: #fff; box-shadow: 0 10px 30px rgba(32,54,43,.04); }.account-copy h2 { margin: 6px 0 8px; color: var(--green); font-size: clamp(22px, 3vw, 31px); letter-spacing: -.055em; }.account-copy p { max-width: 430px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.75; }.account-panel { padding: 18px; border-radius: 14px; background: #f8faf7; }.account-tabs { display: flex; gap: 18px; border-bottom: 1px solid var(--line); }.account-tab { padding: 0 0 9px; border: 0; border-bottom: 2px solid transparent; background: transparent; color: #839087; font-size: 11px; font-weight: 700; }.account-tab.active { border-color: var(--green); color: var(--green); }.account-form { display: grid; gap: 5px; padding-top: 14px; }.account-form .form-label { margin-bottom: 7px; font-size: 10px; }.account-form .form-label input { font-size: 12px; }.account-submit, .account-google { width: 100%; min-height: 40px; }.account-text-button { justify-self: center; padding: 6px 8px; border: 0; background: transparent; color: var(--green); font-size: 10px; font-weight: 700; }.account-text-button:hover { text-decoration: underline; }.account-error { min-height: 0; margin: 0; color: #a34e38; font-size: 10px; line-height: 1.5; }.account-error:empty { display: none; }.account-divider { display: flex; align-items: center; gap: 10px; margin: 7px 0 12px; color: #97a198; font-size: 9px; }.account-divider::before, .account-divider::after { content: \"\"; flex: 1; height: 1px; background: var(--line); }.account-status { display: inline-flex; padding: 5px 9px; border-radius: 20px; background: var(--green-soft); color: var(--green); font-size: 10px; font-weight: 700; }.account-email { margin: 12px 0 2px; overflow-wrap: anywhere; color: var(--green); font-size: 14px; font-weight: 700; }.account-settings-note { margin: 14px 0 2px; color: #718078; font-size: 10px; font-weight: 700; }.account-reset-signed-in { display: block; margin: 0 0 10px; padding-left: 0; }.reviewer-tools-link { width: 100%; margin-top: 9px; font-size: 10px; }"
