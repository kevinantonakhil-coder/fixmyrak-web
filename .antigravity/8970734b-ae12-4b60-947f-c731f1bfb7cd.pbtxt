ald-50/80 font-bold\'\n                    : \'text-slate-600 hover:text-slate-900 hover:bg-slate-100/70\'\n                }`}\n              >\n                {link.label}\n              </button>\n            ))}\n          </nav>\n\n          {/* Action Buttons & Profile */}\n          <div className=\"flex items-center gap-2.5\">\n            {/* Primary CTA: Report an Issue */}\n            <button\n              onClick={() => setCurrentTab(\'report\')}\n              className=\"hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 active:scale-95 shadow-sm shadow-emerald-600/20 transition-all cursor-pointer\"\n            >\n              <PlusCircle className=\"w-4 h-4\" />\n              <span>Report an Issue</span>\n            </button>"
        replacement_content: "    <header className=\"sticky top-0 z-50 bg-[#f6f7f3]/92 backdrop-blur-md border-b border-[#20362b]/8 shadow-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between h-20\">\n          {/* Logo & Brand matching website */}\n          <div\n            className=\"flex items-center gap-3 cursor-pointer group\"\n            onClick={() => {\n              setCurrentTab(\'home\');\n              setMobileMenuOpen(false);\n            }}\n          >\n            <img\n              src=\"/assets/fixmyrak-mark.svg\"\n              alt=\"FixMyRAK\"\n              className=\"w-10 h-10 group-hover:scale-105 transition-transform\"\n            />\n            <div>\n              <div className=\"flex items-center gap-1.5\">\n                <span className=\"text-xl font-extrabold tracking-tight text-[#143d35] font-manrope\">\n                  FixMy<span className=\"text-[#e97950]\">RAK</span>\n                </span>\n                <span className=\"px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-[#e8f1e9] text-[#143d35] border border-[#143d35]/15 rounded-md\">\n                  UAE\n                </span>\n              </div>\n              <p className=\"text-[10px] font-medium text-[#74817b] leading-none mt-0.5\">\n                RAK, together.\n              </p>\n            </div>\n          </div>\n\n          {/* Desktop Navigation */}\n          <nav className=\"hidden md:flex items-center gap-8\">\n            {navLinks.map((link) => (\n              <button\n                key={link.id}\n                onClick={() => setCurrentTab(link.id)}\n                className={`text-xs font-bold transition-all cursor-pointer ${\n                  currentTab === link.id\n                    ? \'text-[#143d35] underline underline-offset-8 decoration-2 decoration-[#e97950]\'\n                    : \'text-[#78827d] hover:text-[#143d35]\'\n     