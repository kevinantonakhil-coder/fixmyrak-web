      thinking_signature: "\022\351\006\n\346\006\001i\024}\023(\205f\274K\250\276\303r\316\360\212:\311>\322\353\313\274 uI\225)+\367\216\233l\0353\264\253\231^E%\313\212\347\2116>\351u\222t\020O\375\277\247\216\237\031a\022\314\303}/\330C\033\002\230u\020\023m.\342\365\275!H\022!\177Hi\252\263\227\203\225\026\255\224\001\275uq\375\331)\301\bt\031\332\316\364\177\200\a\247\b\'% \236M\a\352G,\227\264\177\305r\370G\230\366\226U\3307R\031C\203\221B\025\352*Es(\220\272\246,\252\006\375\204I\\\364f\304\3050w\202\256\375\262\320\254\020\311$P\253~w\027\006-!\243~\260e\317\\\222>7.\004]d\335\230\033\342\311S\271\347\304\212\033Rc\334\337\233E\340\252f\232\274\221\276\343\a\031}\023\316\205\002i&\006*\272q\312\205`\223\221\235x\310\037\302\222\177?\353\322\033\000nY\214D\036\034\030Y\363\031\351\371\247~\272\202\337\332\261\243\255k\356\027\222\346\317y\222B\371\020$Zr\241\f\036Cz\036\202\320/\311\220\341\345=e\247h\017cx!\357\025\031\031\264\234k\377\367\343\230\002\213\032Z6\214\2269\254\003?\332Q\330.\232\365\017\244\302\032`\333d\212\254\216#U\337q\332~\216\347\311\250i\304i\353\253o\310t\252z#@^\265\310\375\304\003\216&\246\234I\236\016[\242\314\272P\3368\320\234\357\030\025\374\342|\"T\035~B\\r\227\222:JEG\240\312\337 \327\317\301P\2162*\271\025rNmb\351\327m~\364\210\361\027\300G\373\317\331f\344\035e\231\205\021\265\201\"\257*\004\351\213\200\277RS\372.DT\224\341\267\350\177\025\025\202B\234\352\">\a\206of\216\203\210\347W])\300\274\217%\223\343\325\031\037\346*z\2376\304\340\032\3572\365\"\204\203\305\263g\032\347\305\313$\304\342\333=K\356\005\251\361\357\243&L\355~\371\302y\245\315\236\226\304\357T\263\227\362!\317)\340/\200EzG\177.\025\002\203<\256\025\337 g\301\254*C\020\036\351[\321ch\352Z!\357dJ\025\005\211\\r\272\355\213C\373b\337\037&\327\225\231\221{X\322\032\260\t\30155\230\200\031\323i\365\336\334\032\006\302%\224~2\r\\\271y\2567c\204\312ifk5_\237%d<L|CL\002d\035\312\355\016\177\243\222\215\332)\274\361\000n\a\327Ti\325\243\331w\024\300\327\350m{Nd\271\3