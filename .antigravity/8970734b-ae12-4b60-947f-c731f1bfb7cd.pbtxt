te\\n          </button>\\n        </div>\\n      ) : (\\n        <form\\n          onSubmit={handleSubmit}\\n          className=\\\"bg-white p-6 sm:p-8 rounded-2xl border border-[#e4e9e1] shadow-xs space-y-6\\\"\\n        >\\n          {/* Star Rating */}\\n          <div>\\n            <label className=\\\"block text-xs font-bold text-[#143d35] font-manrope uppercase tracking-wider mb-2\\\">\\n              Overall Experience Rating\\n            </label>\\n            <div className=\\\"flex items-center gap-2\\\">\\n              {[1, 2, 3, 4, 5].map((star) => (\\n                <button\\n                  key={star}\\n                  type=\\\"button\\\"\\n                  onClick={() => setRating(star)}\\n                  onMouseEnter={() => setHoverRating(star)}\\n                  onMouseLeave={() => setHoverRating(null)}\\n                  className=\\\"p-1 hover:scale-115 transition-transform cursor-pointer\\\"\\n                >\\n                  <Star\\n                    className={`w-7 h-7 ${\\n                      (hoverRating !== null ? star <= hoverRating : star <= rating)\\n                        ? \'fill-[#e97950] text-[#e97950]\'\\n                        : \'text-slate-200\'\\n                    }`}\\n                  />\\n                </button>\\n              ))}\\n              <span className=\\\"text-xs font-bold text-[#74817b] ml-2\\\">\\n                {rating} of 5 Stars\\n              </span>\\n            </div>\\n          </div>\\n\\n          {/* Feedback Category */}\\n          <div>\\n            <label className=\\\"block text-xs font-bold text-[#143d35] font-manrope uppercase tracking-wider mb-2\\\">\\n              Feedback Topic\\n            </label>\\n            <select\\n              value={category}\\n              onChange={(e) => setCategory(e.target.value)}\\n              className=\\\"w-full p-2.5 text-xs border border-[#e4e9e1] rounded-xl focus:ring-2 focus:ring-[#143d35] focus:outline-hidden bg