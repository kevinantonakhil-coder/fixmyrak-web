rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'kevinantonakhil@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 150 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('role' in data) || data.role in ['user', 'admin']);
    }

    function isValidReport(data) {
      return data.keys().hasAll(['userId', 'title', 'description', 'category', 'location', 'latitude', 'longitude', 'status', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
        data.description is string && data.description.size() >= 5 && data.description.size() <= 5000 &&
        data.category in ['Water Saving', 'Electricity Saving', 'Recycling', 'Greener Living', 'Roads and Potholes', 'Streetlights', 'Pavements', 'Public Facilities', 'Other Infrastructure', 'Waste Management'] &&
        data.location is string && data.location.size() >= 3 && data.location.size() <= 200 &&
        data.latitude is number && data.longitude is number &&
        data.status in ['Submitted', 'Under Review', 'In Progress', 'Resolved'] &&
        (!('authorName' in data) || (data.authorName is string && data.authorName.size() <= 100)) &&
        (!('authorEmail' in data) || (data.authorEmail is string && data.authorEmail.size() <= 150)) &&
        (!('imageURL' in data) || (data.imageURL is string && data.imageURL.size() <= 2000000)) &&
        (!('isVerified' in data) || data.isVerified is bool) &&
        (!('flagged' in data) || data.flagged is bool) &&
        (!('aiSummary' in data) || (data.aiSummary is string && data.aiSummary.size() <= 1000));
    }

    function isValidReportUpdate(data) {
      return data.keys().hasAll(['reportId', 'newStatus', 'adminId', 'createdAt']) &&
        data.reportId is string && data.reportId.size() <= 128 &&
        data.newStatus in ['Submitted', 'Under Review', 'In Progress', 'Resolved'] &&
        data.adminId is string && data.adminId.size() <= 128 &&
        (!('previousStatus' in data) || (data.previousStatus is string && data.previousStatus.size() <= 50)) &&
        (!('message' in data) || (data.message is string && data.message.size() <= 1000)) &&
        (!('adminName' in data) || (data.adminName is string && data.adminName.size() <= 100));
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll(['id', 'userId', 'reportId', 'title', 'message', 'read', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'reportId', 'updateId', 'title', 'message', 'read', 'createdAt']) &&
        data.id == notificationId &&
        data.userId is string && data.userId.size() <= 128 &&
        data.reportId is string && data.reportId.size() <= 128 &&
        data.title is string && data.title.size() <= 150 &&
        data.message is string && data.message.size() <= 500 &&
        data.read == false && data.createdAt is string && data.createdAt.size() <= 40 &&
        (!('updateId' in data) || (data.updateId is string && data.updateId.size() <= 128));
    }

    function isOwnReportNotification(data) {
      return exists(/databases/$(database)/documents/reports/$(data.reportId)) &&
        get(/databases/$(database)/documents/reports/$(data.reportId)).data.userId == data.userId;
    }

    function isLegitimateReportUpdateNotification(data) {
      return isAdmin() && 'updateId' in data &&
        exists(/databases/$(database)/documents/reports/$(data.reportId)/updates/$(data.updateId)) &&
        get(/databases/$(database)/documents/reports/$(data.reportId)/updates/$(data.updateId)).data.reportId == data.reportId &&
        get(/databases/$(database)/documents/reports/$(data.reportId)/updates/$(data.updateId)).data.adminId == request.auth.uid &&
        data.title == 'Report Status Updated: ' +
          get(/databases/$(database)/documents/reports/$(data.reportId)/updates/$(data.updateId)).data.newStatus &&
        get(/databases/$(database)/documents/reports/$(data.reportId)).data.status ==
          get(/databases/$(database)/documents/reports/$(data.reportId)/updates/$(data.updateId)).data.newStatus;
    }

    function isValidFeedback(data) {
      return data.keys().hasAll(['rating', 'message', 'createdAt']) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.message is string && data.message.size() >= 3 && data.message.size() <= 2000 &&
        (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 100)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50));
    }

    // Collections

    // Users
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid && incoming().role == 'user';
      allow update: if (isOwner(userId) && isValidUser(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Reports
    match /reports/{reportId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReport(incoming()) && incoming().userId == request.auth.uid && incoming().status == 'Submitted';
      allow update: if (
        (isOwner(existing().userId) && existing().status == 'Submitted' && isValidReport(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'location', 'latitude', 'longitude', 'imageURL', 'updatedAt'])) ||
        (isAdmin() && isValidReport(incoming()) && incoming().userId == existing().userId && incoming().createdAt == existing().createdAt)
      );
      allow delete: if (isOwner(existing().userId) && existing().status == 'Submitted') || isAdmin();

      // Subcollection: Updates
      match /updates/{updateId} {
        allow read: if true;
        allow create: if isAdmin() && isValidReportUpdate(incoming()) &&
          incoming().reportId == reportId && incoming().adminId == request.auth.uid &&
          incoming().id == updateId;
        allow update: if isAdmin() && isValidReportUpdate(incoming()) && incoming().reportId == reportId;
        allow delete: if isAdmin();
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isValidNotification(incoming(), notificationId) && isOwnReportNotification(incoming()) && (
        (isOwner(incoming().userId) && incoming().userId == request.auth.uid &&
          !('updateId' in incoming()) && incoming().title == 'Report Submitted Successfully' &&
          get(/databases/$(database)/documents/reports/$(incoming().reportId)).data.status == 'Submitted') ||
        (incoming().title.matches('^Report Status Updated: (Submitted|Under Review|In Progress|Resolved)$') &&
          isLegitimateReportUpdateNotification(incoming()))
      );
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isValidFeedback(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
